{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tahin-spare-suppliers",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-03-29",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "tahinspare.com", "zone_name": "tahinspare.com", "custom_domain": true },
    { "pattern": "www.tahinspare.com", "zone_name": "tahinspare.com", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "DB_PROVIDER": "supabase",
    "TAHIN_CUTOVER_FREEZE": "false"
  },
  "hyperdrive": [
    { "binding": "SUPABASE_HYPERDRIVE", "id": "4b2bf739409f4562b7d1a012a84d8a4f" }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "tahin-spare-suppliers-media"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "e8d999cbc9f74919ab062abb24b976c9"
    }
  ],
  "previews": {
    "vars": {
      "DB_PROVIDER": "supabase",
      "TAHIN_PREVIEW_READ_ONLY": "true"
    },
    "hyperdrive": [
      { "binding": "SUPABASE_HYPERDRIVE", "id": "4b2bf739409f4562b7d1a012a84d8a4f" }
    ],
    "kv_namespaces": [
      { "binding": "SESSION", "id": "a497da7b883d4e01aaa3a087693e20ac" }
    ],
    "r2_buckets": [
      { "binding": "MEDIA_BUCKET", "bucket_name": "tahin-spare-suppliers-supabase-preview-media-bucket" }
    ]
  }
}
