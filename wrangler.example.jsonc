{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tahin-spare-suppliers",
  "compatibility_date": "2026-03-29",
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "tahin-spare-suppliers-media"
    }
  ],
  "vars": {
    "MEDIA_PUBLIC_URL": "",
    "NOTIFICATION_EMAIL": "tahinship@gmail.com",
    "GOOGLE_ANALYTICS_ID": "",
    "GOOGLE_SITE_VERIFICATION": ""
  }

  // Set GOOGLE_ANALYTICS_ID to the real GA4 web stream measurement ID (G-...).
  // Set GOOGLE_SITE_VERIFICATION to the real Search Console HTML meta token.
  // Configure DATABASE_URL, ADMIN_PASSWORD, SESSION_SECRET,
  // RESEND_API_KEY and RESEND_WEBHOOK_SECRET with `wrangler secret put`.
}
