---
import AdminLayout from "../../layouts/AdminLayout.astro";
import ContentEditor from "../../components/admin/ContentEditor.astro";
import { getRuntimeEnv } from "../../lib/server/env";
import { isAuthenticated } from "../../lib/server/session";
import { listAllCategories, listAllSubcategories } from "../../lib/server/categories";
import { listBrands } from "../../lib/server/brands";

const env = getRuntimeEnv(Astro.locals);
const authenticated = await isAuthenticated(Astro.cookies, env.SESSION_SECRET);

if (!authenticated) {
  return Astro.redirect("/admin/login");
}

const [categories, subcategories, brands] = await Promise.all([
  listAllCategories(env),
  listAllSubcategories(env),
  listBrands(env)
]);
---
<AdminLayout title="Manage Products" active="products">
  <ContentEditor
    type="products"
    title="Manage Products"
    itemLabel="Products"
    titleLabel="Product Name"
    excerptLabel="Short Description"
    categories={categories}
    subcategories={subcategories}
    brands={brands}
  />
</AdminLayout>
