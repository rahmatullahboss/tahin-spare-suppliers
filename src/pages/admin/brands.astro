---
import ImageUploader from "../../components/admin/ImageUploader.astro";
import AdminLayout from "../../layouts/AdminLayout.astro";
import { getRuntimeEnv } from "../../lib/server/env";
import { isAuthenticated } from "../../lib/server/session";
import { listBrands } from "../../lib/server/brands";

const env = getRuntimeEnv(Astro.locals);
const authenticated = await isAuthenticated(Astro.cookies, env.SESSION_SECRET);
if (!authenticated) return Astro.redirect("/admin/login");

const brands = await listBrands(env);
---

<AdminLayout title="Brands" active="brands">
  <div class="page-header">
    <h1>Brands</h1>
    <p class="subtitle">Manage canonical brand names and logos used across category and brand pages.</p>
  </div>

  <section class="brand-form-card">
    <h2 data-form-title>Add New Brand</h2>
    <form id="brand-form">
      <input type="hidden" id="brand-id" />
      <div class="field">
        <label for="brand-name">Brand name *</label>
        <input id="brand-name" type="text" required placeholder="e.g. Cummins" />
        <small>Renaming a brand here updates products currently assigned to that brand.</small>
      </div>
      <ImageUploader label="Brand Logo" />
      <div class="preview" data-preview></div>
      <div class="form-actions">
        <button type="submit" class="btn btn-primary" data-submit-btn>Add Brand</button>
        <button type="button" class="btn btn-secondary" data-reset-btn>Reset</button>
      </div>
      <p id="form-message" role="status"></p>
    </form>
  </section>

  <section class="brands-card">
    <div class="brands-card-head">
      <div>
        <h2>Configured Brands</h2>
        <p>{brands.length} brand{brands.length === 1 ? "" : "s"}</p>
      </div>
    </div>
    <div class="brand-list">
      {brands.map((brand) => (
        <article class="brand-row">
          <div class="brand-logo-wrap">
            {brand.displayLogoUrl ? (
              <img src={brand.displayLogoUrl} alt={`${brand.name} logo`} loading="lazy" />
            ) : (
              <span>{brand.name.slice(0, 2).toUpperCase()}</span>
            )}
          </div>
          <div class="brand-info">
            <strong>{brand.name}</strong>
            <span>/{brand.slug}</span>
            <small>{brand.productCount} linked product{brand.productCount === 1 ? "" : "s"}</small>
          </div>
          <div class="brand-actions">
            <button
              type="button"
              class="edit-btn"
              data-edit-id={brand.id}
              data-edit-name={brand.name}
              data-edit-logo-url={brand.logoUrl}
              data-edit-logo-key={brand.logoKey}
            >Edit</button>
            <button type="button" class="delete-btn" data-delete-id={brand.id} data-delete-name={brand.name} data-product-count={brand.productCount}>Delete</button>
          </div>
        </article>
      ))}
    </div>
  </section>

  <script>
    const form = document.getElementById("brand-form") as HTMLFormElement | null;
    const idInput = document.getElementById("brand-id") as HTMLInputElement | null;
    const nameInput = document.getElementById("brand-name") as HTMLInputElement | null;
    const formTitle = document.querySelector("[data-form-title]") as HTMLElement | null;
    const submitBtn = document.querySelector("[data-submit-btn]") as HTMLButtonElement | null;
    const resetBtn = document.querySelector("[data-reset-btn]") as HTMLButtonElement | null;
    const messageEl = document.getElementById("form-message") as HTMLElement | null;
    const imageInput = document.querySelector("[data-image-input]") as HTMLInputElement | null;
    const imageRemoveBtn = document.querySelector("[data-image-remove-btn]") as HTMLButtonElement | null;
    const imageUrlInput = document.querySelector("[data-image-url]") as HTMLInputElement | null;
    const imageKeyInput = document.querySelector("[data-image-key]") as HTMLInputElement | null;
    const uploadStatus = document.querySelector("[data-upload-status]") as HTMLElement | null;
    const previewEl = document.querySelector("[data-preview]") as HTMLElement | null;

    let selectedFile: File | null = null;
    let selectedPreviewUrl = "";
    let existingLogoUrl = "";
    let existingLogoKey = "";
    let imageRemoved = false;

    const setMessage = (message: string, isError = false) => {
      if (!messageEl) return;
      messageEl.textContent = message;
      messageEl.style.color = isError ? "#dc2626" : "#15803d";
    };

    const clearPreviewUrl = () => {
      if (!selectedPreviewUrl) return;
      URL.revokeObjectURL(selectedPreviewUrl);
      selectedPreviewUrl = "";
    };

    const drawPreview = (url: string) => {
      if (!previewEl) return;
      if (!url) {
        previewEl.replaceChildren();
        return;
      }
      const img = document.createElement("img");
      img.src = url;
      img.alt = "Brand logo preview";
      previewEl.replaceChildren(img);
    };

    const compressImageToWebp = async (file: File) => {
      const bitmap = await createImageBitmap(file);
      const canvas = document.createElement("canvas");
      const maxWidth = 1200;
      const maxHeight = 800;
      const scale = Math.min(1, maxWidth / bitmap.width, maxHeight / bitmap.height);
      canvas.width = Math.max(1, Math.round(bitmap.width * scale));
      canvas.height = Math.max(1, Math.round(bitmap.height * scale));
      const context = canvas.getContext("2d");
      if (!context) throw new Error("Image compression is not supported in this browser.");
      context.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
      bitmap.close();
      const blob = await new Promise<Blob | null>((resolve) => canvas.toBlob(resolve, "image/webp", 0.86));
      if (!blob) throw new Error("Logo compression failed.");
      return new File([blob], `${file.name.replace(/\.[^.]+$/, "")}.webp`, { type: "image/webp" });
    };

    const uploadImage = async (file: File): Promise<{ url: string; key: string }> => {
      const uploadFormData = new FormData();
      uploadFormData.append("file", file);
      const response = await fetch("/api/upload", { method: "POST", body: uploadFormData });
      const data = await response.json().catch(() => null) as { url?: string; key?: string; error?: string } | null;
      if (!response.ok) throw new Error(data?.error || "Logo upload failed.");
      return { url: data?.url || "", key: data?.key || "" };
    };

    const deleteImageByKey = async (key: string) => {
      if (!key) return;
      await fetch("/api/upload/delete", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ key })
      });
    };

    const resetForm = () => {
      form?.reset();
      if (idInput) idInput.value = "";
      if (imageInput) imageInput.value = "";
      if (imageUrlInput) imageUrlInput.value = "";
      if (imageKeyInput) imageKeyInput.value = "";
      if (formTitle) formTitle.textContent = "Add New Brand";
      if (submitBtn) submitBtn.textContent = "Add Brand";
      if (uploadStatus) uploadStatus.textContent = "";
      selectedFile = null;
      imageRemoved = false;
      existingLogoUrl = "";
      existingLogoKey = "";
      clearPreviewUrl();
      drawPreview("");
      setMessage("");
    };

    imageInput?.addEventListener("change", () => {
      clearPreviewUrl();
      selectedFile = imageInput.files?.[0] ?? null;
      imageRemoved = false;
      if (selectedFile) {
        selectedPreviewUrl = URL.createObjectURL(selectedFile);
        drawPreview(selectedPreviewUrl);
        if (uploadStatus) uploadStatus.textContent = "Logo selected. It will be converted to WebP and uploaded to R2 on save.";
      } else {
        drawPreview(existingLogoUrl);
      }
    });

    imageRemoveBtn?.addEventListener("click", () => {
      clearPreviewUrl();
      selectedFile = null;
      imageRemoved = true;
      if (imageInput) imageInput.value = "";
      if (imageUrlInput) imageUrlInput.value = "";
      if (imageKeyInput) imageKeyInput.value = "";
      drawPreview("");
      if (uploadStatus) uploadStatus.textContent = "Custom logo will be removed on save. Built-in fallback may still display if available.";
    });

    document.querySelectorAll("[data-edit-id]").forEach((button) => {
      button.addEventListener("click", () => {
        const target = button as HTMLElement;
        if (idInput) idInput.value = target.dataset.editId || "";
        if (nameInput) nameInput.value = target.dataset.editName || "";
        existingLogoUrl = target.dataset.editLogoUrl || "";
        existingLogoKey = target.dataset.editLogoKey || "";
        if (imageUrlInput) imageUrlInput.value = existingLogoUrl;
        if (imageKeyInput) imageKeyInput.value = existingLogoKey;
        if (imageInput) imageInput.value = "";
        selectedFile = null;
        imageRemoved = false;
        clearPreviewUrl();
        drawPreview(existingLogoUrl);
        if (formTitle) formTitle.textContent = "Edit Brand";
        if (submitBtn) submitBtn.textContent = "Save Brand";
        if (uploadStatus) uploadStatus.textContent = "";
        setMessage("");
        window.scrollTo({ top: 0, behavior: "smooth" });
      });
    });

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const id = idInput?.value.trim() || "";
      const name = nameInput?.value.trim() || "";
      let nextLogoUrl = existingLogoUrl;
      let nextLogoKey = existingLogoKey;
      let uploadedKeyToRollback = "";
      setMessage("Saving...");

      try {
        if (selectedFile) {
          if (uploadStatus) uploadStatus.textContent = "Compressing logo to WebP...";
          const compressed = await compressImageToWebp(selectedFile);
          if (uploadStatus) uploadStatus.textContent = "Uploading logo to R2...";
          const uploaded = await uploadImage(compressed);
          nextLogoUrl = uploaded.url;
          nextLogoKey = uploaded.key;
          uploadedKeyToRollback = uploaded.key;
        }
        if (imageRemoved) {
          nextLogoUrl = "";
          nextLogoKey = "";
        }

        const response = await fetch("/api/admin/brands", {
          method: id ? "PUT" : "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ id, name, logoUrl: nextLogoUrl, logoKey: nextLogoKey })
        });
        const data = await response.json().catch(() => null) as { error?: string } | null;
        if (!response.ok) throw new Error(data?.error || "Failed to save brand");

        const shouldDeleteOldLogo = Boolean(existingLogoKey) && existingLogoKey !== nextLogoKey && (Boolean(selectedFile) || imageRemoved);
        if (shouldDeleteOldLogo) await deleteImageByKey(existingLogoKey);
        setMessage("Brand saved. Refreshing...");
        setTimeout(() => location.reload(), 500);
      } catch (error) {
        if (uploadedKeyToRollback) await deleteImageByKey(uploadedKeyToRollback);
        if (uploadStatus) uploadStatus.textContent = "";
        setMessage(error instanceof Error ? error.message : "Failed to save brand", true);
      }
    });

    resetBtn?.addEventListener("click", resetForm);

    document.querySelectorAll("[data-delete-id]").forEach((button) => {
      button.addEventListener("click", async () => {
        const target = button as HTMLElement;
        const count = Number(target.dataset.productCount || "0");
        const name = target.dataset.deleteName || "this brand";
        if (count > 0) {
          alert(`${name} is used by ${count} product${count === 1 ? "" : "s"}. Reassign those products before deleting the brand.`);
          return;
        }
        if (!confirm(`Delete ${name}?`)) return;
        const response = await fetch("/api/admin/brands", {
          method: "DELETE",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ id: target.dataset.deleteId })
        });
        const data = await response.json().catch(() => null) as { error?: string } | null;
        if (!response.ok) {
          alert(data?.error || "Failed to delete brand");
          return;
        }
        location.reload();
      });
    });
  </script>

  <style>
    .page-header { margin-bottom: 24px; }
    .page-header h1 { margin: 0 0 6px; font-size: 28px; }
    .subtitle { margin: 0; color: #64748b; }
    .brand-form-card, .brands-card { background: #fff; border-radius: 12px; padding: 24px; margin-bottom: 24px; box-shadow: 0 4px 20px rgba(15,23,42,.05); }
    .brand-form-card h2, .brands-card h2 { margin: 0 0 16px; font-size: 19px; }
    #brand-form { display: grid; gap: 15px; max-width: 620px; }
    .field { display: grid; gap: 7px; }
    .field label { font-size: 13px; font-weight: 800; color: #334155; }
    .field input { width: 100%; box-sizing: border-box; padding: 12px 14px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 15px; }
    .field small { color: #64748b; line-height: 1.5; }
    .preview img { display: block; width: auto; max-width: 260px; max-height: 120px; object-fit: contain; border: 1px solid #e2e8f0; border-radius: 10px; padding: 10px; background: #fff; }
    .form-actions { display: flex; gap: 10px; }
    .btn { min-height: 44px; border: 0; border-radius: 8px; padding: 10px 20px; font-weight: 800; cursor: pointer; }
    .btn-primary { background: #b11623; color: #fff; }
    .btn-secondary { background: #e2e8f0; color: #0f172a; }
    #form-message { margin: 0; font-weight: 700; }
    .brands-card-head p { margin: -10px 0 16px; color: #64748b; font-size: 14px; }
    .brand-list { display: grid; gap: 10px; }
    .brand-row { display: grid; grid-template-columns: 90px minmax(0,1fr) auto; gap: 14px; align-items: center; padding: 14px; border: 1px solid #e2e8f0; border-radius: 10px; background: #f8fafc; }
    .brand-logo-wrap { width: 90px; height: 58px; display: grid; place-items: center; border-radius: 8px; background: #fff; border: 1px solid #e2e8f0; overflow: hidden; }
    .brand-logo-wrap img { max-width: 78px; max-height: 46px; object-fit: contain; }
    .brand-logo-wrap span { font-weight: 900; color: #b11623; }
    .brand-info { min-width: 0; display: grid; gap: 3px; }
    .brand-info strong { color: #0f172a; overflow-wrap: anywhere; }
    .brand-info span, .brand-info small { color: #64748b; overflow-wrap: anywhere; }
    .brand-actions { display: flex; gap: 8px; }
    .edit-btn, .delete-btn { min-height: 40px; border: 0; border-radius: 7px; padding: 8px 13px; font-weight: 800; cursor: pointer; }
    .edit-btn { background: #e2e8f0; color: #334155; }
    .delete-btn { background: #dc2626; color: #fff; }
    @media (max-width: 640px) {
      .brand-form-card, .brands-card { padding: 16px; }
      .field input { min-height: 44px; font-size: 16px; }
      .form-actions { display: grid; grid-template-columns: 1fr 1fr; }
      .brand-row { grid-template-columns: 70px minmax(0,1fr); gap: 10px; }
      .brand-logo-wrap { width: 70px; height: 52px; }
      .brand-logo-wrap img { max-width: 60px; max-height: 42px; }
      .brand-actions { grid-column: 1 / -1; display: grid; grid-template-columns: 1fr 1fr; }
      .edit-btn, .delete-btn { min-height: 44px; }
      .preview img { max-width: 100%; }
    }
  </style>
</AdminLayout>
