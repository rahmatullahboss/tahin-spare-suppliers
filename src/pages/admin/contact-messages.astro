---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { getRuntimeEnv } from "../../lib/server/env";
import { getDb } from "../../lib/server/db";
import { isAuthenticated } from "../../lib/server/session";

const env = getRuntimeEnv(Astro.locals);
const authenticated = await isAuthenticated(Astro.cookies, env.SESSION_SECRET);

if (!authenticated) {
  return Astro.redirect("/admin/login");
}

const sql = getDb(env);
const countResult = await sql.query(`SELECT COUNT(*) as total FROM contact_messages`);
const total = countResult[0]?.total ?? 0;
---

<AdminLayout title="Contact Messages" active="contacts">
  <div class="page-header">
    <div>
      <h1>Contact Messages</h1>
      <p class="subtitle" id="count-display">{total} message{total !== 1 ? 's' : ''}</p>
    </div>
  </div>

  <div class="card">
    <div class="card-toolbar">
      <div class="search-wrap">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="search-icon"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        <input type="text" id="search-input" placeholder="Search by name, email, subject..." autocomplete="off" />
      </div>
    </div>

    <div class="messages-list" id="messages-list">
      <div class="loading-state">Loading...</div>
    </div>

    <div class="pagination" id="pagination"></div>
  </div>
</AdminLayout>

<style is:global>
  .admin-main .page-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.5rem; }
  .admin-main .page-header h1 { font-size: 1.5rem; margin: 0 0 0.25rem; }
  .admin-main .subtitle { color: #64748b; margin: 0; font-size: 0.9rem; }

  .admin-main .card { background: #fff; border-radius: 0.75rem; border: 1px solid #e2e8f0; box-shadow: 0 1px 2px rgba(0,0,0,0.04); overflow: hidden; }
  .admin-main .card-toolbar { padding: 0.75rem 1rem; border-bottom: 1px solid #e2e8f0; background: #f8fafc; }
  .admin-main .search-wrap { position: relative; max-width: 360px; }
  .admin-main .search-icon { position: absolute; left: 0.75rem; top: 50%; transform: translateY(-50%); color: #94a3b8; pointer-events: none; }
  .admin-main #search-input {
    width: 100%; padding: 0.5rem 0.75rem 0.5rem 2.2rem; border: 1px solid #e2e8f0; border-radius: 0.5rem;
    font-size: 0.85rem; outline: none; box-sizing: border-box; background: #fff;
  }
  .admin-main #search-input:focus { border-color: #d97706; box-shadow: 0 0 0 3px rgba(217,119,6,0.08); }

  .admin-main .messages-list { display: flex; flex-direction: column; }
  .admin-main .message-card {
    padding: 1rem 1.25rem; border-bottom: 1px solid #f1f5f9; cursor: pointer; transition: background 0.12s;
  }
  .admin-main .message-card:hover { background: #f8fafc; }
  .admin-main .message-card:last-child { border-bottom: none; }

  .admin-main .message-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; margin-bottom: 0.5rem; }
  .admin-main .message-from { display: flex; align-items: center; gap: 0.75rem; }
  .admin-main .avatar {
    width: 36px; height: 36px; border-radius: 999px; background: linear-gradient(135deg, #d97706, #b45309);
    color: #fff; display: flex; align-items: center; justify-content: center; font-size: 0.8rem; font-weight: 700; flex-shrink: 0;
  }
  .admin-main .message-from strong { font-size: 0.9rem; color: #0f172a; }
  .admin-main .message-email { color: #d97706; font-size: 0.8rem; text-decoration: none; }
  .admin-main .message-email:hover { text-decoration: underline; }
  .admin-main .message-date { color: #94a3b8; font-size: 0.78rem; white-space: nowrap; flex-shrink: 0; }

  .admin-main .message-subject {
    font-weight: 600; color: #374151; margin: 0 0 0.5rem 3rem; font-size: 0.85rem;
    padding: 0.4rem 0.75rem; background: #fef3c7; border-radius: 0.35rem; display: inline-block;
  }
  .admin-main .message-content { color: #64748b; line-height: 1.6; margin: 0 0 0 3rem; white-space: pre-wrap; font-size: 0.85rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  .admin-main .empty-state { text-align: center; padding: 3rem 1rem; }
  .admin-main .empty-icon { font-size: 2.5rem; margin-bottom: 0.5rem; opacity: 0.4; }
  .admin-main .empty-state h2 { margin: 0 0 0.25rem; font-size: 1rem; color: #0f172a; }
  .admin-main .empty-state p { margin: 0; color: #94a3b8; font-size: 0.85rem; }

  .admin-main .loading-state, .admin-main .error-state { text-align: center; padding: 3rem 1rem; color: #94a3b8; font-size: 0.9rem; }
  .admin-main .error-state { color: #dc2626; }

  .admin-main .pagination {
    display: flex; justify-content: center; align-items: center; gap: 0.3rem;
    padding: 0.75rem; border-top: 1px solid #e2e8f0; background: #f8fafc;
  }
  .admin-main .pagination button {
    padding: 0.35rem 0.7rem; border: 1px solid #e2e8f0; background: #fff; border-radius: 0.4rem;
    cursor: pointer; font-size: 0.8rem; font-weight: 500; transition: all 0.15s;
  }
  .admin-main .pagination button:hover:not(:disabled) { background: #f1f5f9; border-color: #cbd5e1; }
  .admin-main .pagination button:disabled { opacity: 0.35; cursor: not-allowed; }
  .admin-main .pagination .page-info { padding: 0.35rem 0.4rem; color: #94a3b8; font-size: 0.8rem; }

  @media (max-width: 600px) {
    .admin-main .message-header { flex-direction: column; }
    .admin-main .message-subject, .admin-main .message-content { margin-left: 0; }
  }
</style>

<script>
  const PAGE_SIZE = 20;
  let currentPage = 1;
  let searchQuery = "";
  let totalPages = 1;

  const listEl = document.getElementById("messages-list");
  const paginationEl = document.getElementById("pagination");
  const countEl = document.getElementById("count-display");
  const searchInput = document.getElementById("search-input");

  let searchTimeout;

  searchInput.addEventListener("input", () => {
    clearTimeout(searchTimeout);
    searchTimeout = setTimeout(() => {
      searchQuery = searchInput.value.trim();
      currentPage = 1;
      loadMessages();
    }, 300);
  });

  async function loadMessages() {
    try {
      const params = new URLSearchParams({ page: String(currentPage), limit: String(PAGE_SIZE) });
      if (searchQuery) params.set("search", searchQuery);

      const res = await fetch(`/api/admin/contact-messages?${params}`, { credentials: 'include' });

      if (!res.ok) {
        if (res.status === 401) { listEl.innerHTML = '<div class="error-state">Session expired. Please refresh.</div>'; return; }
        throw new Error("Failed to load");
      }

      const data = await res.json();
      totalPages = data.totalPages || 1;
      renderMessages(data.items || []);
      renderPagination();
      countEl.textContent = `${data.total || 0} message${(data.total || 0) !== 1 ? 's' : ''}`;
    } catch (err) {
      console.error(err);
      listEl.innerHTML = '<div class="error-state">Failed to load messages</div>';
    }
  }

  function getInitials(name) {
    return name.split(' ').map(n => n[0]).join('').toUpperCase().slice(0, 2) || '?';
  }

  function renderMessages(messages) {
    if (messages.length === 0) {
      listEl.innerHTML = `<div class="empty-state"><div class="empty-icon">📧</div><h2>No messages found</h2><p>${searchQuery ? 'Try a different search term' : 'Contact form submissions will appear here.'}</p></div>`;
      return;
    }

    listEl.innerHTML = messages.map(msg => `
      <article class="message-card">
        <header class="message-header">
          <div class="message-from">
            <div class="avatar">${getInitials(msg.name)}</div>
            <div>
              <strong>${escapeHtml(msg.name)}</strong><br/>
              <a href="mailto:${escapeHtml(msg.email)}" class="message-email">${escapeHtml(msg.email)}</a>
            </div>
          </div>
          <time class="message-date">${formatDate(msg.created_at)}</time>
        </header>
        ${msg.subject ? `<p class="message-subject">${escapeHtml(msg.subject)}</p>` : ''}
        <p class="message-content">${escapeHtml(msg.message)}</p>
      </article>
    `).join('');
  }

  function renderPagination() {
    if (totalPages <= 1) { paginationEl.textContent = ""; return; }
    paginationEl.textContent = "";

    const prevBtn = document.createElement("button");
    prevBtn.textContent = "← Prev";
    prevBtn.disabled = currentPage === 1;
    prevBtn.addEventListener("click", () => goToPage(currentPage - 1));
    paginationEl.appendChild(prevBtn);

    getPageNumbers().forEach(p => {
      if (typeof p === "string") {
        const info = document.createElement("span");
        info.className = "page-info";
        info.textContent = "…";
        paginationEl.appendChild(info);
      } else {
        const btn = document.createElement("button");
        btn.textContent = String(p);
        if (p === currentPage) btn.style.fontWeight = "bold";
        btn.addEventListener("click", () => goToPage(p));
        paginationEl.appendChild(btn);
      }
    });

    const nextBtn = document.createElement("button");
    nextBtn.textContent = "Next →";
    nextBtn.disabled = currentPage === totalPages;
    nextBtn.addEventListener("click", () => goToPage(currentPage + 1));
    paginationEl.appendChild(nextBtn);
  }

  function getPageNumbers() {
    const pages = [1];
    if (totalPages <= 7) {
      for (let i = 2; i <= totalPages; i++) pages.push(i);
    } else {
      const start = Math.max(2, currentPage - 1);
      const end = Math.min(totalPages - 1, currentPage + 1);
      if (start > 2) pages.push("…");
      for (let i = start; i <= end; i++) pages.push(i);
      if (end < totalPages - 1) pages.push("…");
      pages.push(totalPages);
    }
    return pages;
  }

  function goToPage(page) {
    if (page < 1 || page > totalPages) return;
    currentPage = page;
    loadMessages();
  }

  function escapeHtml(str) {
    const d = document.createElement("div");
    d.textContent = str;
    return d.innerHTML;
  }

  function formatDate(dateStr) {
    const d = new Date(dateStr);
    return d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric", hour: "2-digit", minute: "2-digit" });
  }

  loadMessages();
</script>
