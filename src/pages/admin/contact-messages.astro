---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { getRuntimeEnv } from "../../lib/server/env";
import { getDb } from "../../lib/server/db";
import { isAuthenticated } from "../../lib/server/session";

const env = getRuntimeEnv(Astro.locals);
const authenticated = await isAuthenticated(Astro.cookies, env.SESSION_SECRET);

if (!authenticated) {
  return Astro.redirect("/admin/login");
}

const sql = getDb(env);
const countResult = await sql.query(`SELECT COUNT(*) as total FROM contact_messages`);
const total = countResult[0]?.total ?? 0;
---

<AdminLayout title="Contact Messages" active="contacts">
  <div class="page-header">
    <h1>Contact Messages</h1>
    <p class="subtitle" id="count-display">{total} message{total !== 1 ? 's' : ''}</p>
  </div>

  <div class="filters">
    <input
      type="text"
      id="search-input"
      placeholder="Search by name, email, subject..."
      autocomplete="off"
    />
  </div>

  <div class="messages-list" id="messages-list">
    <div class="loading-state">Loading...</div>
  </div>

  <div class="pagination" id="pagination"></div>
</AdminLayout>

<style>
  .page-header {
    margin-bottom: 30px;
  }
  .page-header h1 {
    font-size: 28px;
    margin: 0 0 5px;
  }
  .subtitle {
    color: #666;
    margin: 0;
  }

  .empty-state {
    text-align: center;
    padding: 60px 20px;
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.04);
  }
  .empty-icon {
    font-size: 60px;
    margin-bottom: 20px;
  }
  .empty-state h2 {
    margin: 0 0 10px;
    font-size: 20px;
    color: #333;
  }
  .empty-state p {
    margin: 0;
    color: #888;
  }

  .messages-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .message-card {
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.04);
    padding: 24px;
  }

  .message-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 12px;
    gap: 20px;
  }

  .message-from {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .message-from strong {
    font-size: 16px;
    color: #222;
  }

  .message-from a {
    color: #c0392b;
    font-size: 14px;
    text-decoration: none;
  }

  .message-from a:hover {
    text-decoration: underline;
  }

  .message-date {
    color: #888;
    font-size: 13px;
    white-space: nowrap;
  }

  .message-subject {
    font-weight: 600;
    color: #333;
    margin: 0 0 12px;
    padding-bottom: 12px;
    border-bottom: 1px solid #eee;
  }

  .message-content {
    color: #555;
    line-height: 1.6;
    margin: 0;
    white-space: pre-wrap;
  }

  .loading-state, .error-state {
    text-align: center;
    padding: 60px 20px;
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.04);
    color: #888;
  }
  .error-state {
    color: #c0392b;
  }

  @media (max-width: 600px) {
    .message-header {
      flex-direction: column;
    }
    .message-date {
      margin-top: 5px;
    }
  }
</style>

<script>
  const PAGE_SIZE = 20;
  let currentPage = 1;
  let searchQuery = "";
  let totalPages = 1;

  const listEl = document.getElementById("messages-list") as HTMLDivElement;
  const paginationEl = document.getElementById("pagination") as HTMLDivElement;
  const countEl = document.getElementById("count-display") as HTMLParagraphElement;
  const searchInput = document.getElementById("search-input") as HTMLInputElement;

  let searchTimeout: ReturnType<typeof setTimeout>;

  searchInput.addEventListener("input", () => {
    clearTimeout(searchTimeout);
    searchTimeout = setTimeout(() => {
      searchQuery = searchInput.value.trim();
      currentPage = 1;
      loadMessages();
    }, 300);
  });

  async function loadMessages() {
    try {
      const params = new URLSearchParams({
        page: String(currentPage),
        limit: String(PAGE_SIZE),
      });
      if (searchQuery) params.set("search", searchQuery);

      const res = await fetch(`/api/admin/contact-messages?${params}`);
      if (!res.ok) throw new Error("Failed to load");

      const data = await res.json();
      totalPages = data.totalPages || 1;
      renderMessages(data.items);
      renderPagination();
      countEl.textContent = `${data.total} message${data.total !== 1 ? 's' : ''}`;
    } catch (err) {
      console.error(err);
      listEl.innerHTML = '<div class="error-state">Failed to load messages</div>';
    }
  }

  function renderMessages(messages: Array<{id: string; name: string; email: string; subject: string; message: string; created_at: string}>) {
    if (messages.length === 0) {
      listEl.innerHTML = `
        <div class="empty-state">
          <div class="empty-icon">📧</div>
          <h2>No messages found</h2>
          <p>${searchQuery ? 'Try a different search term' : 'Contact form submissions will appear here.'}</p>
        </div>
      `;
      return;
    }

    listEl.innerHTML = messages.map((msg) => `
      <article class="message-card">
        <header class="message-header">
          <div class="message-from">
            <strong>${escapeHtml(msg.name)}</strong>
            <a href="mailto:${escapeHtml(msg.email)}">${escapeHtml(msg.email)}</a>
          </div>
          <time class="message-date">${formatDate(msg.created_at)}</time>
        </header>
        ${msg.subject ? `<p class="message-subject">${escapeHtml(msg.subject)}</p>` : ''}
        <p class="message-content">${escapeHtml(msg.message)}</p>
      </article>
    `).join('');
  }

  function renderPagination() {
    if (totalPages <= 1) {
      paginationEl.textContent = "";
      return;
    }

    paginationEl.textContent = "";

    const prevBtn = document.createElement("button");
    prevBtn.textContent = "Prev";
    prevBtn.disabled = currentPage === 1;
    prevBtn.addEventListener("click", () => goToPage(currentPage - 1));
    paginationEl.appendChild(prevBtn);

    getPageNumbers().forEach((p) => {
      if (typeof p === "string") {
        const info = document.createElement("span");
        info.className = "page-info";
        info.textContent = "…";
        paginationEl.appendChild(info);
      } else {
        const btn = document.createElement("button");
        btn.textContent = String(p);
        if (p === currentPage) btn.style.fontWeight = "bold";
        btn.addEventListener("click", () => goToPage(p));
        paginationEl.appendChild(btn);
      }
    });

    const nextBtn = document.createElement("button");
    nextBtn.textContent = "Next";
    nextBtn.disabled = currentPage === totalPages;
    nextBtn.addEventListener("click", () => goToPage(currentPage + 1));
    paginationEl.appendChild(nextBtn);

    const info = document.createElement("span");
    info.className = "page-info";
    info.textContent = `Page ${currentPage} of ${totalPages}`;
    paginationEl.appendChild(info);
  }

  function getPageNumbers() {
    const pages: (number | string)[] = [1];
    if (totalPages <= 7) {
      for (let i = 2; i <= totalPages; i++) pages.push(i);
    } else {
      const start = Math.max(2, currentPage - 1);
      const end = Math.min(totalPages - 1, currentPage + 1);
      if (start > 2) pages.push("…");
      for (let i = start; i <= end; i++) pages.push(i);
      if (end < totalPages - 1) pages.push("…");
      pages.push(totalPages);
    }
    return pages;
  }

  function goToPage(page: number) {
    if (page < 1 || page > totalPages) return;
    currentPage = page;
    loadMessages();
  }

  function escapeHtml(str: string): string {
    const d = document.createElement("div");
    d.textContent = str;
    return d.innerHTML;
  }

  function formatDate(dateStr: string): string {
    const d = new Date(dateStr);
    return d.toLocaleDateString("en-US", {
      year: "numeric",
      month: "short",
      day: "numeric",
      hour: "2-digit",
      minute: "2-digit",
    });
  }

  loadMessages();
</script>