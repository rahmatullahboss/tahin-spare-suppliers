---
import ImageUploader from "../../components/admin/ImageUploader.astro";
import AdminLayout from "../../layouts/AdminLayout.astro";
import { mergeCategories } from "../../lib/categories";
import { getRuntimeEnv } from "../../lib/server/env";
import { isAuthenticated } from "../../lib/server/session";
import { listCustomCategories, listAllSubcategories } from "../../lib/server/categories";

const env = getRuntimeEnv(Astro.locals);
const authenticated = await isAuthenticated(Astro.cookies, env.SESSION_SECRET);

if (!authenticated) {
  return Astro.redirect("/admin/login");
}

const customCategories = await listCustomCategories(env);
const allSubcategories = await listAllSubcategories(env);
const allCategories = mergeCategories(customCategories);
const defaultCategories = allCategories.filter((category) => category.isDefault);
---

<AdminLayout title="Categories" active="categories">
  <div class="page-header">
    <h1>Equipment Categories</h1>
    <p class="subtitle">{customCategories.length} custom + {defaultCategories.length} default</p>
  </div>

  <section class="add-form">
    <h2 data-form-title>Add New Category</h2>
    <form id="category-form">
      <input type="hidden" id="category-id" />
      <div class="field">
        <label for="category-parent">Parent Category (optional)</label>
        <select id="category-parent">
          <option value="">-- Top-level category --</option>
          {defaultCategories.map((cat) => (
            <option value={cat.value}>{cat.value}</option>
          ))}
          {customCategories.map((cat) => (
            <option value={cat.id}>{cat.name}</option>
          ))}
        </select>
      </div>
      <div class="field">
        <label for="category-name">Category name *</label>
        <input type="text" id="category-name" placeholder="Category name" required />
      </div>
      <ImageUploader label="Category Photo" />
      <div class="preview" data-preview></div>
      <div class="form-actions">
        <button type="submit" class="btn btn-primary" data-submit-btn>Add Category</button>
        <button type="button" class="btn btn-secondary" data-reset-btn>Reset</button>
      </div>
    </form>
    <div id="form-message"></div>
  </section>

  <section class="categories-section">
    <h2>Default Categories (read-only)</h2>
    <div class="category-list">
      {defaultCategories.map((category) => (
        <div class="category-item default">
          <img class="cat-thumb" src={category.imageUrl} alt="" loading="lazy" />
          <div class="cat-info">
            <span class="cat-name">{category.value}</span>
            <span class="cat-slug">/{category.slug}</span>
          </div>
        </div>
      ))}
    </div>
  </section>

  {customCategories.length > 0 && (
    <section class="categories-section">
      <h2>Custom Categories</h2>
      <div class="category-list">
        {customCategories.map((category) => {
          const subs = allSubcategories.filter((s) => s.parentId === category.id);
          return (
            <div class="category-group">
              <div class="category-item custom">
                <img class="cat-thumb" src={category.imageUrl || "/images/marine-propulsion-engine.jpg"} alt="" loading="lazy" />
                <div class="cat-info">
                  <span class="cat-name">{category.name}</span>
                  <span class="cat-slug">/{category.slug}</span>
                </div>
                <div class="cat-actions">
                  <button
                    type="button"
                    class="edit-btn"
                    data-edit-id={category.id}
                    data-edit-name={category.name}
                    data-edit-image-url={category.imageUrl}
                    data-edit-image-key={category.imageKey}
                    data-edit-parent=""
                  >
                    Edit
                  </button>
                  <button class="delete-btn" data-id={category.id}>Delete</button>
                </div>
              </div>
              {subs.length > 0 && (
                <div class="subcategory-list">
                  {subs.map((sub) => (
                    <div class="category-item custom subcategory-item">
                      <img class="cat-thumb sub-thumb" src={sub.imageUrl || "/images/marine-propulsion-engine.jpg"} alt="" loading="lazy" />
                      <div class="cat-info">
                        <span class="cat-name">{sub.name}</span>
                        <span class="cat-slug">/{category.slug}/{sub.slug}</span>
                      </div>
                      <div class="cat-actions">
                        <button
                          type="button"
                          class="edit-btn"
                          data-edit-id={sub.id}
                          data-edit-name={sub.name}
                          data-edit-image-url={sub.imageUrl}
                          data-edit-image-key={sub.imageKey}
                          data-edit-parent={category.id}
                        >
                          Edit
                        </button>
                        <button class="delete-btn" data-id={sub.id}>Delete</button>
                      </div>
                    </div>
                  ))}
                </div>
              )}
            </div>
          );
        })}
      </div>
    </section>
  )}

  <style>
    .page-header { margin-bottom: 30px; }
    .page-header h1 { font-size: 28px; margin: 0 0 5px; }
    .subtitle { color: #666; margin: 0; }

    .add-form {
      background: #fff;
      padding: 24px;
      border-radius: 12px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.04);
      margin-bottom: 30px;
    }
    .add-form h2 { font-size: 18px; margin: 0 0 15px; }
    #category-form { display: grid; gap: 14px; max-width: 560px; }
    .field { display: grid; gap: 6px; }
    .field label { font-size: 13px; font-weight: 700; color: #333; }
    #category-name,
    #category-parent {
      padding: 12px 16px;
      border: 1px solid #ddd;
      border-radius: 8px;
      font-size: 14px;
    }
    .form-actions { display: flex; gap: 10px; align-items: center; }
    .btn { padding: 12px 24px; border-radius: 8px; font-weight: 600; border: none; cursor: pointer; }
    .btn-primary { background: #c0392b; color: #fff; }
    .btn-primary:hover { background: #a93226; }
    .btn-secondary { background: #ececec; color: #111; }
    #form-message { margin-top: 12px; font-size: 14px; }
    .preview img { width: 100%; max-width: 260px; border-radius: 12px; display: block; }

    .categories-section {
      background: #fff;
      padding: 24px;
      border-radius: 12px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.04);
      margin-bottom: 20px;
    }
    .categories-section h2 { font-size: 18px; margin: 0 0 15px; }

    .category-list { display: flex; flex-direction: column; gap: 10px; }
    .category-item {
      display: grid;
      grid-template-columns: 72px 1fr auto;
      gap: 14px;
      align-items: center;
      padding: 14px 18px;
      background: #f9f9f9;
      border-radius: 8px;
    }
    .category-item.default { background: #f0f0f0; grid-template-columns: 72px 1fr; }
    .category-item.custom { background: #f9f9f9; }
    .cat-thumb {
      width: 72px;
      height: 54px;
      object-fit: cover;
      border-radius: 8px;
      background: #e5e5e5;
    }
    .cat-info { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
    .cat-name { font-weight: 600; color: #222; overflow-wrap: anywhere; }
    .cat-slug { color: #888; font-size: 13px; }
    .cat-actions { display: flex; gap: 8px; }
    .edit-btn,
    .delete-btn {
      border: none;
      padding: 7px 14px;
      border-radius: 6px;
      font-size: 13px;
      cursor: pointer;
      font-weight: 700;
    }
    .edit-btn { background: #f1f5f9; color: #334155; }
    .edit-btn:hover { background: #e2e8f0; }
    .delete-btn { background: #dc3545; color: #fff; }
    .delete-btn:hover { background: #c82333; }

    .category-group { display: flex; flex-direction: column; gap: 10px; }
    .subcategory-list {
      margin-left: 24px;
      border-left: 2px solid #e2e8f0;
      padding-left: 12px;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .subcategory-item { background: #f8fafc !important; }
    .sub-thumb { width: 54px; height: 40px; }

    @media (max-width: 640px) {
      .page-header {
        margin-bottom: 20px;
      }
      .page-header h1 {
        font-size: 24px;
        line-height: 1.2;
      }
      .add-form,
      .categories-section {
        padding: 16px;
        border-radius: 10px;
      }
      #category-form {
        max-width: none;
      }
      #category-name,
      #category-parent {
        width: 100%;
        min-height: 44px;
        box-sizing: border-box;
        font-size: 16px;
      }
      .form-actions {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
      }
      .btn {
        min-height: 44px;
        padding: 10px 14px;
      }
      .preview img {
        max-width: 100%;
        height: auto;
      }
      .category-item,
      .category-item.default {
        grid-template-columns: 58px minmax(0, 1fr);
        gap: 10px 12px;
        padding: 12px;
      }
      .cat-thumb {
        width: 58px;
        height: 46px;
      }
      .sub-thumb {
        width: 50px;
        height: 40px;
      }
      .cat-name,
      .cat-slug {
        overflow-wrap: anywhere;
        word-break: break-word;
      }
      .cat-actions {
        grid-column: 1 / -1;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
        width: 100%;
      }
      .edit-btn,
      .delete-btn {
        min-height: 44px;
        padding: 10px 12px;
      }
      .subcategory-list {
        margin-left: 0;
        padding-left: 10px;
      }
    }
  </style>

  <script>
    const form = document.getElementById('category-form') as HTMLFormElement | null;
    const formTitle = document.querySelector('[data-form-title]') as HTMLElement | null;
    const submitBtn = document.querySelector('[data-submit-btn]') as HTMLButtonElement | null;
    const resetBtn = document.querySelector('[data-reset-btn]') as HTMLButtonElement | null;
    const messageEl = document.getElementById('form-message') as HTMLElement | null;
    const idInput = document.getElementById('category-id') as HTMLInputElement | null;
    const nameInput = document.getElementById('category-name') as HTMLInputElement | null;
    const imageRemoveBtn = document.querySelector('[data-image-remove-btn]') as HTMLButtonElement | null;
    const uploadStatus = document.querySelector('[data-upload-status]') as HTMLElement | null;
    const imageInput = document.querySelector('[data-image-input]') as HTMLInputElement | null;
    const imageUrlInput = document.querySelector('[data-image-url]') as HTMLInputElement | null;
    const imageKeyInput = document.querySelector('[data-image-key]') as HTMLInputElement | null;
    const previewEl = document.querySelector('[data-preview]') as HTMLElement | null;
    const parentSelect = document.getElementById('category-parent') as HTMLSelectElement | null;

    let selectedFile: File | null = null;
    let selectedPreviewUrl = "";
    let existingImageUrl = "";
    let existingImageKey = "";
    let imageRemoved = false;

    const setMessage = (message: string, color: string) => {
      if (!messageEl) return;
      messageEl.textContent = message;
      messageEl.style.color = color;
    };

    const clearPreviewUrl = () => {
      if (selectedPreviewUrl) {
        URL.revokeObjectURL(selectedPreviewUrl);
        selectedPreviewUrl = "";
      }
    };

    const drawPreview = (url: string) => {
      if (!previewEl) return;
      if (!url) {
        previewEl.replaceChildren();
        return;
      }
      const img = document.createElement("img");
      img.src = url;
      img.alt = "";
      previewEl.replaceChildren(img);
    };

    const resetForm = () => {
      form?.reset();
      if (idInput) idInput.value = "";
      if (imageUrlInput) imageUrlInput.value = "";
      if (imageKeyInput) imageKeyInput.value = "";
      if (imageInput) imageInput.value = "";
      if (formTitle) formTitle.textContent = "Add New Category";
      if (submitBtn) submitBtn.textContent = "Add Category";
      selectedFile = null;
      imageRemoved = false;
      existingImageUrl = "";
      existingImageKey = "";
      clearPreviewUrl();
      drawPreview("");
      if (uploadStatus) uploadStatus.textContent = "";
      if (parentSelect) parentSelect.value = "";
      setMessage("", "#666");
    };

    const compressImageToWebp = async (file: File) => {
      const bitmap = await createImageBitmap(file);
      const canvas = document.createElement("canvas");
      const maxWidth = 1600;
      const scale = Math.min(1, maxWidth / bitmap.width);
      canvas.width = Math.round(bitmap.width * scale);
      canvas.height = Math.round(bitmap.height * scale);
      const context = canvas.getContext("2d");
      if (!context) {
        throw new Error("Image compression is not supported in this browser.");
      }
      context.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
      const blob = await new Promise<Blob | null>((resolve) => canvas.toBlob(resolve, "image/webp", 0.82));
      if (!blob) {
        throw new Error("Image compression failed.");
      }
      return new File([blob], `${file.name.replace(/\.[^.]+$/, "")}.webp`, { type: "image/webp" });
    };

    const uploadImage = async (file: File): Promise<{ url: string; key: string }> => {
      const uploadFormData = new FormData();
      uploadFormData.append("file", file);
      const response = await fetch("/api/upload", { method: "POST", body: uploadFormData });
      if (!response.ok) {
        const data = await response.json().catch(() => null) as { error?: string } | null;
        throw new Error(data?.error || "Image upload failed.");
      }
      return await response.json() as { url: string; key: string };
    };

    const deleteImageByKey = async (key: string) => {
      if (!key) return;
      await fetch("/api/upload/delete", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ key })
      });
    };

    imageInput?.addEventListener("change", () => {
      const file = imageInput.files?.[0] ?? null;
      clearPreviewUrl();
      selectedFile = file;
      imageRemoved = false;
      if (file) {
        selectedPreviewUrl = URL.createObjectURL(file);
        drawPreview(selectedPreviewUrl);
        if (uploadStatus) uploadStatus.textContent = "Image selected. Compressed & uploaded on save.";
      } else {
        drawPreview(existingImageUrl);
        if (uploadStatus) uploadStatus.textContent = "";
      }
    });

    imageRemoveBtn?.addEventListener("click", () => {
      clearPreviewUrl();
      selectedFile = null;
      imageRemoved = true;
      if (imageInput) imageInput.value = "";
      if (imageUrlInput) imageUrlInput.value = "";
      if (imageKeyInput) imageKeyInput.value = "";
      drawPreview("");
      if (uploadStatus) uploadStatus.textContent = "Image will be removed on save.";
    });

    document.querySelectorAll('[data-edit-id]').forEach((button) => {
      button.addEventListener('click', () => {
        const editButton = button as HTMLElement;
        if (idInput) idInput.value = editButton.dataset.editId ?? "";
        if (nameInput) nameInput.value = editButton.dataset.editName ?? "";
        existingImageUrl = editButton.dataset.editImageUrl ?? "";
        existingImageKey = editButton.dataset.editImageKey ?? "";
        if (imageUrlInput) imageUrlInput.value = existingImageUrl;
        if (imageKeyInput) imageKeyInput.value = existingImageKey;
        if (imageInput) imageInput.value = "";
        if (parentSelect) parentSelect.value = editButton.dataset.editParent ?? "";
        selectedFile = null;
        imageRemoved = false;
        clearPreviewUrl();
        drawPreview(existingImageUrl);
        if (formTitle) formTitle.textContent = "Edit Category";
        if (submitBtn) submitBtn.textContent = "Save Category";
        if (uploadStatus) uploadStatus.textContent = "";
        setMessage("", "#666");
        window.scrollTo({ top: 0, behavior: "smooth" });
      });
    });

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const id = idInput?.value.trim() ?? "";
      const name = nameInput?.value.trim() ?? "";
      let nextImageUrl = existingImageUrl;
      let nextImageKey = existingImageKey;
      let uploadedKeyToRollback = "";

      setMessage("Saving...", "#666");

      try {
        if (selectedFile) {
          if (uploadStatus) uploadStatus.textContent = "Compressing...";
          const compressed = await compressImageToWebp(selectedFile);
          if (uploadStatus) uploadStatus.textContent = "Uploading...";
          const uploaded = await uploadImage(compressed);
          nextImageUrl = uploaded.url || "";
          nextImageKey = uploaded.key || "";
          uploadedKeyToRollback = nextImageKey;
        }

        if (imageRemoved) {
          nextImageUrl = "";
          nextImageKey = "";
        }

        const parentValue = parentSelect?.value ?? "";
        // Default categories use display value, custom categories use UUID
        const isUuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(parentValue);
        const parentId = isUuid ? parentValue : "";

        const res = await fetch('/api/admin/categories', {
          method: id ? 'PUT' : 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id, name, imageUrl: nextImageUrl, imageKey: nextImageKey, parentId })
        });

        if (!res.ok) {
          const data = await res.json().catch(() => null) as { error?: string } | null;
          throw new Error(data?.error || 'Failed to save category');
        }

        const shouldDeleteOldImage = Boolean(existingImageKey) && existingImageKey !== nextImageKey && (Boolean(selectedFile) || imageRemoved);
        if (shouldDeleteOldImage) await deleteImageByKey(existingImageKey);

        setMessage('Category saved. Refreshing...', '#28a745');
        setTimeout(() => location.reload(), 700);
      } catch (error) {
        if (uploadedKeyToRollback) await deleteImageByKey(uploadedKeyToRollback);
        if (uploadStatus) uploadStatus.textContent = "";
        setMessage(error instanceof Error ? error.message : 'Failed to save category', '#dc3545');
      }
    });

    resetBtn?.addEventListener("click", resetForm);

    document.querySelectorAll('.delete-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        if (!confirm('Delete this category? Products already assigned to this category will keep the category text but the category page card will be removed.')) return;
        const id = (btn as HTMLElement).dataset.id;

        try {
          const res = await fetch('/api/admin/categories', {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id })
          });

          if (res.ok) {
            location.reload();
          } else {
            const data = await res.json().catch(() => null) as { error?: string } | null;
            alert(data?.error || 'Failed to delete');
          }
        } catch {
          alert('Network error');
        }
      });
    });
  </script>
</AdminLayout>
