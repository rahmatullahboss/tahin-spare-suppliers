---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { getRuntimeEnv } from "../../lib/server/env";
import { isAuthenticated } from "../../lib/server/session";
import { listContent } from "../../lib/server/repository";
import { listAllCategories } from "../../lib/server/categories";

const env = getRuntimeEnv(Astro.locals);
const authenticated = await isAuthenticated(Astro.cookies, env.SESSION_SECRET);

if (!authenticated) {
  return Astro.redirect("/admin/login");
}

const [products, blogPosts, categories] = await Promise.all([
  listContent(env, "products", { limit: 100 }),
  listContent(env, "blog", { limit: 100 }),
  listAllCategories(env)
]);

// Calculate category metrics
const categoryCounts = categories.map(cat => ({
  name: cat.value,
  count: products.filter(p => p.category === cat.value).length
})).sort((a, b) => b.count - a.count);

const recentProducts = products.slice(0, 5);
const recentBlogs = blogPosts.slice(0, 5);
---
<AdminLayout title="Admin Dashboard" active="dashboard">
  <div class="dashboard-header">
    <h1>Dashboard Overview</h1>
    <div class="quick-actions">
      <a href="/admin/products" class="btn btn-primary">+ Add Equipment</a>
      <a href="/admin/blog" class="btn btn-secondary">+ Write Blog Post</a>
    </div>
  </div>

  <section class="dashboard-grid">
    <article class="metric-card summary-card">
      <div class="metric-icon">📦</div>
      <div class="metric-content">
        <h2>{products.length}</h2>
        <p>Total Equipment</p>
      </div>
    </article>
    <article class="metric-card summary-card">
      <div class="metric-icon">📝</div>
      <div class="metric-content">
        <h2>{blogPosts.length}</h2>
        <p>Published Articles</p>
      </div>
    </article>
  </section>

  <div class="dashboard-content-grid">
    <section class="category-breakdown">
      <h2>Inventory Breakdown</h2>
      <div class="category-list">
        {categoryCounts.map(cat => (
          <div class="category-item">
            <span class="category-name">{cat.name}</span>
            <span class="category-count">{cat.count}</span>
            <div class="progress-bar">
              <div class="progress-fill" style={`width: ${products.length ? (cat.count / products.length) * 100 : 0}%`}></div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="recent-items">
      <h2>Recently Added Equipment</h2>
      <div class="items-list">
        {recentProducts.length > 0 ? recentProducts.map(p => (
          <a href="/admin/products" class="item-row">
            <div class="item-info">
              <strong>{p.title}</strong>
              <small>{p.category || 'Uncategorized'}</small>
            </div>
            <span class="view-link">Edit →</span>
          </a>
        )) : <p class="empty-text">No equipment found.</p>}
      </div>

      <h2 style="margin-top: 30px;">Recent Blog Posts</h2>
      <div class="items-list">
        {recentBlogs.length > 0 ? recentBlogs.map(b => (
          <a href="/admin/blog" class="item-row">
            <div class="item-info">
              <strong>{b.title}</strong>
            </div>
            <span class="view-link">Edit →</span>
          </a>
        )) : <p class="empty-text">No blog posts found.</p>}
      </div>
    </section>
  </div>
</AdminLayout>

<style>
  .dashboard-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;
  }
  .dashboard-header h1 {
    font-size: 28px;
    margin: 0;
  }
  .quick-actions {
    display: flex;
    gap: 12px;
  }
  .btn {
    padding: 10px 18px;
    border-radius: 8px;
    font-weight: 600;
    text-decoration: none;
    transition: opacity 0.2s;
  }
  .btn:hover { opacity: 0.9; }
  .btn-primary {
    background: #c0392b;
    color: white;
  }
  .btn-secondary {
    background: #111;
    color: white;
  }

  .dashboard-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
    margin-bottom: 30px;
  }
  .metric-card {
    background: #fff;
    padding: 24px;
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.04);
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .metric-icon {
    font-size: 40px;
    background: #f4f4f4;
    width: 70px;
    height: 70px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 16px;
  }
  .metric-content h2 {
    margin: 0 0 5px;
    font-size: 32px;
  }
  .metric-content p {
    margin: 0;
    color: #666;
    font-weight: 500;
  }

  .dashboard-content-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
  }
  .dashboard-content-grid h2 {
    font-size: 20px;
    margin-bottom: 20px;
    padding-bottom: 15px;
    border-bottom: 1px solid #eee;
  }

  .category-breakdown, .recent-items {
    background: #fff;
    padding: 24px;
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.04);
  }

  .category-item {
    margin-bottom: 15px;
  }
  .category-name {
    display: inline-block;
    font-weight: 500;
    margin-bottom: 5px;
  }
  .category-count {
    float: right;
    color: #666;
    font-weight: 600;
  }
  .progress-bar {
    width: 100%;
    height: 8px;
    background: #f0f0f0;
    border-radius: 4px;
    overflow: hidden;
  }
  .progress-fill {
    height: 100%;
    background: #c0392b;
    border-radius: 4px;
  }

  .items-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .item-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 16px;
    background: #f9f9f9;
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    transition: background 0.2s;
  }
  .item-row:hover {
    background: #f0f0f0;
  }
  .item-info {
    display: flex;
    flex-direction: column;
  }
  .item-info small {
    color: #666;
    margin-top: 4px;
  }
  .view-link {
    font-size: 14px;
    font-weight: 600;
    color: #c0392b;
  }
  .empty-text {
    color: #888;
    font-style: italic;
  }

  @media (max-width: 900px) {
    .dashboard-content-grid {
      grid-template-columns: 1fr;
    }
    .dashboard-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 15px;
    }
  }
</style>
