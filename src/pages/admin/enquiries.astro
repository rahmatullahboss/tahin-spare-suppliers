---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { getRuntimeEnv } from "../../lib/server/env";
import { getDb } from "../../lib/server/db";
import { isAuthenticated } from "../../lib/server/session";

const env = getRuntimeEnv(Astro.locals);
const authenticated = await isAuthenticated(Astro.cookies, env.SESSION_SECRET);

if (!authenticated) {
  return Astro.redirect("/admin/login");
}

const sql = getDb(env);
const countResult = await sql.query(`SELECT COUNT(*) as total FROM enquiries`);
const total = countResult[0]?.total ?? 0;
---

<AdminLayout title="Enquiries" active="enquiries">
  <div class="page-header">
    <div>
      <h1>Product Enquiries</h1>
      <p class="subtitle" id="count-display">{total} submission{total !== 1 ? 's' : ''}</p>
    </div>
  </div>

  <div class="card">
    <div class="card-toolbar">
      <div class="search-wrap">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="search-icon"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        <input type="text" id="search-input" placeholder="Search by name, email, equipment..." autocomplete="off" />
      </div>
    </div>

    <div class="enquiries-list" id="enquiries-list">
      <div class="loading-state">Loading...</div>
    </div>

    <div class="pagination" id="pagination"></div>
  </div>

  <div class="enquiry-modal" id="enquiry-modal" hidden>
    <button type="button" class="enquiry-modal-backdrop" data-enquiry-close aria-label="Close enquiry"></button>
    <section class="enquiry-modal-panel" role="dialog" aria-modal="true" aria-labelledby="enquiry-modal-title">
      <header>
        <div><span>Product enquiry</span><h2 id="enquiry-modal-title">Enquiry details</h2></div>
        <button type="button" class="modal-close" data-enquiry-close aria-label="Close">×</button>
      </header>
      <div class="enquiry-modal-body" data-enquiry-detail></div>
      <footer>
        <a href="#" class="reply-enquiry-btn" data-enquiry-reply>Reply by email</a>
        <button type="button" data-enquiry-close>Close</button>
      </footer>
    </section>
  </div>
</AdminLayout>

<style is:global>
  .admin-main .page-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.5rem; }
  .admin-main .page-header h1 { font-size: 1.5rem; margin: 0 0 0.25rem; }
  .admin-main .subtitle { color: #64748b; margin: 0; font-size: 0.9rem; }

  .admin-main .card { background: #fff; border-radius: 0.75rem; border: 1px solid #e2e8f0; box-shadow: 0 1px 2px rgba(0,0,0,0.04); overflow: hidden; }
  .admin-main .card-toolbar { padding: 0.75rem 1rem; border-bottom: 1px solid #e2e8f0; background: #f8fafc; }
  .admin-main .search-wrap { position: relative; max-width: 360px; }
  .admin-main .search-icon { position: absolute; left: 0.75rem; top: 50%; transform: translateY(-50%); color: #94a3b8; pointer-events: none; }
  .admin-main #search-input {
    width: 100%; padding: 0.5rem 0.75rem 0.5rem 2.2rem; border: 1px solid #e2e8f0; border-radius: 0.5rem;
    font-size: 0.85rem; outline: none; box-sizing: border-box; background: #fff;
  }
  .admin-main #search-input:focus { border-color: #d97706; box-shadow: 0 0 0 3px rgba(217,119,6,0.08); }

  .admin-main .enquiries-list { display: flex; flex-direction: column; }
  .admin-main .enquiry-card {
    padding: 1rem 1.25rem; border-bottom: 1px solid #f1f5f9; cursor: pointer; transition: background 0.12s;
  }
  .admin-main .enquiry-card:hover { background: #f8fafc; }
  .admin-main .enquiry-card:last-child { border-bottom: none; }

  .admin-main .enquiry-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; margin-bottom: 0.5rem; }
  .admin-main .enquiry-from { display: flex; align-items: center; gap: 0.75rem; }
  .admin-main .avatar {
    width: 36px; height: 36px; border-radius: 999px; background: linear-gradient(135deg, #2563eb, #1d4ed8);
    color: #fff; display: flex; align-items: center; justify-content: center; font-size: 0.8rem; font-weight: 700; flex-shrink: 0;
  }
  .admin-main .enquiry-from strong { font-size: 0.9rem; color: #0f172a; }
  .admin-main .contact-info { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
  .admin-main .contact-info a { color: #d97706; font-size: 0.8rem; text-decoration: none; }
  .admin-main .contact-info a:hover { text-decoration: underline; }
  .admin-main .phone { color: #64748b; font-size: 0.8rem; }
  .admin-main .enquiry-date { color: #94a3b8; font-size: 0.78rem; white-space: nowrap; flex-shrink: 0; }

  .admin-main .enquiry-meta { margin: 0.25rem 0 0.5rem 3rem; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .admin-main .equipment-badge {
    display: inline-flex; align-items: center; gap: 0.3rem;
    background: #fef3c7; color: #92400e; padding: 0.2rem 0.6rem; border-radius: 0.35rem;
    font-size: 0.78rem; font-weight: 600;
  }

  .admin-main .enquiry-message {
    color: #64748b; line-height: 1.6; margin: 0 0 0 3rem; white-space: pre-wrap; font-size: 0.85rem;
    padding: 0.75rem; background: #f8fafc; border-radius: 0.5rem; border: 1px solid #f1f5f9;
  }

  .admin-main .empty-state { text-align: center; padding: 3rem 1rem; }
  .admin-main .empty-icon { font-size: 2.5rem; margin-bottom: 0.5rem; opacity: 0.4; }
  .admin-main .empty-state h2 { margin: 0 0 0.25rem; font-size: 1rem; color: #0f172a; }
  .admin-main .empty-state p { margin: 0; color: #94a3b8; font-size: 0.85rem; }

  .admin-main .loading-state, .admin-main .error-state { text-align: center; padding: 3rem 1rem; color: #94a3b8; font-size: 0.9rem; }
  .admin-main .error-state { color: #dc2626; }

  .admin-main .pagination {
    display: flex; justify-content: center; align-items: center; gap: 0.3rem;
    padding: 0.75rem; border-top: 1px solid #e2e8f0; background: #f8fafc;
  }
  .admin-main .pagination button {
    padding: 0.35rem 0.7rem; border: 1px solid #e2e8f0; background: #fff; border-radius: 0.4rem;
    cursor: pointer; font-size: 0.8rem; font-weight: 500; transition: all 0.15s;
  }
  .admin-main .pagination button:hover:not(:disabled) { background: #f1f5f9; border-color: #cbd5e1; }
  .admin-main .pagination button:disabled { opacity: 0.35; cursor: not-allowed; }
  .admin-main .pagination .page-info { padding: 0.35rem 0.4rem; color: #94a3b8; font-size: 0.8rem; }

  .enquiry-modal[hidden] { display: none; }
  .enquiry-modal { position: fixed; inset: 0; z-index: 1200; display: grid; place-items: center; padding: 16px; }
  .enquiry-modal-backdrop { position: absolute; inset: 0; border: 0; background: rgba(15,23,42,.62); }
  .enquiry-modal-panel { position: relative; width: min(680px, 100%); max-height: 88vh; overflow: auto; border-radius: 14px; background: #fff; box-shadow: 0 30px 80px rgba(0,0,0,.3); }
  .enquiry-modal-panel header { display:flex;justify-content:space-between;align-items:flex-start;gap:12px;padding:18px 20px;border-bottom:1px solid #e2e8f0; }
  .enquiry-modal-panel header span { color:#b11623;font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.1em; }
  .enquiry-modal-panel h2 { margin:3px 0 0;color:#111827;font-size:22px; }
  .modal-close { width:42px;height:42px;border:0;border-radius:50%;background:#f1f5f9;font-size:25px;cursor:pointer; }
  .enquiry-modal-body { padding:20px;display:grid;gap:14px; }
  .enquiry-detail-row { display:grid;gap:4px; }
  .enquiry-detail-row strong { color:#475569;font-size:12px;text-transform:uppercase;letter-spacing:.05em; }
  .enquiry-detail-row span,.enquiry-detail-row a,.enquiry-detail-message { color:#0f172a;overflow-wrap:anywhere; }
  .enquiry-detail-message { white-space:pre-wrap;line-height:1.7;padding:14px;border:1px solid #e2e8f0;border-radius:9px;background:#f8fafc; }
  .enquiry-modal-panel footer { position:sticky;bottom:0;display:flex;justify-content:flex-end;gap:8px;padding:14px 20px;border-top:1px solid #e2e8f0;background:#fff; }
  .enquiry-modal-panel footer a,.enquiry-modal-panel footer button { min-height:44px;display:inline-flex;align-items:center;justify-content:center;border:0;border-radius:8px;padding:0 16px;font-weight:800;text-decoration:none;cursor:pointer; }
  .reply-enquiry-btn { background:#b11623;color:#fff; }.enquiry-modal-panel footer button { background:#e2e8f0;color:#0f172a; }
  html.enquiry-modal-open { overflow:hidden; }

  @media (max-width: 600px) {
    .admin-main .page-header { margin-bottom: 16px; }
    .admin-main .card-toolbar { padding: 12px; }
    .admin-main .search-wrap { max-width: none; width: 100%; }
    .admin-main #search-input { min-height: 44px; font-size: 16px; }
    .admin-main .enquiry-card { padding: 14px; }
    .admin-main .enquiry-header { flex-direction: column; gap: 8px; }
    .admin-main .enquiry-from { min-width: 0; align-items: flex-start; }
    .admin-main .enquiry-from > div:last-child { min-width: 0; }
    .admin-main .contact-info { min-width: 0; }
    .admin-main .contact-info a,
    .admin-main .phone {
      overflow-wrap: anywhere;
      word-break: break-word;
    }
    .admin-main .enquiry-date { white-space: normal; }
    .admin-main .equipment-badge {
      max-width: 100%;
      white-space: normal;
      overflow-wrap: anywhere;
    }
    .admin-main .enquiry-message,
    .admin-main .enquiry-meta {
      margin-left: 0;
      max-width: 100%;
      overflow-wrap: anywhere;
    }
    .admin-main .pagination {
      justify-content: flex-start;
      overflow-x: auto;
      scrollbar-width: thin;
    }
    .admin-main .pagination button {
      min-width: 44px;
      min-height: 44px;
      flex: 0 0 auto;
    }
    .admin-main .pagination .page-info { flex: 0 0 auto; }
  }
</style>

<script>
  const PAGE_SIZE = 20;
  let currentPage = 1;
  let searchQuery = "";
  let totalPages = 1;
  let currentEnquiries = [];

  const listEl = document.getElementById("enquiries-list");
  const paginationEl = document.getElementById("pagination");
  const countEl = document.getElementById("count-display");
  const searchInput = document.getElementById("search-input");

  let searchTimeout;

  searchInput.addEventListener("input", () => {
    clearTimeout(searchTimeout);
    searchTimeout = setTimeout(() => {
      searchQuery = searchInput.value.trim();
      currentPage = 1;
      loadEnquiries();
    }, 300);
  });

  async function loadEnquiries() {
    try {
      const params = new URLSearchParams({ page: String(currentPage), limit: String(PAGE_SIZE) });
      if (searchQuery) params.set("search", searchQuery);

      const res = await fetch(`/api/admin/enquiries?${params}`, { credentials: 'include' });

      if (!res.ok) {
        if (res.status === 401) { listEl.innerHTML = '<div class="error-state">Session expired. Please refresh.</div>'; return; }
        throw new Error("Failed to load");
      }

      const data = await res.json();
      totalPages = data.totalPages || 1;
      renderEnquiries(data.items || []);
      renderPagination();
      countEl.textContent = `${data.total || 0} submission${(data.total || 0) !== 1 ? 's' : ''}`;
    } catch (err) {
      console.error(err);
      listEl.innerHTML = '<div class="error-state">Failed to load enquiries</div>';
    }
  }

  function getInitials(name) {
    return name.split(' ').map(n => n[0]).join('').toUpperCase().slice(0, 2) || '?';
  }

  function renderEnquiries(enquiries) {
    currentEnquiries = enquiries;
    if (enquiries.length === 0) {
      listEl.innerHTML = `<div class="empty-state"><div class="empty-icon">📋</div><h2>No enquiries found</h2><p>${searchQuery ? 'Try a different search term' : 'Enquiry form submissions will appear here.'}</p></div>`;
      return;
    }

    listEl.innerHTML = enquiries.map((eq, index) => `
      <article class="enquiry-card" data-enquiry-index="${index}" tabindex="0" role="button" aria-label="Open enquiry from ${escapeHtml(eq.name)}">
        <header class="enquiry-header">
          <div class="enquiry-from">
            <div class="avatar">${getInitials(eq.name)}</div>
            <div>
              <strong>${escapeHtml(eq.name)}</strong><br/>
              <div class="contact-info">
                <a href="mailto:${escapeHtml(eq.email)}">${escapeHtml(eq.email)}</a>
                ${eq.phone ? `<span class="phone">${escapeHtml(eq.phone)}</span>` : ''}
              </div>
            </div>
          </div>
          <time class="enquiry-date">${formatDate(eq.created_at)}</time>
        </header>
        <div class="enquiry-meta">
          ${eq.equipment ? `<span class="equipment-badge">🔧 ${escapeHtml(eq.equipment)}</span>` : ''}
        </div>
        <p class="enquiry-message">${escapeHtml(eq.message)}</p>
      </article>
    `).join('');
  }

  const enquiryModal = document.getElementById('enquiry-modal');
  const enquiryDetail = enquiryModal?.querySelector('[data-enquiry-detail]');
  const enquiryReply = enquiryModal?.querySelector('[data-enquiry-reply]');

  function closeEnquiryModal() {
    if (!enquiryModal) return;
    enquiryModal.hidden = true;
    document.documentElement.classList.remove('enquiry-modal-open');
  }

  function openEnquiry(index) {
    const enquiry = currentEnquiries[index];
    if (!enquiry || !enquiryModal || !enquiryDetail) return;
    enquiryDetail.innerHTML = `
      <div class="enquiry-detail-row"><strong>Name</strong><span>${escapeHtml(enquiry.name || '')}</span></div>
      <div class="enquiry-detail-row"><strong>Email</strong><a href="mailto:${escapeHtml(enquiry.email || '')}">${escapeHtml(enquiry.email || '')}</a></div>
      ${enquiry.phone ? `<div class="enquiry-detail-row"><strong>Phone</strong><span>${escapeHtml(enquiry.phone)}</span></div>` : ''}
      ${enquiry.equipment ? `<div class="enquiry-detail-row"><strong>Equipment</strong><span>${escapeHtml(enquiry.equipment)}</span></div>` : ''}
      <div class="enquiry-detail-row"><strong>Date</strong><span>${formatDate(enquiry.created_at)}</span></div>
      <div class="enquiry-detail-row"><strong>Message</strong><div class="enquiry-detail-message">${escapeHtml(enquiry.message || '')}</div></div>
    `;
    if (enquiryReply) {
      const subject = enquiry.equipment ? `Re: Enquiry — ${enquiry.equipment}` : 'Re: Product Enquiry';
      enquiryReply.href = `/admin/emails/send?replyTo=${encodeURIComponent(enquiry.email || '')}&subject=${encodeURIComponent(subject)}`;
    }
    enquiryModal.hidden = false;
    document.documentElement.classList.add('enquiry-modal-open');
  }

  listEl.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    if (target.closest('a')) return;
    const card = target.closest('[data-enquiry-index]');
    if (!card) return;
    openEnquiry(Number(card.getAttribute('data-enquiry-index') || '-1'));
  });
  listEl.addEventListener('keydown', (event) => {
    if (event.key !== 'Enter' && event.key !== ' ') return;
    const target = event.target;
    if (!(target instanceof Element)) return;
    const card = target.closest('[data-enquiry-index]');
    if (!card) return;
    event.preventDefault();
    openEnquiry(Number(card.getAttribute('data-enquiry-index') || '-1'));
  });
  enquiryModal?.querySelectorAll('[data-enquiry-close]').forEach((button) => button.addEventListener('click', closeEnquiryModal));
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && enquiryModal && !enquiryModal.hidden) closeEnquiryModal(); });

  function renderPagination() {
    if (totalPages <= 1) { paginationEl.textContent = ""; return; }
    paginationEl.textContent = "";

    const prevBtn = document.createElement("button");
    prevBtn.textContent = "← Prev";
    prevBtn.disabled = currentPage === 1;
    prevBtn.addEventListener("click", () => goToPage(currentPage - 1));
    paginationEl.appendChild(prevBtn);

    getPageNumbers().forEach(p => {
      if (typeof p === "string") {
        const info = document.createElement("span");
        info.className = "page-info";
        info.textContent = "…";
        paginationEl.appendChild(info);
      } else {
        const btn = document.createElement("button");
        btn.textContent = String(p);
        if (p === currentPage) btn.style.fontWeight = "bold";
        btn.addEventListener("click", () => goToPage(p));
        paginationEl.appendChild(btn);
      }
    });

    const nextBtn = document.createElement("button");
    nextBtn.textContent = "Next →";
    nextBtn.disabled = currentPage === totalPages;
    nextBtn.addEventListener("click", () => goToPage(currentPage + 1));
    paginationEl.appendChild(nextBtn);
  }

  function getPageNumbers() {
    const pages = [1];
    if (totalPages <= 7) {
      for (let i = 2; i <= totalPages; i++) pages.push(i);
    } else {
      const start = Math.max(2, currentPage - 1);
      const end = Math.min(totalPages - 1, currentPage + 1);
      if (start > 2) pages.push("…");
      for (let i = start; i <= end; i++) pages.push(i);
      if (end < totalPages - 1) pages.push("…");
      pages.push(totalPages);
    }
    return pages;
  }

  function goToPage(page) {
    if (page < 1 || page > totalPages) return;
    currentPage = page;
    loadEnquiries();
  }

  function escapeHtml(str) {
    const d = document.createElement("div");
    d.textContent = str;
    return d.innerHTML;
  }

  function formatDate(dateStr) {
    const d = new Date(dateStr);
    return d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric", hour: "2-digit", minute: "2-digit" });
  }

  loadEnquiries();
</script>
