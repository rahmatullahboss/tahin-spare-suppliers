---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { getRuntimeEnv } from "../../lib/server/env";
import { getDb } from "../../lib/server/db";
import { isAuthenticated } from "../../lib/server/session";

const env = getRuntimeEnv(Astro.locals);
const authenticated = await isAuthenticated(Astro.cookies, env.SESSION_SECRET);

if (!authenticated) {
  return Astro.redirect("/admin/login");
}

const sql = getDb(env);
const countResult = await sql.query(`SELECT COUNT(*) as total FROM enquiries`);
const total = countResult[0]?.total ?? 0;
---

<AdminLayout title="Enquiries" active="enquiries">
  <div class="page-header">
    <h1>Enquiries</h1>
    <p class="subtitle" id="count-display">{total} submission{total !== 1 ? 's' : ''}</p>
  </div>

  <div class="filters">
    <input
      type="text"
      id="search-input"
      placeholder="Search by name, email, equipment..."
      autocomplete="off"
    />
  </div>

  <div class="enquiries-list" id="enquiries-list">
    <div class="loading-state">Loading...</div>
  </div>

  <div class="pagination" id="pagination"></div>
</AdminLayout>

<style>
  .page-header {
    margin-bottom: 30px;
  }
  .page-header h1 {
    font-size: 28px;
    margin: 0 0 5px;
  }
  .subtitle {
    color: #666;
    margin: 0;
  }

  .empty-state {
    text-align: center;
    padding: 60px 20px;
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.04);
  }
  .empty-icon {
    font-size: 60px;
    margin-bottom: 20px;
  }
  .empty-state h2 {
    margin: 0 0 10px;
    font-size: 20px;
    color: #333;
  }
  .empty-state p {
    margin: 0;
    color: #888;
  }

  .enquiries-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .enquiry-card {
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.04);
    padding: 24px;
  }

  .enquiry-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 12px;
    gap: 20px;
  }

  .enquiry-from {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .enquiry-from strong {
    font-size: 16px;
    color: #222;
  }

  .contact-info {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .contact-info a {
    color: #c0392b;
    font-size: 14px;
    text-decoration: none;
  }

  .contact-info a:hover {
    text-decoration: underline;
  }

  .phone {
    color: #666;
    font-size: 14px;
  }

  .enquiry-date {
    color: #888;
    font-size: 13px;
    white-space: nowrap;
  }

  .enquiry-equipment {
    font-weight: 600;
    color: #333;
    margin: 0 0 12px;
    padding-bottom: 12px;
    border-bottom: 1px solid #eee;
  }

  .enquiry-message {
    color: #555;
    line-height: 1.6;
    margin: 0;
    white-space: pre-wrap;
  }

  @media (max-width: 600px) {
    .enquiry-header {
      flex-direction: column;
    }
    .enquiry-date {
      margin-top: 5px;
    }
  }
</style>