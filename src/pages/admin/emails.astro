---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { getRuntimeEnv } from "../../lib/server/env";
import { getDb } from "../../lib/server/db";
import { isAuthenticated } from "../../lib/server/session";

const env = getRuntimeEnv(Astro.locals);
const authenticated = await isAuthenticated(Astro.cookies, env.SESSION_SECRET);

if (!authenticated) {
  return Astro.redirect("/admin/login");
}

const sql = getDb(env);
const [sentResult, inboundResult, unreadResult] = await Promise.all([
  sql.query(`SELECT COUNT(*) as total FROM sent_emails`),
  sql.query(`SELECT COUNT(*) as total FROM inbound_emails`),
  sql.query(`SELECT COUNT(*) as total FROM inbound_emails WHERE is_read = false`),
]);
const sentTotal = sentResult[0]?.total ?? 0;
const inboundTotal = inboundResult[0]?.total ?? 0;
const unreadCount = unreadResult[0]?.total ?? 0;
---

<AdminLayout title="Emails" active="emails">
  <div class="page-header">
    <div class="header-left">
      <h1>Emails</h1>
      <p class="subtitle" id="email-count">{unreadCount} unread / {inboundTotal} inbox</p>
    </div>
    <a href="/admin/emails/send" class="compose-btn">Compose Email</a>
  </div>

  <div class="mail-tabs" role="tablist" aria-label="Email folders">
    <button class="tab-btn active" type="button" data-folder="inbox">
      Inbox <span id="inbox-count">({inboundTotal})</span>
    </button>
    <button class="tab-btn" type="button" data-folder="sent">
      Sent <span id="sent-count">({sentTotal})</span>
    </button>
  </div>

  <div class="toolbar">
    <div class="filters" id="inbox-filters">
      <button class="filter-btn active" type="button" data-filter="all">All</button>
      <button class="filter-btn" type="button" data-filter="unread">Unread</button>
      <button class="filter-btn" type="button" data-filter="read">Read</button>
    </div>
    <input
      type="text"
      id="search-input"
      placeholder="Search inbox..."
      autocomplete="off"
    />
  </div>

  <div class="table-container">
    <table class="emails-table">
      <thead>
        <tr id="table-head-row">
          <th>Date</th>
          <th>From</th>
          <th>Subject</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody id="emails-body">
        <tr class="loading-row">
          <td colspan="4">Loading...</td>
        </tr>
      </tbody>
    </table>
  </div>

  <div class="pagination" id="pagination"></div>
</AdminLayout>

<style>
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 20px;
    gap: 20px;
  }
  .header-left h1 {
    font-size: 28px;
    margin: 0 0 5px;
  }
  .subtitle {
    color: #666;
    margin: 0;
  }

  .compose-btn {
    background: #c78f40;
    color: #111;
    padding: 10px 20px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    font-size: 14px;
    white-space: nowrap;
  }
  .compose-btn:hover {
    background: #b07d35;
  }

  .mail-tabs {
    display: flex;
    gap: 8px;
    margin-bottom: 16px;
    border-bottom: 1px solid #ddd;
  }
  .tab-btn {
    border: none;
    background: transparent;
    padding: 12px 16px;
    cursor: pointer;
    font-weight: 700;
    color: #666;
    border-bottom: 3px solid transparent;
  }
  .tab-btn.active {
    color: #111;
    border-bottom-color: #c78f40;
  }

  .toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }
  .filters {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .filter-btn {
    padding: 8px 16px;
    border: 1px solid #ddd;
    background: #fff;
    border-radius: 8px;
    cursor: pointer;
    font-size: 13px;
    font-weight: 600;
  }
  .filter-btn.active {
    background: #c78f40;
    color: #111;
    border-color: #c78f40;
  }
  #search-input {
    width: min(100%, 360px);
    padding: 10px 16px;
    border: 1px solid #ddd;
    border-radius: 8px;
    font-size: 14px;
    outline: none;
    box-sizing: border-box;
  }
  #search-input:focus {
    border-color: #c78f40;
  }

  .table-container {
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.04);
    overflow: hidden;
  }

  .emails-table {
    width: 100%;
    border-collapse: collapse;
  }
  .emails-table th {
    background: #f8f8f8;
    padding: 14px 20px;
    text-align: left;
    font-weight: 600;
    font-size: 13px;
    color: #555;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .emails-table td {
    padding: 16px 20px;
    border-top: 1px solid #eee;
    color: #333;
  }
  .emails-table tbody tr {
    cursor: pointer;
    transition: background 0.15s;
  }
  .emails-table tbody tr:hover {
    background: #f9f9f9;
  }
  .date-col {
    color: #888;
    font-size: 13px;
    white-space: nowrap;
  }
  .address-col {
    color: #c0392b;
    font-size: 14px;
    max-width: 240px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .subject-col {
    font-weight: 500;
    max-width: 360px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .status-col {
    text-align: center;
  }
  .unread-badge,
  .read-badge {
    padding: 4px 10px;
    border-radius: 12px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
  }
  .unread-badge {
    background: #e74c3c;
    color: #fff;
  }
  .read-badge {
    background: #eee;
    color: #888;
  }

  .loading-row td {
    text-align: center;
    color: #888;
    padding: 40px;
  }

  .empty-state {
    text-align: center;
    padding: 60px 20px;
  }
  .empty-state h2 {
    margin: 0 0 10px;
    font-size: 20px;
    color: #333;
  }
  .empty-state p {
    margin: 0;
    color: #888;
  }

  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    margin-top: 24px;
    flex-wrap: wrap;
  }
  .pagination button {
    padding: 8px 14px;
    border: 1px solid #ddd;
    background: #fff;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
  }
  .pagination button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
  .pagination .page-info {
    padding: 8px 12px;
    color: #666;
    font-size: 14px;
  }

  @media (max-width: 700px) {
    .page-header,
    .toolbar {
      align-items: stretch;
      flex-direction: column;
    }
    .compose-btn,
    #search-input {
      width: 100%;
      text-align: center;
    }
    .emails-table th,
    .emails-table td {
      padding: 12px 10px;
    }
  }
</style>

<script>
  const PAGE_SIZE = 20;
  let currentPage = 1;
  let searchQuery = "";
  let folder: "inbox" | "sent" = "inbox";
  let filter = "all";
  let totalPages = 1;

  type InboxEmail = {
    id: string;
    from_address: string;
    subject: string;
    is_read: boolean;
    created_at: string;
  };

  type SentEmail = {
    id: string;
    to_address: string;
    subject: string;
    created_at: string;
  };

  const tbody = document.getElementById("emails-body") as HTMLTableSectionElement;
  const pagination = document.getElementById("pagination") as HTMLDivElement;
  const countEl = document.getElementById("email-count") as HTMLParagraphElement;
  const searchInput = document.getElementById("search-input") as HTMLInputElement;
  const filtersEl = document.getElementById("inbox-filters") as HTMLDivElement;
  const headRow = document.getElementById("table-head-row") as HTMLTableRowElement;
  const inboxCountEl = document.getElementById("inbox-count") as HTMLSpanElement;
  const sentCountEl = document.getElementById("sent-count") as HTMLSpanElement;

  let searchTimeout: ReturnType<typeof setTimeout>;

  document.querySelectorAll<HTMLButtonElement>(".tab-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      document.querySelectorAll(".tab-btn").forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");
      folder = btn.dataset.folder === "sent" ? "sent" : "inbox";
      currentPage = 1;
      searchQuery = "";
      searchInput.value = "";
      updateFolderUi();
      loadEmails();
    });
  });

  document.querySelectorAll<HTMLButtonElement>(".filter-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      document.querySelectorAll(".filter-btn").forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");
      filter = btn.dataset.filter ?? "all";
      currentPage = 1;
      loadEmails();
    });
  });

  searchInput.addEventListener("input", () => {
    clearTimeout(searchTimeout);
    searchTimeout = setTimeout(() => {
      searchQuery = searchInput.value.trim();
      currentPage = 1;
      loadEmails();
    }, 300);
  });

  function updateFolderUi() {
    filtersEl.style.display = folder === "inbox" ? "flex" : "none";
    searchInput.placeholder = folder === "inbox" ? "Search inbox..." : "Search sent emails...";
    headRow.innerHTML = folder === "inbox"
      ? "<th>Date</th><th>From</th><th>Subject</th><th>Status</th>"
      : "<th>Date</th><th>To</th><th>Subject</th>";
  }

  async function loadEmails() {
    try {
      const params = new URLSearchParams({
        page: String(currentPage),
        limit: String(PAGE_SIZE),
      });
      if (searchQuery) params.set("search", searchQuery);

      const endpoint = folder === "inbox"
        ? `/api/admin/emails/inbound?${new URLSearchParams({ ...Object.fromEntries(params), filter })}`
        : `/api/admin/emails?${params}`;

      const res = await fetch(endpoint);
      if (!res.ok) throw new Error("Failed to load");

      const data = await res.json();
      totalPages = data.totalPages || 1;

      if (folder === "inbox") {
        renderInboxEmails(data.emails);
        countEl.textContent = `${data.unreadCount} unread / ${data.total} inbox`;
        inboxCountEl.textContent = `(${data.total})`;
      } else {
        renderSentEmails(data.emails);
        countEl.textContent = `${data.total} sent email${data.total !== 1 ? "s" : ""}`;
        sentCountEl.textContent = `(${data.total})`;
      }
      renderPagination();
    } catch (err) {
      console.error(err);
      renderError();
    }
  }

  function renderError() {
    tbody.innerHTML = "";
    const tr = document.createElement("tr");
    const td = document.createElement("td");
    td.setAttribute("colspan", folder === "inbox" ? "4" : "3");
    td.textContent = "Failed to load emails";
    td.style.textAlign = "center";
    td.style.color = "#c0392b";
    td.style.padding = "40px";
    tr.appendChild(td);
    tbody.appendChild(tr);
  }

  function renderEmpty(message: string) {
    tbody.textContent = "";
    const tr = document.createElement("tr");
    const td = document.createElement("td");
    td.setAttribute("colspan", folder === "inbox" ? "4" : "3");

    const container = document.createElement("div");
    container.className = "empty-state";

    const h2 = document.createElement("h2");
    h2.textContent = "No emails found";
    container.appendChild(h2);

    const p = document.createElement("p");
    p.textContent = searchQuery ? "Try a different search term" : message;
    container.appendChild(p);

    td.appendChild(container);
    tr.appendChild(td);
    tbody.appendChild(tr);
  }

  function renderInboxEmails(emails: InboxEmail[]) {
    if (emails.length === 0) {
      renderEmpty("No inbound emails yet");
      return;
    }

    tbody.textContent = "";
    emails.forEach((email) => {
      const tr = document.createElement("tr");
      tr.appendChild(createDateCell(email.created_at));
      tr.appendChild(createAddressCell(email.from_address));
      tr.appendChild(createSubjectCell(email.subject));

      const statusTd = document.createElement("td");
      statusTd.className = "status-col";
      const badge = document.createElement("span");
      badge.className = email.is_read ? "read-badge" : "unread-badge";
      badge.textContent = email.is_read ? "Read" : "New";
      statusTd.appendChild(badge);
      tr.appendChild(statusTd);

      tr.addEventListener("click", () => {
        window.location.href = `/admin/emails/thread/inbound/${email.id}`;
      });
      tbody.appendChild(tr);
    });
  }

  function renderSentEmails(emails: SentEmail[]) {
    if (emails.length === 0) {
      renderEmpty("No sent emails yet");
      return;
    }

    tbody.textContent = "";
    emails.forEach((email) => {
      const tr = document.createElement("tr");
      tr.appendChild(createDateCell(email.created_at));
      tr.appendChild(createAddressCell(email.to_address));
      tr.appendChild(createSubjectCell(email.subject));
      tr.addEventListener("click", () => {
        window.location.href = `/admin/emails/thread/sent/${email.id}`;
      });
      tbody.appendChild(tr);
    });
  }

  function createDateCell(date: string) {
    const td = document.createElement("td");
    td.className = "date-col";
    td.textContent = formatDate(date);
    return td;
  }

  function createAddressCell(address: string) {
    const td = document.createElement("td");
    td.className = "address-col";
    td.textContent = address;
    td.title = address;
    return td;
  }

  function createSubjectCell(subject: string) {
    const td = document.createElement("td");
    td.className = "subject-col";
    td.textContent = subject;
    td.title = subject;
    return td;
  }

  function renderPagination() {
    if (totalPages <= 1) {
      pagination.textContent = "";
      return;
    }

    pagination.textContent = "";

    const prevBtn = document.createElement("button");
    prevBtn.textContent = "Prev";
    prevBtn.disabled = currentPage === 1;
    prevBtn.addEventListener("click", () => goToPage(currentPage - 1));
    pagination.appendChild(prevBtn);

    getPageNumbers().forEach((p) => {
      if (typeof p === "string") {
        const info = document.createElement("span");
        info.className = "page-info";
        info.textContent = "...";
        pagination.appendChild(info);
      } else {
        const btn = document.createElement("button");
        btn.textContent = String(p);
        if (p === currentPage) btn.style.fontWeight = "bold";
        btn.addEventListener("click", () => goToPage(p));
        pagination.appendChild(btn);
      }
    });

    const nextBtn = document.createElement("button");
    nextBtn.textContent = "Next";
    nextBtn.disabled = currentPage === totalPages;
    nextBtn.addEventListener("click", () => goToPage(currentPage + 1));
    pagination.appendChild(nextBtn);

    const info = document.createElement("span");
    info.className = "page-info";
    info.textContent = `Page ${currentPage} of ${totalPages}`;
    pagination.appendChild(info);
  }

  function getPageNumbers(): (number | string)[] {
    const pages: (number | string)[] = [1];
    if (totalPages <= 7) {
      for (let i = 2; i <= totalPages; i++) pages.push(i);
    } else {
      const start = Math.max(2, currentPage - 1);
      const end = Math.min(totalPages - 1, currentPage + 1);
      if (start > 2) pages.push("...");
      for (let i = start; i <= end; i++) pages.push(i);
      if (end < totalPages - 1) pages.push("...");
      pages.push(totalPages);
    }
    return pages;
  }

  function goToPage(page: number) {
    if (page < 1 || page > totalPages) return;
    currentPage = page;
    loadEmails();
  }

  function formatDate(dateStr: string): string {
    const d = new Date(dateStr);
    return d.toLocaleDateString("en-US", {
      year: "numeric",
      month: "short",
      day: "numeric",
      hour: "2-digit",
      minute: "2-digit",
    });
  }

  updateFolderUi();
  loadEmails();
</script>
