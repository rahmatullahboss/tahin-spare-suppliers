---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { getRuntimeEnv } from "../../lib/server/env";
import { getDb } from "../../lib/server/db";
import { isAuthenticated } from "../../lib/server/session";

const env = getRuntimeEnv(Astro.locals);
const authenticated = await isAuthenticated(Astro.cookies, env.SESSION_SECRET);

if (!authenticated) {
  return Astro.redirect("/admin/login");
}

const sql = getDb(env);
const [sentResult, inboundResult, unreadResult] = await Promise.all([
  sql.query(`SELECT COUNT(*) as total FROM sent_emails`),
  sql.query(`SELECT COUNT(*) as total FROM inbound_emails`),
  sql.query(`SELECT COUNT(*) as total FROM inbound_emails WHERE is_read = false`),
]);
const sentTotal = Number(sentResult[0]?.total ?? 0);
const inboundTotal = Number(inboundResult[0]?.total ?? 0);
const unreadCount = Number(unreadResult[0]?.total ?? 0);
---

<AdminLayout title="Emails" active="emails">
  <section class="mailbox-shell" aria-labelledby="mailbox-title">
    <header class="mailbox-header">
      <div>
        <p class="eyebrow">Sales mailbox</p>
        <h1 id="mailbox-title">Email</h1>
        <p class="mailbox-summary" id="email-count">
          {unreadCount} unread · {inboundTotal} messages
        </p>
      </div>
      <div class="mailbox-header-actions">
        <a href="/admin/emails/signature" class="signature-btn">Signature</a>
        <a href="/admin/emails/send" class="compose-btn">
          <span aria-hidden="true" class="compose-plus">+</span>
          Compose
        </a>
      </div>
    </header>

    <div class="mailbox-panel">
      <div class="mailbox-toolbar">
        <div class="folder-tabs" role="tablist" aria-label="Email folders">
          <button
            class="folder-tab active"
            type="button"
            role="tab"
            aria-selected="true"
            aria-controls="mail-list"
            data-folder="inbox"
          >
            Inbox
            <span class="folder-count" id="inbox-count">{inboundTotal}</span>
          </button>
          <button
            class="folder-tab"
            type="button"
            role="tab"
            aria-selected="false"
            aria-controls="mail-list"
            data-folder="sent"
          >
            Sent
            <span class="folder-count" id="sent-count">{sentTotal}</span>
          </button>
        </div>

        <div class="mailbox-actions">
          <label class="search-field" for="search-input">
            <span class="sr-only">Search email</span>
            <span class="search-mark" aria-hidden="true"></span>
            <input
              type="search"
              id="search-input"
              placeholder="Search inbox"
              autocomplete="off"
            />
          </label>
          <button type="button" class="refresh-btn" id="refresh-btn" aria-label="Refresh mailbox">
            Refresh
          </button>
        </div>
      </div>

      <div class="filter-strip" id="inbox-filters" aria-label="Inbox filters">
        <button class="filter-btn active" type="button" data-filter="all">All</button>
        <button class="filter-btn" type="button" data-filter="unread">Unread</button>
        <button class="filter-btn" type="button" data-filter="read">Read</button>
      </div>

      <div class="mail-list" id="mail-list" aria-live="polite" aria-busy="true">
        <div class="loading-list" aria-label="Loading messages">
          <div class="loading-line"></div>
          <div class="loading-line"></div>
          <div class="loading-line"></div>
          <div class="loading-line"></div>
        </div>
      </div>

      <nav class="mail-pagination" id="pagination" aria-label="Email pages"></nav>
    </div>
  </section>
</AdminLayout>

