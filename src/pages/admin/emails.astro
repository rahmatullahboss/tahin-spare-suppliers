---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { getRuntimeEnv } from "../../lib/server/env";
import { getDb } from "../../lib/server/db";
import { isAuthenticated } from "../../lib/server/session";

const env = getRuntimeEnv(Astro.locals);
const authenticated = await isAuthenticated(Astro.cookies, env.SESSION_SECRET);

if (!authenticated) {
  return Astro.redirect("/admin/login");
}

const sql = getDb(env);
const [sentResult, inboundResult, unreadResult] = await Promise.all([
  sql.query(`SELECT COUNT(*) as total FROM sent_emails`),
  sql.query(`SELECT COUNT(*) as total FROM inbound_emails`),
  sql.query(`SELECT COUNT(*) as total FROM inbound_emails WHERE is_read = false`),
]);
const sentTotal = sentResult[0]?.total ?? 0;
const inboundTotal = inboundResult[0]?.total ?? 0;
const unreadCount = unreadResult[0]?.total ?? 0;
---

<AdminLayout title="Emails" active="emails">
  <div class="page-header">
    <div class="header-left">
      <h1>Emails</h1>
      <p class="subtitle" id="email-count">{unreadCount} unread / {inboundTotal} inbox</p>
    </div>
    <a href="/admin/emails/send" class="compose-btn">Compose Email</a>
  </div>

  <div class="mail-tabs" role="tablist" aria-label="Email folders">
    <button class="tab-btn active" type="button" data-folder="inbox">
      Inbox <span id="inbox-count">({inboundTotal})</span>
    </button>
    <button class="tab-btn" type="button" data-folder="sent">
      Sent <span id="sent-count">({sentTotal})</span>
    </button>
  </div>

  <div class="toolbar">
    <div class="filters" id="inbox-filters">
      <button class="filter-btn active" type="button" data-filter="all">All</button>
      <button class="filter-btn" type="button" data-filter="unread">Unread</button>
      <button class="filter-btn" type="button" data-filter="read">Read</button>
    </div>
    <input
      type="text"
      id="search-input"
      placeholder="Search inbox..."
      autocomplete="off"
    />
  </div>

  <div class="table-container">
    <table class="emails-table">
      <thead>
        <tr id="table-head-row">
          <th>Date</th>
          <th>From</th>
          <th>Subject</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody id="emails-body">
        <tr class="loading-row">
          <td colspan="4">Loading...</td>
        </tr>
      </tbody>
    </table>
  </div>

  <div class="pagination" id="pagination"></div>
</AdminLayout>

<style is:global>
  .admin-main .page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1.5rem;
  }
  .admin-main .header-left h1 {
    font-size: 1.5rem;
    margin: 0 0 0.25rem;
    color: #0f172a;
  }
  .admin-main .subtitle {
    color: #64748b;
    margin: 0;
    font-size: 0.9rem;
  }

  .admin-main .compose-btn {
    background: #d97706;
    color: #fff;
    padding: 0.6rem 1.25rem;
    border-radius: 0.5rem;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.85rem;
    white-space: nowrap;
    transition: background 0.15s;
  }
  .admin-main .compose-btn:hover {
    background: #b45309;
  }

  .admin-main .mail-tabs {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid #e2e8f0;
  }
  .admin-main .tab-btn {
    border: none;
    background: transparent;
    padding: 0.75rem 1.25rem;
    cursor: pointer;
    font-weight: 600;
    font-size: 0.9rem;
    color: #64748b;
    border-bottom: 2px solid transparent;
    transition: all 0.15s;
  }
  .admin-main .tab-btn span {
    font-weight: 400;
    font-size: 0.8rem;
    margin-left: 0.25rem;
    opacity: 0.7;
  }
  .admin-main .tab-btn.active {
    color: #d97706;
    border-bottom-color: #d97706;
  }
  .admin-main .tab-btn:hover:not(.active) {
    color: #0f172a;
    background: #f8fafc;
  }

  .admin-main .toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }
  .admin-main .filters {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .admin-main .filter-btn {
    padding: 0.45rem 1rem;
    border: 1px solid #e2e8f0;
    background: #fff;
    border-radius: 0.5rem;
    cursor: pointer;
    font-size: 0.8rem;
    font-weight: 600;
    color: #475569;
    transition: all 0.15s;
  }
  .admin-main .filter-btn.active {
    background: #fef3c7;
    color: #92400e;
    border-color: #fcd34d;
  }
  .admin-main .filter-btn:hover:not(.active) {
    background: #f8fafc;
    border-color: #cbd5e1;
  }

  .admin-main #search-input {
    width: 100%;
    max-width: 360px;
    padding: 0.55rem 1rem;
    border: 1px solid #e2e8f0;
    border-radius: 0.5rem;
    font-size: 0.85rem;
    outline: none;
    box-sizing: border-box;
    background: #fff;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .admin-main #search-input:focus {
    border-color: #d97706;
    box-shadow: 0 0 0 3px rgba(217,119,6,0.08);
  }

  .admin-main .table-container {
    background: #fff;
    border-radius: 0.75rem;
    border: 1px solid #e2e8f0;
    box-shadow: 0 1px 2px rgba(0,0,0,0.04);
    overflow: hidden;
  }

  .admin-main .emails-table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }
  .admin-main .emails-table th {
    background: #f8fafc;
    padding: 0.75rem 1rem;
    text-align: left;
    font-weight: 700;
    font-size: 0.75rem;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-bottom: 1px solid #e2e8f0;
  }
  .admin-main .emails-table td {
    padding: 1rem;
    border-bottom: 1px solid #f1f5f9;
    color: #334155;
    vertical-align: middle;
  }
  .admin-main .emails-table tbody tr {
    cursor: pointer;
    transition: background 0.12s;
  }
  .admin-main .emails-table tbody tr:hover {
    background: #f8fafc;
  }
  .admin-main .emails-table tbody tr:last-child td {
    border-bottom: none;
  }

  .admin-main .date-col { width: 180px; font-size: 0.8rem; color: #94a3b8; }
  .admin-main .address-col { width: 250px; font-weight: 600; color: #0f172a; font-size: 0.85rem; }
  .admin-main .subject-col { width: auto; font-size: 0.85rem; color: #475569; }
  .admin-main .status-col { width: 100px; text-align: right; }

  .admin-main .emails-table .truncate {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .admin-main .unread-badge,
  .admin-main .read-badge {
    display: inline-block;
    padding: 0.2rem 0.5rem;
    border-radius: 0.35rem;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
  .admin-main .unread-badge {
    background: #fee2e2;
    color: #dc2626;
  }
  .admin-main .read-badge {
    background: #f1f5f9;
    color: #94a3b8;
  }

  .admin-main .loading-row td {
    text-align: center;
    color: #94a3b8;
    padding: 4rem 1rem;
    font-size: 0.9rem;
  }

  .admin-main .empty-state {
    text-align: center;
    padding: 4rem 1rem;
  }
  .admin-main .empty-state h2 {
    margin: 0 0 0.25rem;
    font-size: 1.1rem;
    color: #0f172a;
  }
  .admin-main .empty-state p {
    margin: 0;
    color: #94a3b8;
    font-size: 0.9rem;
  }

  .admin-main .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.3rem;
    margin-top: 1.5rem;
    flex-wrap: wrap;
  }
  .admin-main .pagination button {
    padding: 0.4rem 0.8rem;
    border: 1px solid #e2e8f0;
    background: #fff;
    border-radius: 0.5rem;
    cursor: pointer;
    font-size: 0.8rem;
    font-weight: 500;
    transition: all 0.15s;
  }
  .admin-main .pagination button:hover:not(:disabled) {
    background: #f8fafc;
    border-color: #cbd5e1;
  }
  .admin-main .pagination button:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
  .admin-main .pagination .page-info {
    padding: 0.4rem 0.6rem;
    color: #94a3b8;
    font-size: 0.8rem;
  }

  @media (max-width: 900px) {
    .admin-main .date-col { width: 140px; }
    .admin-main .address-col { width: 200px; }
  }

  @media (max-width: 700px) {
    .admin-main .page-header { flex-direction: column; gap: 1rem; }
    .admin-main .compose-btn { width: 100%; text-align: center; }
    .admin-main .toolbar { flex-direction: column; align-items: stretch; }
    .admin-main #search-input { max-width: none; }
    .admin-main .date-col, .admin-main .status-col { display: none; }
    .admin-main .emails-table th, .admin-main .emails-table td { padding: 0.75rem; }
  }
</style>

<script>
  const PAGE_SIZE = 20;
  let currentPage = 1;
  let searchQuery = "";
  let folder: "inbox" | "sent" = "inbox";
  let filter = "all";
  let totalPages = 1;

  type InboxEmail = {
    id: string;
    from_address: string;
    subject: string;
    is_read: boolean;
    created_at: string;
  };

  type SentEmail = {
    id: string;
    to_address: string;
    subject: string;
    created_at: string;
  };

  const tbody = document.getElementById("emails-body") as HTMLTableSectionElement;
  const pagination = document.getElementById("pagination") as HTMLDivElement;
  const countEl = document.getElementById("email-count") as HTMLParagraphElement;
  const searchInput = document.getElementById("search-input") as HTMLInputElement;
  const filtersEl = document.getElementById("inbox-filters") as HTMLDivElement;
  const headRow = document.getElementById("table-head-row") as HTMLTableRowElement;
  const inboxCountEl = document.getElementById("inbox-count") as HTMLSpanElement;
  const sentCountEl = document.getElementById("sent-count") as HTMLSpanElement;

  let searchTimeout: ReturnType<typeof setTimeout>;

  document.querySelectorAll<HTMLButtonElement>(".tab-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      document.querySelectorAll(".tab-btn").forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");
      folder = btn.dataset.folder === "sent" ? "sent" : "inbox";
      currentPage = 1;
      searchQuery = "";
      searchInput.value = "";
      updateFolderUi();
      loadEmails();
    });
  });

  document.querySelectorAll<HTMLButtonElement>(".filter-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      document.querySelectorAll(".filter-btn").forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");
      filter = btn.dataset.filter ?? "all";
      currentPage = 1;
      loadEmails();
    });
  });

  searchInput.addEventListener("input", () => {
    clearTimeout(searchTimeout);
    searchTimeout = setTimeout(() => {
      searchQuery = searchInput.value.trim();
      currentPage = 1;
      loadEmails();
    }, 300);
  });

  function updateFolderUi() {
    filtersEl.style.display = folder === "inbox" ? "flex" : "none";
    searchInput.placeholder = folder === "inbox" ? "Search inbox..." : "Search sent emails...";
    headRow.innerHTML = folder === "inbox"
      ? '<th class="date-col">Date</th><th class="address-col">From</th><th class="subject-col">Subject</th><th class="status-col">Status</th>'
      : '<th class="date-col">Date</th><th class="address-col">To</th><th class="subject-col">Subject</th><th class="status-col"></th>';
  }

  async function loadEmails() {
    try {
      const params = new URLSearchParams({
        page: String(currentPage),
        limit: String(PAGE_SIZE),
      });
      if (searchQuery) params.set("search", searchQuery);

      const endpoint = folder === "inbox"
        ? `/api/admin/emails/inbound?${new URLSearchParams({ ...Object.fromEntries(params), filter })}`
        : `/api/admin/emails?${params}`;

      const res = await fetch(endpoint);
      if (!res.ok) throw new Error("Failed to load");

      const data = await res.json();
      totalPages = data.totalPages || 1;

      if (folder === "inbox") {
        renderInboxEmails(data.emails);
        countEl.textContent = `${data.unreadCount} unread / ${data.total} inbox`;
        inboxCountEl.textContent = `(${data.total})`;
      } else {
        renderSentEmails(data.emails);
        countEl.textContent = `${data.total} sent email${data.total !== 1 ? "s" : ""}`;
        sentCountEl.textContent = `(${data.total})`;
      }
      renderPagination();
    } catch (err) {
      console.error(err);
      renderError();
    }
  }

  function renderError() {
    tbody.innerHTML = "";
    const tr = document.createElement("tr");
    const td = document.createElement("td");
    td.setAttribute("colspan", folder === "inbox" ? "4" : "3");
    td.textContent = "Failed to load emails";
    td.style.textAlign = "center";
    td.style.color = "#c0392b";
    td.style.padding = "40px";
    tr.appendChild(td);
    tbody.appendChild(tr);
  }

  function renderEmpty(message: string) {
    tbody.textContent = "";
    const tr = document.createElement("tr");
    const td = document.createElement("td");
    td.setAttribute("colspan", folder === "inbox" ? "4" : "3");

    const container = document.createElement("div");
    container.className = "empty-state";

    const h2 = document.createElement("h2");
    h2.textContent = "No emails found";
    container.appendChild(h2);

    const p = document.createElement("p");
    p.textContent = searchQuery ? "Try a different search term" : message;
    container.appendChild(p);

    td.appendChild(container);
    tr.appendChild(td);
    tbody.appendChild(tr);
  }

  function renderInboxEmails(emails: InboxEmail[]) {
    if (emails.length === 0) {
      renderEmpty("No inbound emails yet");
      return;
    }

    tbody.textContent = "";
    emails.forEach((email) => {
      const tr = document.createElement("tr");
      tr.appendChild(createDateCell(email.created_at));
      tr.appendChild(createAddressCell(email.from_address));
      tr.appendChild(createSubjectCell(email.subject));

      const statusTd = document.createElement("td");
      statusTd.className = "status-col";
      const badge = document.createElement("span");
      badge.className = email.is_read ? "read-badge" : "unread-badge";
      badge.textContent = email.is_read ? "Read" : "New";
      statusTd.appendChild(badge);
      tr.appendChild(statusTd);

      tr.addEventListener("click", () => {
        window.location.href = `/admin/emails/thread/inbound/${email.id}`;
      });
      tbody.appendChild(tr);
    });
  }

  function renderSentEmails(emails: SentEmail[]) {
    if (emails.length === 0) {
      renderEmpty("No sent emails yet");
      return;
    }

    tbody.textContent = "";
    emails.forEach((email) => {
      const tr = document.createElement("tr");
      tr.appendChild(createDateCell(email.created_at));
      tr.appendChild(createAddressCell(email.to_address));
      tr.appendChild(createSubjectCell(email.subject));
      tr.appendChild(document.createElement("td")); // Empty for sent folder
      tr.addEventListener("click", () => {
        window.location.href = `/admin/emails/thread/sent/${email.id}`;
      });
      tbody.appendChild(tr);
    });
  }

  function createDateCell(date: string) {
    const td = document.createElement("td");
    td.className = "date-col";
    td.textContent = formatDate(date);
    return td;
  }

  function createAddressCell(address: string) {
    const td = document.createElement("td");
    td.className = "address-col";
    const span = document.createElement("span");
    span.className = "truncate";
    span.textContent = address;
    span.title = address;
    td.appendChild(span);
    return td;
  }

  function createSubjectCell(subject: string) {
    const td = document.createElement("td");
    td.className = "subject-col";
    const span = document.createElement("span");
    span.className = "truncate";
    span.textContent = subject || "(No Subject)";
    span.title = subject || "(No Subject)";
    td.appendChild(span);
    return td;
  }

  function renderPagination() {
    if (totalPages <= 1) {
      pagination.textContent = "";
      return;
    }

    pagination.textContent = "";

    const prevBtn = document.createElement("button");
    prevBtn.textContent = "Prev";
    prevBtn.disabled = currentPage === 1;
    prevBtn.addEventListener("click", () => goToPage(currentPage - 1));
    pagination.appendChild(prevBtn);

    getPageNumbers().forEach((p) => {
      if (typeof p === "string") {
        const info = document.createElement("span");
        info.className = "page-info";
        info.textContent = "...";
        pagination.appendChild(info);
      } else {
        const btn = document.createElement("button");
        btn.textContent = String(p);
        if (p === currentPage) btn.style.fontWeight = "bold";
        btn.addEventListener("click", () => goToPage(p));
        pagination.appendChild(btn);
      }
    });

    const nextBtn = document.createElement("button");
    nextBtn.textContent = "Next";
    nextBtn.disabled = currentPage === totalPages;
    nextBtn.addEventListener("click", () => goToPage(currentPage + 1));
    pagination.appendChild(nextBtn);

    const info = document.createElement("span");
    info.className = "page-info";
    info.textContent = `Page ${currentPage} of ${totalPages}`;
    pagination.appendChild(info);
  }

  function getPageNumbers(): (number | string)[] {
    const pages: (number | string)[] = [1];
    if (totalPages <= 7) {
      for (let i = 2; i <= totalPages; i++) pages.push(i);
    } else {
      const start = Math.max(2, currentPage - 1);
      const end = Math.min(totalPages - 1, currentPage + 1);
      if (start > 2) pages.push("...");
      for (let i = start; i <= end; i++) pages.push(i);
      if (end < totalPages - 1) pages.push("...");
      pages.push(totalPages);
    }
    return pages;
  }

  function goToPage(page: number) {
    if (page < 1 || page > totalPages) return;
    currentPage = page;
    loadEmails();
  }

  function formatDate(dateStr: string): string {
    const d = new Date(dateStr);
    return d.toLocaleDateString("en-US", {
      year: "numeric",
      month: "short",
      day: "numeric",
      hour: "2-digit",
      minute: "2-digit",
    });
  }

  updateFolderUi();
  loadEmails();
</script>
