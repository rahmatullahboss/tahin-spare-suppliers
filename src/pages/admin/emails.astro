<script>
  const PAGE_SIZE = 20;
  let currentPage = 1;
  let totalPages = 1;
  let searchQuery = "";
  let folder: "inbox" | "sent" = "inbox";
  let filter: "all" | "unread" | "read" = "all";
  let requestController: AbortController | null = null;

  type InboxEmail = {
    id: string;
    from_address: string;
    to_address: string;
    subject: string;
    body: string;
    attachments_json: string;
    is_read: boolean;
    created_at: string;
  };

  type SentEmail = {
    id: string;
    to_address: string;
    subject: string;
    body: string;
    attachments_json: string;
    delivery_status: string;
    delivery_error: string;
    created_at: string;
  };

  const listEl = document.getElementById("mail-list") as HTMLDivElement;
  const paginationEl = document.getElementById("pagination") as HTMLElement;
  const countEl = document.getElementById("email-count") as HTMLParagraphElement;
  const searchInput = document.getElementById("search-input") as HTMLInputElement;
  const filtersEl = document.getElementById("inbox-filters") as HTMLDivElement;
  const refreshBtn = document.getElementById("refresh-btn") as HTMLButtonElement;
  const inboxCountEl = document.getElementById("inbox-count") as HTMLSpanElement;
  const sentCountEl = document.getElementById("sent-count") as HTMLSpanElement;
  let searchTimer: ReturnType<typeof setTimeout> | undefined;

  const getAddressDisplay = (address: string) => {
    const match = address.match(/^\s*"?([^"<]+?)"?\s*<([^>]+)>\s*$/);
    if (match) return match[1].trim() || match[2].trim();
    return address.trim() || "Unknown sender";
  };

  const getPreview = (value: string) => {
    if (!value) return "No message preview";
    const parsed = new DOMParser().parseFromString(value, "text/html");
    return (parsed.body.textContent || "")
      .replace(/\s+/g, " ")
      .trim()
      .slice(0, 220) || "No message preview";
  };

  const hasAttachments = (value: string) => {
    if (!value) return false;
    try {
      const parsed = JSON.parse(value);
      return Array.isArray(parsed) && parsed.length > 0;
    } catch {
      return false;
    }
  };

  const formatDate = (value: string) => {
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return "";
    const now = new Date();
    const sameDay = date.toDateString() === now.toDateString();
    if (sameDay) {
      return date.toLocaleTimeString([], { hour: "numeric", minute: "2-digit" });
    }
    if (date.getFullYear() === now.getFullYear()) {
      return date.toLocaleDateString([], { month: "short", day: "numeric" });
    }
    return date.toLocaleDateString([], { year: "numeric", month: "short", day: "numeric" });
  };

  const createText = (tag: string, className: string, text: string) => {
    const element = document.createElement(tag);
    element.className = className;
    element.textContent = text;
    return element;
  };

  const createMetaMark = (className: string, text: string, title?: string) => {
    const mark = createText("span", className, text);
    if (title) mark.title = title;
    return mark;
  };

  const deliveryClass = (status: string) => {
    if (["delivered"].includes(status)) return "success";
    if (["failed", "bounced", "suppressed", "complained"].includes(status)) return "error";
    return "pending";
  };

  const buildInboxRow = (email: InboxEmail) => {
    const row = document.createElement("a");
    row.href = `/admin/emails/thread/inbound/${encodeURIComponent(email.id)}`;
    row.className = `mail-row${email.is_read ? "" : " unread"}`;
    if (!email.is_read) row.setAttribute("aria-label", `Unread: ${email.subject || "No subject"}`);

    const personWrap = document.createElement("div");
    personWrap.className = "mail-person-wrap";
    if (!email.is_read) {
      const dot = document.createElement("span");
      dot.className = "unread-dot";
      dot.setAttribute("aria-hidden", "true");
      personWrap.appendChild(dot);
    }
    personWrap.appendChild(createText("span", "mail-person", getAddressDisplay(email.from_address)));

    const copy = document.createElement("div");
    copy.className = "mail-copy";
    const subjectLine = document.createElement("div");
    subjectLine.className = "mail-subject-line";
    subjectLine.appendChild(createText("span", "mail-subject", email.subject || "(No subject)"));
    subjectLine.appendChild(createText("span", "mail-preview", `— ${getPreview(email.body)}`));
    copy.appendChild(subjectLine);

    const meta = document.createElement("div");
    meta.className = "mail-meta";
    if (hasAttachments(email.attachments_json)) {
      meta.appendChild(createMetaMark("mail-file-mark", "File"));
    }
    meta.appendChild(createText("time", "mail-date", formatDate(email.created_at)));

    row.append(personWrap, copy, meta);
    return row;
  };

  const buildSentRow = (email: SentEmail) => {
    const row = document.createElement("a");
    row.href = `/admin/emails/thread/sent/${encodeURIComponent(email.id)}`;
    row.className = "mail-row";

    const personWrap = document.createElement("div");
    personWrap.className = "mail-person-wrap";
    personWrap.appendChild(createText("span", "mail-person", `To: ${getAddressDisplay(email.to_address)}`));

    const copy = document.createElement("div");
    copy.className = "mail-copy";
    const subjectLine = document.createElement("div");
    subjectLine.className = "mail-subject-line";
    subjectLine.appendChild(createText("span", "mail-subject", email.subject || "(No subject)"));
    subjectLine.appendChild(createText("span", "mail-preview", `— ${getPreview(email.body)}`));
    copy.appendChild(subjectLine);

    const meta = document.createElement("div");
    meta.className = "mail-meta";
    if (hasAttachments(email.attachments_json)) {
      meta.appendChild(createMetaMark("mail-file-mark", "File"));
    }
    const status = (email.delivery_status || "accepted").toLowerCase();
    meta.appendChild(
      createMetaMark(
        `delivery-mark ${deliveryClass(status)}`,
        status.replace(/_/g, " "),
        email.delivery_error || undefined
      )
    );
    meta.appendChild(createText("time", "mail-date", formatDate(email.created_at)));

    row.append(personWrap, copy, meta);
    return row;
  };

  const renderLoading = () => {
    listEl.setAttribute("aria-busy", "true");
    listEl.innerHTML = `
      <div class="loading-list" aria-label="Loading messages">
        <div class="loading-line"></div>
        <div class="loading-line"></div>
        <div class="loading-line"></div>
        <div class="loading-line"></div>
      </div>
    `;
  };

  const renderState = (kind: "empty" | "error", title: string, message: string) => {
    listEl.setAttribute("aria-busy", "false");
    listEl.textContent = "";
    const state = document.createElement("div");
    state.className = kind === "error" ? "mail-error" : "mail-empty";
    const inner = document.createElement("div");
    inner.className = "state-inner";
    const icon = document.createElement("div");
    icon.className = "state-icon";
    icon.setAttribute("aria-hidden", "true");
    inner.append(icon, createText("h2", "", title), createText("p", "", message));
    if (kind === "error") {
      const retry = createText("button", "retry-btn", "Try again") as HTMLButtonElement;
      retry.type = "button";
      retry.addEventListener("click", () => loadEmails());
      inner.appendChild(retry);
    }
    state.appendChild(inner);
    listEl.appendChild(state);
  };

  const renderInbox = (emails: InboxEmail[]) => {
    listEl.textContent = "";
    listEl.setAttribute("aria-busy", "false");
    if (emails.length === 0) {
      renderState(
        "empty",
        searchQuery ? "No matching email" : filter === "unread" ? "Inbox is caught up" : "Inbox is empty",
        searchQuery ? "Try another sender or subject." : "New customer messages will appear here."
      );
      return;
    }
    const fragment = document.createDocumentFragment();
    emails.forEach((email) => fragment.appendChild(buildInboxRow(email)));
    listEl.appendChild(fragment);
  };

  const renderSent = (emails: SentEmail[]) => {
    listEl.textContent = "";
    listEl.setAttribute("aria-busy", "false");
    if (emails.length === 0) {
      renderState(
        "empty",
        searchQuery ? "No matching sent email" : "Nothing sent yet",
        searchQuery ? "Try another recipient or subject." : "Messages you send will stay available here."
      );
      return;
    }
    const fragment = document.createDocumentFragment();
    emails.forEach((email) => fragment.appendChild(buildSentRow(email)));
    listEl.appendChild(fragment);
  };

  const getPageNumbers = (): (number | "ellipsis")[] => {
    if (totalPages <= 5) return Array.from({ length: totalPages }, (_, index) => index + 1);
    const values: (number | "ellipsis")[] = [1];
    const start = Math.max(2, currentPage - 1);
    const end = Math.min(totalPages - 1, currentPage + 1);
    if (start > 2) values.push("ellipsis");
    for (let page = start; page <= end; page += 1) values.push(page);
    if (end < totalPages - 1) values.push("ellipsis");
    values.push(totalPages);
    return values;
  };

  const renderPagination = () => {
    paginationEl.textContent = "";
    if (totalPages <= 1) return;

    const prev = createText("button", "", "Previous") as HTMLButtonElement;
    prev.type = "button";
    prev.disabled = currentPage === 1;
    prev.addEventListener("click", () => goToPage(currentPage - 1));
    paginationEl.appendChild(prev);

    getPageNumbers().forEach((value) => {
      if (value === "ellipsis") {
        paginationEl.appendChild(createText("span", "pagination-summary", "…"));
        return;
      }
      const button = createText("button", "", String(value)) as HTMLButtonElement;
      button.type = "button";
      button.setAttribute("aria-label", `Go to page ${value}`);
      if (value === currentPage) button.setAttribute("aria-current", "page");
      button.addEventListener("click", () => goToPage(value));
      paginationEl.appendChild(button);
    });

    paginationEl.appendChild(
      createText("span", "pagination-summary", `${currentPage} of ${totalPages}`)
    );

    const next = createText("button", "", "Next") as HTMLButtonElement;
    next.type = "button";
    next.disabled = currentPage === totalPages;
    next.addEventListener("click", () => goToPage(currentPage + 1));
    paginationEl.appendChild(next);
  };

  const updateFolderUi = () => {
    document.querySelectorAll<HTMLButtonElement>(".folder-tab").forEach((button) => {
      const active = button.dataset.folder === folder;
      button.classList.toggle("active", active);
      button.setAttribute("aria-selected", active ? "true" : "false");
    });
    filtersEl.hidden = folder !== "inbox";
    searchInput.placeholder = folder === "inbox" ? "Search inbox" : "Search sent email";
  };

  async function loadEmails() {
    requestController?.abort();
    requestController = new AbortController();
    renderLoading();
    refreshBtn.disabled = true;

    try {
      const params = new URLSearchParams({
        page: String(currentPage),
        limit: String(PAGE_SIZE),
      });
      if (searchQuery) params.set("search", searchQuery);
      if (folder === "inbox") params.set("filter", filter);

      const endpoint = folder === "inbox"
        ? `/api/admin/emails/inbound?${params}`
        : `/api/admin/emails?${params}`;
      const response = await fetch(endpoint, { signal: requestController.signal });
      if (!response.ok) throw new Error(`Mailbox request failed: ${response.status}`);
      const data = await response.json();
      totalPages = Math.max(1, Number(data.totalPages || 1));

      if (folder === "inbox") {
        renderInbox(data.emails ?? []);
        const unread = Number(data.unreadCount ?? 0);
        const total = Number(data.total ?? 0);
        countEl.textContent = `${unread} unread · ${total} messages`;
        inboxCountEl.textContent = String(total);
      } else {
        renderSent(data.emails ?? []);
        const total = Number(data.total ?? 0);
        countEl.textContent = `${total} sent message${total === 1 ? "" : "s"}`;
        sentCountEl.textContent = String(total);
      }
      renderPagination();
    } catch (error) {
      if (error instanceof DOMException && error.name === "AbortError") return;
      console.error(error);
      paginationEl.textContent = "";
      renderState("error", "Mailbox could not load", "Check the connection and try again.");
    } finally {
      refreshBtn.disabled = false;
    }
  }

  const goToPage = (page: number) => {
    if (page < 1 || page > totalPages || page === currentPage) return;
    currentPage = page;
    loadEmails();
    document.querySelector(".mailbox-panel")?.scrollIntoView({ behavior: "smooth", block: "start" });
  };

  document.querySelectorAll<HTMLButtonElement>(".folder-tab").forEach((button) => {
    button.addEventListener("click", () => {
      folder = button.dataset.folder === "sent" ? "sent" : "inbox";
      currentPage = 1;
      searchQuery = "";
      searchInput.value = "";
      updateFolderUi();
      loadEmails();
    });
  });

  document.querySelectorAll<HTMLButtonElement>(".filter-btn").forEach((button) => {
    button.addEventListener("click", () => {
      document.querySelectorAll(".filter-btn").forEach((item) => item.classList.remove("active"));
      button.classList.add("active");
      const nextFilter = button.dataset.filter;
      filter = nextFilter === "unread" || nextFilter === "read" ? nextFilter : "all";
      currentPage = 1;
      loadEmails();
    });
  });

  searchInput.addEventListener("input", () => {
    window.clearTimeout(searchTimer);
    searchTimer = window.setTimeout(() => {
      searchQuery = searchInput.value.trim();
      currentPage = 1;
      loadEmails();
    }, 280);
  });

  refreshBtn.addEventListener("click", () => loadEmails());

  updateFolderUi();
  loadEmails();
</script>
