---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { getRuntimeEnv } from "../../../lib/server/env";
import { isAuthenticated } from "../../../lib/server/session";

const env = getRuntimeEnv(Astro.locals);
const authenticated = await isAuthenticated(Astro.cookies, env.SESSION_SECRET);

if (!authenticated) {
  return Astro.redirect("/admin/login");
}

const replyTo = Astro.url.searchParams.get("replyTo") ?? "";
const subjectPrefill = Astro.url.searchParams.get("subject") ?? "";
const inReplyToId = Astro.url.searchParams.get("inReplyToId") ?? "";
---

<script define:vars={{ replyTo, subjectPrefill }}>
  window.addEventListener("DOMContentLoaded", () => {
    if (replyTo) {
      const toInput = document.getElementById("to");
      if (toInput) toInput.value = replyTo;
    }
    if (subjectPrefill) {
      const subjectInput = document.getElementById("subject");
      if (subjectInput) subjectInput.value = subjectPrefill;
    }
  });
</script>

<AdminLayout title="Compose Email" active="emails">
  <main class="compose-shell">
    <nav class="compose-nav" aria-label="Compose navigation">
      <a href="/admin/emails" class="back-link">Back to inbox</a>
    </nav>

    <header class="compose-heading">
      <p class="eyebrow">Sales mailbox</p>
      <h1>{replyTo ? "Reply" : "New message"}</h1>
      <p>{replyTo ? "Continue the customer conversation." : "Write and send from sales@tahinspare.com."}</p>
    </header>

    <section class="composer-window" aria-label="Email composer">
      <form id="send-form" data-in-reply-to-id={inReplyToId}>
        <div class="address-field">
          <label for="to">To</label>
          <input
            type="email"
            id="to"
            name="to"
            placeholder="recipient@example.com"
            required
            autocomplete="off"
          />
        </div>

        <div class="address-field subject-field">
          <label for="subject">Subject</label>
          <input
            type="text"
            id="subject"
            name="subject"
            placeholder="Email subject"
            required
            autocomplete="off"
          />
        </div>

        <div class="editor-surface">
          <div class="editor-toolbar" role="toolbar" aria-label="Message formatting">
            <div class="toolbar-group" aria-label="Text formatting">
              <button type="button" data-cmd="bold" title="Bold" aria-label="Bold"><b>B</b></button>
              <button type="button" data-cmd="italic" title="Italic" aria-label="Italic"><i>I</i></button>
              <button type="button" data-cmd="underline" title="Underline" aria-label="Underline"><u>U</u></button>
              <button type="button" data-cmd="h2" title="Heading" aria-label="Heading">H2</button>
            </div>
            <span class="sep" aria-hidden="true"></span>
            <div class="toolbar-group" aria-label="Lists">
              <button type="button" data-cmd="ul" title="Bullet list">• List</button>
              <button type="button" data-cmd="ol" title="Numbered list">1. List</button>
            </div>
            <span class="sep" aria-hidden="true"></span>
            <div class="toolbar-group media-tools" aria-label="Insert media">
              <button type="button" data-cmd="image" title="Add photo">Add photo</button>
              <button type="button" data-cmd="attachment" title="Attach file">Attach file</button>
            </div>
            <input
              type="file"
              id="email-image-input"
              accept="image/jpeg,image/png,image/webp,image/gif"
              multiple
              hidden
            />
            <input type="file" id="email-file-input" multiple hidden />
            <span class="toolbar-spacer"></span>
            <div class="toolbar-group history-tools" aria-label="Editing history">
              <button type="button" data-cmd="undo" title="Undo" aria-label="Undo">Undo</button>
              <button type="button" data-cmd="redo" title="Redo" aria-label="Redo">Redo</button>
            </div>
          </div>

          <div
            id="editor"
            class="editor"
            contenteditable="true"
            role="textbox"
            aria-multiline="true"
            aria-label="Message body"
            data-placeholder="Write your message…"
          ></div>
        </div>

        <div class="composer-feedback" aria-live="polite">
          <p id="image-status" class="image-status"></p>
        </div>

        <section class="attachments-field" aria-labelledby="attachments-title">
          <div class="attachments-title-row">
            <h2 id="attachments-title">Attachments</h2>
            <span>Files added here are included with the email.</span>
          </div>
          <div id="attachment-list" class="attachment-list" aria-live="polite">
            <p class="attachment-empty">No files attached</p>
          </div>
        </section>

        <footer class="composer-footer">
          <div class="actions">
            <button type="submit" id="send-btn">Send</button>
            <a href="/admin/emails" class="cancel-btn">Cancel</a>
          </div>
          <p id="status-message" class="status-message" role="status"></p>
        </footer>
      </form>
    </section>
  </main>
</AdminLayout>

<style>
  :global(.admin-main) {
    background: #f6f7f9;
  }

  .compose-shell {
    width: min(960px, 100%);
    margin: 0 auto;
    padding-bottom: 36px;
  }

  .compose-nav {
    min-height: 42px;
    display: flex;
    align-items: center;
    margin-bottom: 12px;
  }

  .back-link {
    min-height: 38px;
    display: inline-flex;
    align-items: center;
    padding: 0 11px;
    border-radius: 8px;
    color: #5f6b7d;
    font-size: 12px;
    font-weight: 750;
    text-decoration: none;
  }

  .back-link:hover {
    background: #eceff3;
    color: #263247;
  }

  .compose-heading {
    padding: 3px 4px 20px;
  }

  .eyebrow {
    margin: 0 0 6px;
    color: #a16207;
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .compose-heading h1 {
    margin: 0;
    color: #182235;
    font-size: clamp(25px, 3vw, 32px);
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .compose-heading > p:last-child {
    margin: 8px 0 0;
    color: #768195;
    font-size: 12.5px;
  }

  .composer-window {
    overflow: hidden;
    border: 1px solid #dce1e7;
    border-radius: 13px;
    background: #fff;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.045);
  }

  .address-field {
    min-height: 54px;
    display: grid;
    grid-template-columns: 68px minmax(0, 1fr);
    align-items: center;
    padding: 0 18px;
    border-bottom: 1px solid #edf0f3;
  }

  .address-field label {
    color: #7b8697;
    font-size: 12px;
    font-weight: 750;
  }

  .address-field input {
    width: 100%;
    min-width: 0;
    padding: 13px 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: #263247;
    font: inherit;
    font-size: 13.5px;
  }

  .address-field input::placeholder {
    color: #a1a8b3;
  }

  .address-field:focus-within {
    background: #fffdfa;
    box-shadow: inset 3px 0 0 #c89547;
  }

  .editor-surface {
    background: #fff;
  }

  .editor-toolbar {
    min-height: 49px;
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 7px 10px;
    border-bottom: 1px solid #e6e9ed;
    background: #fafbfc;
    overflow-x: auto;
  }

  .toolbar-group {
    display: flex;
    align-items: center;
    gap: 3px;
    flex: 0 0 auto;
  }

  .editor-toolbar button {
    min-height: 32px;
    min-width: 32px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 9px;
    border: 1px solid transparent;
    border-radius: 6px;
    background: transparent;
    color: #556174;
    cursor: pointer;
    font: inherit;
    font-size: 11.5px;
    font-weight: 700;
    white-space: nowrap;
    transition: background 120ms ease, border-color 120ms ease, color 120ms ease;
  }

  .editor-toolbar button:hover,
  .editor-toolbar button:focus-visible {
    border-color: #dde1e7;
    background: #fff;
    color: #273348;
  }

  .editor-toolbar button.active {
    border-color: #e4c999;
    background: #fff5e2;
    color: #855810;
  }

  .media-tools button {
    color: #855810;
  }

  .sep {
    width: 1px;
    height: 23px;
    flex: 0 0 auto;
    background: #dfe3e8;
  }

  .toolbar-spacer {
    min-width: 12px;
    flex: 1;
  }

  .editor {
    min-height: 330px;
    max-height: 58vh;
    overflow-y: auto;
    padding: 24px 28px;
    outline: 0;
    color: #303a4a;
    font-size: 14px;
    line-height: 1.72;
  }

  .editor:empty::before {
    content: attr(data-placeholder);
    color: #a3aab5;
    pointer-events: none;
  }

  .editor:focus {
    box-shadow: inset 3px 0 0 #c89547;
  }

  .editor h2 {
    margin: 20px 0 9px;
    color: #222e42;
    font-size: 20px;
    font-weight: 750;
  }

  .editor ul,
  .editor ol {
    margin: 9px 0;
    padding-left: 24px;
  }

  .editor li,
  .editor p {
    margin: 7px 0;
  }

  .editor img {
    display: block;
    max-width: min(100%, 720px);
    height: auto;
    margin: 16px 0;
    border: 1px solid #e1e5ea;
    border-radius: 9px;
    background: #f8f9fb;
  }

  .composer-feedback {
    min-height: 0;
    padding: 0 18px;
  }

  .image-status {
    min-height: 0;
    margin: 0;
    color: #657184;
    font-size: 11px;
  }

  .image-status:not(:empty) {
    padding: 9px 0 3px;
  }

  .image-status.error {
    color: #a23b3b;
  }

  .attachments-field {
    padding: 14px 18px 16px;
    border-top: 1px solid #edf0f3;
    background: #fbfcfd;
  }

  .attachments-title-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 9px;
  }

  .attachments-title-row h2 {
    margin: 0;
    color: #455165;
    font-size: 11.5px;
    font-weight: 800;
  }

  .attachments-title-row span {
    color: #8a94a4;
    font-size: 10.5px;
  }

  .attachment-list {
    display: grid;
    gap: 7px;
  }

  .attachment-empty {
    margin: 0;
    padding: 9px 11px;
    border: 1px dashed #d5dae1;
    border-radius: 7px;
    color: #8a94a4;
    font-size: 11px;
  }

  .attachment-item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    padding: 9px 10px;
    border: 1px solid #e1e5ea;
    border-radius: 8px;
    background: #fff;
  }

  .attachment-name {
    min-width: 0;
    overflow: hidden;
    color: #374358;
    font-size: 11.5px;
    font-weight: 750;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .attachment-size {
    margin-top: 2px;
    color: #8a94a4;
    font-size: 10px;
  }

  .attachment-remove {
    min-height: 30px;
    padding: 0 9px;
    border: 1px solid #e0e4e9;
    border-radius: 6px;
    background: #fafbfc;
    color: #687386;
    cursor: pointer;
    font: inherit;
    font-size: 10.5px;
    font-weight: 750;
  }

  .attachment-remove:hover {
    background: #f0f2f5;
    color: #364154;
  }

  .composer-footer {
    min-height: 68px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 16px 12px 18px;
    border-top: 1px solid #e3e6ea;
    background: #fff;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  #send-btn,
  .cancel-btn {
    min-height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 16px;
    border-radius: 8px;
    font: inherit;
    font-size: 12px;
    font-weight: 800;
    text-decoration: none;
  }

  #send-btn {
    min-width: 82px;
    border: 0;
    background: #b7791f;
    color: #fff;
    cursor: pointer;
    transition: background 140ms ease, transform 140ms ease;
  }

  #send-btn:hover:not(:disabled) {
    background: #996515;
    transform: translateY(-1px);
  }

  #send-btn:disabled {
    cursor: not-allowed;
    opacity: 0.55;
  }

  .cancel-btn {
    border: 1px solid #dce1e7;
    background: #fff;
    color: #657184;
  }

  .cancel-btn:hover {
    background: #f5f7f9;
    color: #364154;
  }

  .status-message {
    max-width: 480px;
    margin: 0;
    padding: 0;
    color: #687386;
    font-size: 11.5px;
    text-align: right;
  }

  .status-message:empty {
    display: none;
  }

  .status-message.success {
    color: #2f6b42;
  }

  .status-message.error {
    color: #a23b3b;
  }

  @media (max-width: 700px) {
    .compose-shell {
      width: 100%;
      min-width: 0;
      padding-bottom: calc(20px + env(safe-area-inset-bottom));
    }

    .compose-nav {
      min-height: 44px;
      margin-bottom: 8px;
    }

    .back-link {
      min-height: 44px;
    }

    .compose-heading {
      padding: 2px 2px 16px;
    }

    .composer-window {
      width: 100%;
      min-width: 0;
      border-radius: 10px;
    }

    .address-field {
      min-height: 0;
      grid-template-columns: 1fr;
      align-items: stretch;
      gap: 3px;
      padding: 10px 13px 4px;
    }

    .address-field label {
      font-size: 12px;
    }

    .address-field input {
      min-height: 44px;
      padding: 8px 0 10px;
      font-size: 16px;
    }

    .editor-toolbar {
      max-width: 100%;
      align-items: center;
      flex-wrap: nowrap;
      padding: 6px 7px;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scrollbar-width: thin;
    }

    .editor-toolbar button {
      min-width: 44px;
      min-height: 44px;
      padding: 0 10px;
    }

    .toolbar-spacer,
    .sep {
      display: none;
    }

    .history-tools {
      display: flex;
    }

    .editor {
      min-width: 0;
      min-height: 290px;
      max-height: none;
      padding: 18px 14px;
      font-size: 16px;
      overflow-wrap: anywhere;
    }

    .editor img {
      max-width: 100%;
      height: auto;
    }

    .composer-feedback,
    .attachments-field {
      padding-left: 14px;
      padding-right: 14px;
    }

    .attachments-title-row {
      align-items: flex-start;
      flex-direction: column;
      gap: 3px;
    }

    .attachment-item {
      min-width: 0;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 8px;
    }

    .attachment-name {
      white-space: normal;
      overflow-wrap: anywhere;
      word-break: break-word;
    }

    .attachment-remove {
      min-height: 44px;
      padding: 0 12px;
    }

    .composer-footer {
      align-items: stretch;
      flex-direction: column;
      gap: 10px;
      padding: 12px 14px calc(12px + env(safe-area-inset-bottom));
    }

    .actions {
      width: 100%;
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 8px;
    }

    #send-btn {
      min-height: 44px;
      width: 100%;
    }

    .cancel-btn {
      min-height: 44px;
    }

    .status-message {
      max-width: none;
      overflow-wrap: anywhere;
      text-align: left;
    }
  }
</style>

<script>
  const form = document.getElementById("send-form") as HTMLFormElement;
  const editorEl = document.getElementById("editor") as HTMLDivElement;
  const statusEl = document.getElementById("status-message") as HTMLParagraphElement;
  const sendBtn = document.getElementById("send-btn") as HTMLButtonElement;
  const imageInput = document.getElementById("email-image-input") as HTMLInputElement;
  const fileInput = document.getElementById("email-file-input") as HTMLInputElement;
  const imageStatusEl = document.getElementById("image-status") as HTMLParagraphElement;
  const attachmentListEl = document.getElementById("attachment-list") as HTMLDivElement;
  const inReplyToId = form?.dataset.inReplyToId ?? "";
  const sendRequestId = crypto.randomUUID();
  const allowedImageTypes = new Set(["image/jpeg", "image/png", "image/webp", "image/gif"]);
  const maxInlineImageSize = 8 * 1024 * 1024;
  const maxInlineImages = 5;
  const maxFileAttachmentSize = 20 * 1024 * 1024;
  const maxFileAttachments = 10;
  const maxTotalAttachmentSize = 30 * 1024 * 1024;
  const inlineImages: {
    id: string;
    filename: string;
    contentType: string;
    contentBase64: string;
    size: number;
  }[] = [];
  const fileAttachments: {
    id: string;
    filename: string;
    contentType: string;
    contentBase64: string;
    size: number;
  }[] = [];
  let savedEditorRange: Range | null = null;

  const setImageStatus = (message: string, isError = false) => {
    imageStatusEl.textContent = message;
    imageStatusEl.classList.toggle("error", isError);
  };

  const escapeAttribute = (value: string) => {
    return value
      .replace(/&/g, "&amp;")
      .replace(/"/g, "&quot;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;");
  };

  const formatFileSize = (size: number) => {
    if (size >= 1024 * 1024) return `${(size / (1024 * 1024)).toFixed(1)} MB`;
    if (size >= 1024) return `${Math.ceil(size / 1024)} KB`;
    return `${size} B`;
  };

  const getTotalAttachmentSize = () => {
    const inlineSize = inlineImages.reduce((total, image) => total + image.size, 0);
    const fileSize = fileAttachments.reduce((total, file) => total + file.size, 0);
    return inlineSize + fileSize;
  };

  const renderAttachmentList = () => {
    if (fileAttachments.length === 0) {
      attachmentListEl.innerHTML = '<p class="attachment-empty">No files attached</p>';
      return;
    }

    attachmentListEl.innerHTML = fileAttachments.map((file) => {
      return `
        <div class="attachment-item" data-attachment-id="${escapeAttribute(file.id)}">
          <div>
            <div class="attachment-name">${escapeAttribute(file.filename)}</div>
            <div class="attachment-size">${formatFileSize(file.size)}</div>
          </div>
          <button type="button" class="attachment-remove" data-remove-attachment="${escapeAttribute(file.id)}">Remove</button>
        </div>
      `;
    }).join("");
  };

  const saveEditorSelection = () => {
    const selection = window.getSelection();
    if (!selection || selection.rangeCount === 0) return;

    const range = selection.getRangeAt(0);
    if (editorEl.contains(range.commonAncestorContainer)) {
      savedEditorRange = range.cloneRange();
    }
  };

  const restoreEditorSelection = () => {
    if (!savedEditorRange) return;

    const selection = window.getSelection();
    if (!selection) return;

    selection.removeAllRanges();
    selection.addRange(savedEditorRange);
  };

  const fileToBase64 = async (file: File): Promise<string> => {
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.addEventListener("load", () => {
        const result = typeof reader.result === "string" ? reader.result : "";
        resolve(result.split(",")[1] ?? "");
      });
      reader.addEventListener("error", () => reject(new Error("Could not read image.")));
      reader.readAsDataURL(file);
    });
  };

  const insertHtmlAtSelection = (html: string) => {
    editorEl.focus();
    restoreEditorSelection();

    const selection = window.getSelection();
    if (!selection || selection.rangeCount === 0) {
      editorEl.insertAdjacentHTML("beforeend", html);
      saveEditorSelection();
      return;
    }

    const range = selection.getRangeAt(0);
    range.deleteContents();

    const template = document.createElement("template");
    template.innerHTML = html.trim();
    const fragment = template.content;
    const lastNode = fragment.lastChild;
    range.insertNode(fragment);

    if (lastNode) {
      range.setStartAfter(lastNode);
      range.collapse(true);
      selection.removeAllRanges();
      selection.addRange(range);
    }

    saveEditorSelection();
  };

  const buildEmailBodyHtml = () => {
    const clone = editorEl.cloneNode(true) as HTMLDivElement;
    clone.querySelectorAll("img[data-email-image-id]").forEach((image) => {
      const contentId = image.getAttribute("data-email-image-id") ?? "";
      if (!contentId) return;

      image.setAttribute("src", `cid:${contentId}`);
      image.setAttribute(
        "style",
        "max-width:100%;height:auto;display:block;margin:12px 0;border:0;"
      );
      image.removeAttribute("data-email-image-id");
    });

    return clone.innerHTML.trim();
  };

  editorEl?.addEventListener("keyup", saveEditorSelection);
  editorEl?.addEventListener("mouseup", saveEditorSelection);
  editorEl?.addEventListener("focus", saveEditorSelection);

  // Toolbar button handlers
  document.querySelectorAll("[data-cmd]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const cmd = btn.getAttribute("data-cmd");
      if (!cmd || !editorEl) return;

      editorEl.focus();

      switch (cmd) {
        case "bold":
          document.execCommand("bold", false);
          break;
        case "italic":
          document.execCommand("italic", false);
          break;
        case "underline":
          document.execCommand("underline", false);
          break;
        case "h2":
          document.execCommand("formatBlock", false, "h2");
          break;
        case "ul":
          document.execCommand("insertUnorderedList", false);
          break;
        case "ol":
          document.execCommand("insertOrderedList", false);
          break;
        case "image":
          saveEditorSelection();
          imageInput.click();
          break;
        case "attachment":
          fileInput.click();
          break;
        case "undo":
          document.execCommand("undo", false);
          break;
        case "redo":
          document.execCommand("redo", false);
          break;
      }
    });
  });

  attachmentListEl?.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement)) return;

    const attachmentId = target.dataset.removeAttachment;
    if (!attachmentId) return;

    const index = fileAttachments.findIndex((file) => file.id === attachmentId);
    if (index >= 0) {
      fileAttachments.splice(index, 1);
      renderAttachmentList();
      setImageStatus(`${fileAttachments.length} file${fileAttachments.length === 1 ? "" : "s"} attached.`);
    }
  });

  imageInput?.addEventListener("change", async () => {
    const files = Array.from(imageInput.files ?? []);
    imageInput.value = "";

    if (files.length === 0) return;
    if (inlineImages.length + files.length > maxInlineImages) {
      setImageStatus(`Maximum ${maxInlineImages} photos can be added to one email.`, true);
      return;
    }

    try {
      for (const file of files) {
        if (!allowedImageTypes.has(file.type)) {
          throw new Error("Only JPG, PNG, WebP and GIF photos are allowed.");
        }

        if (file.size > maxInlineImageSize) {
          throw new Error("Each photo must be 8MB or smaller.");
        }

        if (getTotalAttachmentSize() + file.size > maxTotalAttachmentSize) {
          throw new Error("Photos and attachments must be 30MB or smaller in total.");
        }

        const id = `email-image-${crypto.randomUUID()}`;
        const objectUrl = URL.createObjectURL(file);
        const contentBase64 = await fileToBase64(file);
        inlineImages.push({
          id,
          filename: file.name || "email-photo.jpg",
          contentType: file.type,
          contentBase64,
          size: file.size,
        });

        const safeName = escapeAttribute(file.name || "Email photo");
        insertHtmlAtSelection(
          `<p><img src="${objectUrl}" data-email-image-id="${id}" alt="${safeName}" style="max-width:100%;height:auto;display:block;margin:12px 0;border:1px solid #eee;border-radius:6px;" /></p><p><br></p>`
        );
      }

      setImageStatus(`${inlineImages.length} photo${inlineImages.length === 1 ? "" : "s"} ready to send.`);
    } catch (error) {
      const message = error instanceof Error ? error.message : "Could not add photo.";
      setImageStatus(message, true);
    }
  });

  fileInput?.addEventListener("change", async () => {
    const files = Array.from(fileInput.files ?? []);
    fileInput.value = "";

    if (files.length === 0) return;
    if (fileAttachments.length + files.length > maxFileAttachments) {
      setImageStatus(`Maximum ${maxFileAttachments} files can be attached to one email.`, true);
      return;
    }

    try {
      for (const file of files) {
        if (file.size > maxFileAttachmentSize) {
          throw new Error("Each attachment must be 20MB or smaller.");
        }

        if (getTotalAttachmentSize() + file.size > maxTotalAttachmentSize) {
          throw new Error("Photos and attachments must be 30MB or smaller in total.");
        }

        const contentBase64 = await fileToBase64(file);
        fileAttachments.push({
          id: `email-file-${crypto.randomUUID()}`,
          filename: file.name || "attachment",
          contentType: file.type || "application/octet-stream",
          contentBase64,
          size: file.size,
        });
      }

      renderAttachmentList();
      setImageStatus(`${fileAttachments.length} file${fileAttachments.length === 1 ? "" : "s"} attached.`);
    } catch (error) {
      const message = error instanceof Error ? error.message : "Could not attach file.";
      setImageStatus(message, true);
    }
  });

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();

    const to = (document.getElementById("to") as HTMLInputElement).value.trim();
    const subject = (document.getElementById("subject") as HTMLInputElement).value.trim();
    const liveInlineImageIds = new Set(
      Array.from(editorEl.querySelectorAll<HTMLImageElement>("img[data-email-image-id]"))
        .map((image) => image.dataset.emailImageId ?? "")
        .filter(Boolean)
    );
    const activeInlineImages = inlineImages.filter((image) => liveInlineImageIds.has(image.id));
    const body = buildEmailBodyHtml();

    if (!to || !subject) {
      statusEl.textContent = "To and subject are required.";
      statusEl.className = "status-message error";
      return;
    }

    if (!body || body === "<br>" || body === "<p></p>") {
      statusEl.textContent = "Message body is required.";
      statusEl.className = "status-message error";
      return;
    }

    sendBtn.disabled = true;
    sendBtn.textContent = "Sending...";
    statusEl.textContent = "";
    statusEl.className = "status-message";

    try {
      const response = await fetch("/api/admin/emails", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          to,
          subject,
          body,
          inReplyToId,
          requestId: sendRequestId,
          inlineImages: activeInlineImages,
          fileAttachments,
        }),
      });

      const data = await response.json();

      if (!response.ok) {
        throw new Error(data.error || "Failed to send email");
      }

      statusEl.textContent = "Email sent successfully.";
      statusEl.className = "status-message success";
      const sentId = typeof data.id === "string" ? data.id : "";
      window.location.href = sentId
        ? `/admin/emails/thread/sent/${encodeURIComponent(sentId)}`
        : "/admin/emails";
    } catch (err) {
      const message = err instanceof Error ? err.message : "Failed to send email";
      statusEl.textContent = message;
      statusEl.className = "status-message error";
      sendBtn.disabled = false;
      sendBtn.textContent = "Send";
    }
  });
</script>
