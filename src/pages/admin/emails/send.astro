---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { getRuntimeEnv } from "../../../lib/server/env";
import { isAuthenticated } from "../../../lib/server/session";

const env = getRuntimeEnv(Astro.locals);
const authenticated = await isAuthenticated(Astro.cookies, env.SESSION_SECRET);

if (!authenticated) {
  return Astro.redirect("/admin/login");
}

const replyTo = Astro.url.searchParams.get("replyTo") ?? "";
const subjectPrefill = Astro.url.searchParams.get("subject") ?? "";
const inReplyToId = Astro.url.searchParams.get("inReplyToId") ?? "";
---

<script define:vars={{ replyTo, subjectPrefill }}>
  window.addEventListener("DOMContentLoaded", () => {
    if (replyTo) {
      const toInput = document.getElementById("to");
      if (toInput) toInput.value = replyTo;
    }
    if (subjectPrefill) {
      const subjectInput = document.getElementById("subject");
      if (subjectInput) subjectInput.value = subjectPrefill;
    }
  });
</script>

<AdminLayout title="Compose Email" active="emails">
  <div class="page-header">
    <div class="header-left">
      <h1>Compose Email</h1>
      <p class="subtitle">Send an email to a recipient</p>
    </div>
  </div>

  <div class="form-card">
    <form id="send-form" data-in-reply-to-id={inReplyToId}>
      <div class="field">
        <label for="to">To</label>
        <input
          type="email"
          id="to"
          name="to"
          placeholder="recipient@example.com"
          required
          autocomplete="off"
        />
      </div>

      <div class="field">
        <label for="subject">Subject</label>
        <input
          type="text"
          id="subject"
          name="subject"
          placeholder="Email subject"
          required
          autocomplete="off"
        />
      </div>

      <div class="field">
        <label for="editor">Body</label>
        <div class="editor-toolbar">
          <button type="button" data-cmd="bold" title="Bold"><b>B</b></button>
          <button type="button" data-cmd="italic" title="Italic"><i>I</i></button>
          <button type="button" data-cmd="underline" title="Underline"><u>U</u></button>
          <span class="sep"></span>
          <button type="button" data-cmd="h2" title="Heading">H2</button>
          <button type="button" data-cmd="ul" title="Bullet List">&bull; List</button>
          <button type="button" data-cmd="ol" title="Numbered List">1. List</button>
          <span class="sep"></span>
          <button type="button" data-cmd="image" title="Add Photo">Photo</button>
          <button type="button" data-cmd="attachment" title="Attach File">Attach File</button>
          <input
            type="file"
            id="email-image-input"
            accept="image/jpeg,image/png,image/webp,image/gif"
            multiple
            hidden
          />
          <input type="file" id="email-file-input" multiple hidden />
          <span class="sep"></span>
          <button type="button" data-cmd="undo" title="Undo">&#8630;</button>
          <button type="button" data-cmd="redo" title="Redo">&#8631;</button>
        </div>
        <div
          id="editor"
          class="editor"
          contenteditable="true"
          data-placeholder="Write your message here..."
        ></div>
        <p id="image-status" class="image-status"></p>
      </div>

      <div class="field attachments-field">
        <label>Attachments</label>
        <div id="attachment-list" class="attachment-list" aria-live="polite">
          <p class="attachment-empty">No files attached</p>
        </div>
      </div>

      <div class="actions">
        <a href="/admin/emails" class="cancel-btn">Cancel</a>
        <button type="submit" id="send-btn">Send Email</button>
      </div>

      <p id="status-message" class="status-message"></p>
    </form>
  </div>
</AdminLayout>

<style>
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 24px;
    gap: 20px;
  }
  .header-left h1 {
    font-size: 28px;
    margin: 0 0 5px;
  }
  .subtitle {
    color: #666;
    margin: 0;
  }

  .form-card {
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.04);
    padding: 32px;
    max-width: 700px;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 20px;
  }

  .field label {
    font-weight: 600;
    font-size: 14px;
    color: #333;
  }

  .field input,
  .field textarea {
    border: 1px solid #ddd;
    border-radius: 8px;
    padding: 12px 14px;
    font-size: 14px;
    font-family: inherit;
    outline: none;
    transition: border-color 0.15s;
    box-sizing: border-box;
  }

  .field input:focus,
  .field textarea:focus {
    border-color: #c78f40;
  }

  .editor-toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    padding: 8px;
    background: #f8f8f8;
    border: 1px solid #ddd;
    border-bottom: none;
    border-radius: 8px 8px 0 0;
  }

  .editor-toolbar button {
    padding: 6px 12px;
    border: 1px solid #ddd;
    background: #fff;
    border-radius: 4px;
    cursor: pointer;
    font-size: 13px;
    min-width: 32px;
    transition: all 0.15s;
  }

  .editor-toolbar button:hover {
    background: #eee;
    border-color: #ccc;
  }

  .editor-toolbar button.active {
    background: #c78f40;
    color: #111;
    border-color: #c78f40;
  }

  .sep {
    width: 1px;
    height: 24px;
    background: #ddd;
    margin: 0 4px;
    align-self: center;
  }

  .editor {
    border: 1px solid #ddd;
    border-radius: 0 0 8px 8px;
    padding: 16px;
    min-height: 200px;
    max-height: 400px;
    overflow-y: auto;
    font-size: 14px;
    line-height: 1.6;
    color: #333;
    outline: none;
  }

  .editor:empty::before {
    content: attr(data-placeholder);
    color: #aaa;
    pointer-events: none;
  }

  .editor:focus {
    border-color: #c78f40;
    box-shadow: inset 0 0 0 2px rgba(199, 143, 64, 0.2);
  }

  .editor h2 {
    font-size: 20px;
    margin: 16px 0 8px;
    font-weight: 600;
  }

  .editor ul,
  .editor ol {
    padding-left: 24px;
    margin: 8px 0;
  }

  .editor li {
    margin: 4px 0;
  }

  .editor p {
    margin: 8px 0;
  }

  .editor img {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 12px 0;
    border: 1px solid #eee;
    border-radius: 6px;
  }

  .image-status {
    margin: 8px 0 0;
    color: #666;
    font-size: 13px;
    min-height: 18px;
  }

  .image-status.error {
    color: #721c24;
  }

  .attachments-field {
    margin-top: -4px;
  }

  .attachment-list {
    display: grid;
    gap: 8px;
    border: 1px solid #eee;
    border-radius: 8px;
    padding: 10px;
    background: #fafafa;
  }

  .attachment-empty {
    margin: 0;
    color: #777;
    font-size: 13px;
  }

  .attachment-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    background: #fff;
    border: 1px solid #e5e5e5;
    border-radius: 6px;
    padding: 8px 10px;
  }

  .attachment-name {
    min-width: 0;
    color: #333;
    font-size: 13px;
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .attachment-size {
    color: #777;
    font-size: 12px;
    white-space: nowrap;
  }

  .attachment-remove {
    border: none;
    background: #f0f0f0;
    color: #333;
    border-radius: 4px;
    padding: 6px 8px;
    cursor: pointer;
    font-size: 12px;
    font-weight: 700;
  }

  .attachment-remove:hover {
    background: #e0e0e0;
  }

  .actions {
    display: flex;
    gap: 12px;
    margin-top: 8px;
  }

  .cancel-btn {
    background: #f0f0f0;
    color: #333;
    padding: 12px 20px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    font-size: 14px;
    display: inline-flex;
    align-items: center;
    transition: background 0.15s;
  }

  .cancel-btn:hover {
    background: #e0e0e0;
  }

  #send-btn {
    background: #c78f40;
    color: #111;
    padding: 12px 24px;
    border-radius: 8px;
    border: none;
    font-weight: 700;
    font-size: 14px;
    cursor: pointer;
    transition: background 0.15s;
  }

  #send-btn:hover:not(:disabled) {
    background: #b07d35;
  }

  #send-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .status-message {
    margin: 16px 0 0;
    padding: 12px 16px;
    border-radius: 8px;
    font-size: 14px;
    display: none;
  }

  .status-message.success {
    display: block;
    background: #d4edda;
    color: #155724;
    border: 1px solid #c3e6cb;
  }

  .status-message.error {
    display: block;
    background: #f8d7da;
    color: #721c24;
    border: 1px solid #f5c6cb;
  }
</style>

<script>
  const form = document.getElementById("send-form") as HTMLFormElement;
  const editorEl = document.getElementById("editor") as HTMLDivElement;
  const statusEl = document.getElementById("status-message") as HTMLParagraphElement;
  const sendBtn = document.getElementById("send-btn") as HTMLButtonElement;
  const imageInput = document.getElementById("email-image-input") as HTMLInputElement;
  const fileInput = document.getElementById("email-file-input") as HTMLInputElement;
  const imageStatusEl = document.getElementById("image-status") as HTMLParagraphElement;
  const attachmentListEl = document.getElementById("attachment-list") as HTMLDivElement;
  const inReplyToId = form?.dataset.inReplyToId ?? "";
  const sendRequestId = crypto.randomUUID();
  const allowedImageTypes = new Set(["image/jpeg", "image/png", "image/webp", "image/gif"]);
  const maxInlineImageSize = 8 * 1024 * 1024;
  const maxInlineImages = 5;
  const maxFileAttachmentSize = 20 * 1024 * 1024;
  const maxFileAttachments = 10;
  const maxTotalAttachmentSize = 30 * 1024 * 1024;
  const inlineImages: {
    id: string;
    filename: string;
    contentType: string;
    contentBase64: string;
    size: number;
  }[] = [];
  const fileAttachments: {
    id: string;
    filename: string;
    contentType: string;
    contentBase64: string;
    size: number;
  }[] = [];
  let savedEditorRange: Range | null = null;

  const setImageStatus = (message: string, isError = false) => {
    imageStatusEl.textContent = message;
    imageStatusEl.classList.toggle("error", isError);
  };

  const escapeAttribute = (value: string) => {
    return value
      .replace(/&/g, "&amp;")
      .replace(/"/g, "&quot;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;");
  };

  const formatFileSize = (size: number) => {
    if (size >= 1024 * 1024) return `${(size / (1024 * 1024)).toFixed(1)} MB`;
    if (size >= 1024) return `${Math.ceil(size / 1024)} KB`;
    return `${size} B`;
  };

  const getTotalAttachmentSize = () => {
    const inlineSize = inlineImages.reduce((total, image) => total + image.size, 0);
    const fileSize = fileAttachments.reduce((total, file) => total + file.size, 0);
    return inlineSize + fileSize;
  };

  const renderAttachmentList = () => {
    if (fileAttachments.length === 0) {
      attachmentListEl.innerHTML = '<p class="attachment-empty">No files attached</p>';
      return;
    }

    attachmentListEl.innerHTML = fileAttachments.map((file) => {
      return `
        <div class="attachment-item" data-attachment-id="${escapeAttribute(file.id)}">
          <div>
            <div class="attachment-name">${escapeAttribute(file.filename)}</div>
            <div class="attachment-size">${formatFileSize(file.size)}</div>
          </div>
          <button type="button" class="attachment-remove" data-remove-attachment="${escapeAttribute(file.id)}">Remove</button>
        </div>
      `;
    }).join("");
  };

  const saveEditorSelection = () => {
    const selection = window.getSelection();
    if (!selection || selection.rangeCount === 0) return;

    const range = selection.getRangeAt(0);
    if (editorEl.contains(range.commonAncestorContainer)) {
      savedEditorRange = range.cloneRange();
    }
  };

  const restoreEditorSelection = () => {
    if (!savedEditorRange) return;

    const selection = window.getSelection();
    if (!selection) return;

    selection.removeAllRanges();
    selection.addRange(savedEditorRange);
  };

  const fileToBase64 = async (file: File): Promise<string> => {
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.addEventListener("load", () => {
        const result = typeof reader.result === "string" ? reader.result : "";
        resolve(result.split(",")[1] ?? "");
      });
      reader.addEventListener("error", () => reject(new Error("Could not read image.")));
      reader.readAsDataURL(file);
    });
  };

  const insertHtmlAtSelection = (html: string) => {
    editorEl.focus();
    restoreEditorSelection();

    const selection = window.getSelection();
    if (!selection || selection.rangeCount === 0) {
      editorEl.insertAdjacentHTML("beforeend", html);
      saveEditorSelection();
      return;
    }

    const range = selection.getRangeAt(0);
    range.deleteContents();

    const template = document.createElement("template");
    template.innerHTML = html.trim();
    const fragment = template.content;
    const lastNode = fragment.lastChild;
    range.insertNode(fragment);

    if (lastNode) {
      range.setStartAfter(lastNode);
      range.collapse(true);
      selection.removeAllRanges();
      selection.addRange(range);
    }

    saveEditorSelection();
  };

  const buildEmailBodyHtml = () => {
    const clone = editorEl.cloneNode(true) as HTMLDivElement;
    clone.querySelectorAll("img[data-email-image-id]").forEach((image) => {
      const contentId = image.getAttribute("data-email-image-id") ?? "";
      if (!contentId) return;

      image.setAttribute("src", `cid:${contentId}`);
      image.setAttribute(
        "style",
        "max-width:100%;height:auto;display:block;margin:12px 0;border:0;"
      );
      image.removeAttribute("data-email-image-id");
    });

    return clone.innerHTML.trim();
  };

  editorEl?.addEventListener("keyup", saveEditorSelection);
  editorEl?.addEventListener("mouseup", saveEditorSelection);
  editorEl?.addEventListener("focus", saveEditorSelection);

  // Toolbar button handlers
  document.querySelectorAll("[data-cmd]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const cmd = btn.getAttribute("data-cmd");
      if (!cmd || !editorEl) return;

      editorEl.focus();

      switch (cmd) {
        case "bold":
          document.execCommand("bold", false);
          break;
        case "italic":
          document.execCommand("italic", false);
          break;
        case "underline":
          document.execCommand("underline", false);
          break;
        case "h2":
          document.execCommand("formatBlock", false, "h2");
          break;
        case "ul":
          document.execCommand("insertUnorderedList", false);
          break;
        case "ol":
          document.execCommand("insertOrderedList", false);
          break;
        case "image":
          saveEditorSelection();
          imageInput.click();
          break;
        case "attachment":
          fileInput.click();
          break;
        case "undo":
          document.execCommand("undo", false);
          break;
        case "redo":
          document.execCommand("redo", false);
          break;
      }
    });
  });

  attachmentListEl?.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement)) return;

    const attachmentId = target.dataset.removeAttachment;
    if (!attachmentId) return;

    const index = fileAttachments.findIndex((file) => file.id === attachmentId);
    if (index >= 0) {
      fileAttachments.splice(index, 1);
      renderAttachmentList();
      setImageStatus(`${fileAttachments.length} file${fileAttachments.length === 1 ? "" : "s"} attached.`);
    }
  });

  imageInput?.addEventListener("change", async () => {
    const files = Array.from(imageInput.files ?? []);
    imageInput.value = "";

    if (files.length === 0) return;
    if (inlineImages.length + files.length > maxInlineImages) {
      setImageStatus(`Maximum ${maxInlineImages} photos can be added to one email.`, true);
      return;
    }

    try {
      for (const file of files) {
        if (!allowedImageTypes.has(file.type)) {
          throw new Error("Only JPG, PNG, WebP and GIF photos are allowed.");
        }

        if (file.size > maxInlineImageSize) {
          throw new Error("Each photo must be 8MB or smaller.");
        }

        if (getTotalAttachmentSize() + file.size > maxTotalAttachmentSize) {
          throw new Error("Photos and attachments must be 30MB or smaller in total.");
        }

        const id = `email-image-${crypto.randomUUID()}`;
        const objectUrl = URL.createObjectURL(file);
        const contentBase64 = await fileToBase64(file);
        inlineImages.push({
          id,
          filename: file.name || "email-photo.jpg",
          contentType: file.type,
          contentBase64,
          size: file.size,
        });

        const safeName = escapeAttribute(file.name || "Email photo");
        insertHtmlAtSelection(
          `<p><img src="${objectUrl}" data-email-image-id="${id}" alt="${safeName}" style="max-width:100%;height:auto;display:block;margin:12px 0;border:1px solid #eee;border-radius:6px;" /></p><p><br></p>`
        );
      }

      setImageStatus(`${inlineImages.length} photo${inlineImages.length === 1 ? "" : "s"} ready to send.`);
    } catch (error) {
      const message = error instanceof Error ? error.message : "Could not add photo.";
      setImageStatus(message, true);
    }
  });

  fileInput?.addEventListener("change", async () => {
    const files = Array.from(fileInput.files ?? []);
    fileInput.value = "";

    if (files.length === 0) return;
    if (fileAttachments.length + files.length > maxFileAttachments) {
      setImageStatus(`Maximum ${maxFileAttachments} files can be attached to one email.`, true);
      return;
    }

    try {
      for (const file of files) {
        if (file.size > maxFileAttachmentSize) {
          throw new Error("Each attachment must be 20MB or smaller.");
        }

        if (getTotalAttachmentSize() + file.size > maxTotalAttachmentSize) {
          throw new Error("Photos and attachments must be 30MB or smaller in total.");
        }

        const contentBase64 = await fileToBase64(file);
        fileAttachments.push({
          id: `email-file-${crypto.randomUUID()}`,
          filename: file.name || "attachment",
          contentType: file.type || "application/octet-stream",
          contentBase64,
          size: file.size,
        });
      }

      renderAttachmentList();
      setImageStatus(`${fileAttachments.length} file${fileAttachments.length === 1 ? "" : "s"} attached.`);
    } catch (error) {
      const message = error instanceof Error ? error.message : "Could not attach file.";
      setImageStatus(message, true);
    }
  });

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();

    const to = (document.getElementById("to") as HTMLInputElement).value.trim();
    const subject = (document.getElementById("subject") as HTMLInputElement).value.trim();
    const body = buildEmailBodyHtml();

    if (!to || !subject) {
      statusEl.textContent = "To and subject are required.";
      statusEl.className = "status-message error";
      return;
    }

    if (!body || body === "<br>" || body === "<p></p>") {
      statusEl.textContent = "Message body is required.";
      statusEl.className = "status-message error";
      return;
    }

    sendBtn.disabled = true;
    sendBtn.textContent = "Sending...";
    statusEl.textContent = "";
    statusEl.className = "status-message";

    try {
      const response = await fetch("/api/admin/emails", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          to,
          subject,
          body,
          inReplyToId,
          requestId: sendRequestId,
          inlineImages,
          fileAttachments,
        }),
      });

      const data = await response.json();

      if (!response.ok) {
        throw new Error(data.error || "Failed to send email");
      }

      statusEl.textContent = "Email sent successfully! Redirecting...";
      statusEl.className = "status-message success";

      setTimeout(() => {
        window.location.href = "/admin/emails";
      }, 1000);
    } catch (err) {
      const message = err instanceof Error ? err.message : "Failed to send email";
      statusEl.textContent = message;
      statusEl.className = "status-message error";
      sendBtn.disabled = false;
      sendBtn.textContent = "Send Email";
    }
  });
</script>
