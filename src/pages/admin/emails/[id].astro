---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { getRuntimeEnv } from "../../../lib/server/env";
import { isAuthenticated } from "../../../lib/server/session";

const env = getRuntimeEnv(Astro.locals);
const authenticated = await isAuthenticated(Astro.cookies, env.SESSION_SECRET);

if (!authenticated) {
  return Astro.redirect("/admin/login");
}

const { id } = Astro.params;

const apiRes = await fetch(`${Astro.url.origin}/api/admin/emails/${id}`);
if (apiRes.status === 404) {
  return Astro.redirect("/admin/emails");
}

if (!apiRes.ok) {
  return Astro.redirect("/admin/emails");
}

const email = await apiRes.json();
---

<AdminLayout title="Email Details" active="emails">
  <div class="email-details">
    <a href="/admin/emails" class="back-link">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M19 12H5M12 19l-7-7 7-7"/>
      </svg>
      Back to Emails
    </a>

    <div class="email-meta">
      <div class="meta-row">
        <span class="meta-label">From</span>
        <span class="meta-value from-address">{email.from_address}</span>
      </div>
      <div class="meta-row">
        <span class="meta-label">To</span>
        <span class="meta-value to-address">{email.to_address}</span>
      </div>
      <div class="meta-row">
        <span class="meta-label">Date</span>
        <span class="meta-value date-value">
          {new Date(email.created_at).toLocaleDateString("en-US", {
            year: "numeric",
            month: "long",
            day: "numeric",
            hour: "2-digit",
            minute: "2-digit"
          })}
        </span>
      </div>
      <div class="meta-row">
        <span class="meta-label">Subject</span>
        <span class="meta-value subject-value">{email.subject}</span>
      </div>
    </div>

    <div class="email-body">
      <h2 class="body-label">Message</h2>
      <div class="body-content">{email.body}</div>
    </div>
  </div>
</AdminLayout>

<style>
  .email-details {
    max-width: 800px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #666;
    text-decoration: none;
    font-size: 14px;
    margin-bottom: 24px;
    transition: color 0.15s;
  }
  .back-link:hover {
    color: #c78f40;
  }
  .back-link svg {
    flex-shrink: 0;
  }

  .email-meta {
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.04);
    padding: 24px;
    margin-bottom: 20px;
  }

  .meta-row {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 16px;
    padding: 12px 0;
    border-bottom: 1px solid #eee;
  }
  .meta-row:last-child {
    border-bottom: none;
  }

  .meta-label {
    font-weight: 600;
    font-size: 13px;
    color: #888;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .meta-value {
    color: #333;
    font-size: 14px;
    word-break: break-all;
  }

  .from-address {
    color: #555;
  }

  .to-address {
    color: #c0392b;
  }

  .date-value {
    color: #666;
  }

  .subject-value {
    font-weight: 500;
  }

  .email-body {
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.04);
    padding: 24px;
  }

  .body-label {
    font-size: 13px;
    font-weight: 600;
    color: #888;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin: 0 0 16px;
  }

  .body-content {
    color: #444;
    line-height: 1.7;
    white-space: pre-wrap;
    font-size: 15px;
  }

  @media (max-width: 600px) {
    .meta-row {
      grid-template-columns: 1fr;
      gap: 4px;
    }
    .meta-label {
      margin-bottom: 2px;
    }
  }
</style>
