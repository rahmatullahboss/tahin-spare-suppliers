---
import AdminLayout from "../../../../../layouts/AdminLayout.astro";
import { getRuntimeEnv } from "../../../../../lib/server/env";
import { getDb } from "../../../../../lib/server/db";
import { isAuthenticated } from "../../../../../lib/server/session";
import {
  extractEmailAddress,
  makeReplySubject,
  normalizeEmailSubject,
} from "../../../../../lib/server/email-thread";
import {
  isSafeInlineImageContentType,
  parseInboundAttachments,
  plainTextEmailToHtml,
  sanitizeEmailHtml,
  type InboundEmailAttachment,
} from "../../../../../lib/server/email-content";
import { parseStoredSentAttachments } from "../../../../../lib/server/sent-email-attachments";

type EmailSource = "inbound" | "sent";
type DbRow = Record<string, unknown>;
type ThreadMessage = {
  id: string;
  source: EmailSource;
  from: string;
  to: string;
  subject: string;
  body: string;
  safeBody: string;
  attachments: InboundEmailAttachment[];
  createdAt: string;
  inReplyToInboundId: string;
};

const env = getRuntimeEnv(Astro.locals);
const authenticated = await isAuthenticated(Astro.cookies, env.SESSION_SECRET);

if (!authenticated) {
  return Astro.redirect("/admin/login");
}

const source = Astro.params.source === "sent" ? "sent" : "inbound";
const { id } = Astro.params;
const sql = getDb(env);

function asString(value: unknown): string {
  if (value == null) return "";
  if (typeof value === "string") return value;
  if (value instanceof Date) return value.toISOString();
  return String(value);
}

function toMessage(row: DbRow, messageSource: EmailSource): ThreadMessage {
  const id = asString(row.id);
  const body = asString(row.body);
  const htmlBody = asString(row.html_body);
  const attachments = messageSource === "inbound"
    ? parseInboundAttachments(row.attachments_json)
    : parseStoredSentAttachments(row.attachments_json);
  const safeBody = messageSource === "inbound"
    ? htmlBody
      ? sanitizeEmailHtml(htmlBody, attachments, id, "inbound")
      : plainTextEmailToHtml(body)
    : sanitizeEmailHtml(body, attachments, id, "sent");

  return {
    id,
    source: messageSource,
    from: asString(row.from_address),
    to: asString(row.to_address),
    subject: asString(row.subject),
    body,
    safeBody,
    attachments,
    createdAt: asString(row.created_at),
    inReplyToInboundId: asString(row.in_reply_to_inbound_id),
  };
}

const anchorResult = source === "inbound"
  ? await sql.query(
      `SELECT id, from_address, to_address, subject, body, html_body, attachments_json,
              created_at, '' as in_reply_to_inbound_id
       FROM inbound_emails WHERE id = $1`,
      [id]
    )
  : await sql.query(
      `SELECT id, from_address, to_address, subject, body, '' as html_body,
              attachments_json, created_at, in_reply_to_inbound_id
       FROM sent_emails WHERE id = $1`,
      [id]
    );

if (anchorResult.length === 0) {
  return Astro.redirect("/admin/emails");
}

const anchor = toMessage(anchorResult[0] as DbRow, source);
const customerEmail = extractEmailAddress(source === "inbound" ? anchor.from : anchor.to);
const subjectKey = normalizeEmailSubject(anchor.subject);

const [inboundRows, sentRows] = await Promise.all([
  sql.query(
    `SELECT id, from_address, to_address, subject, body, html_body, attachments_json,
            created_at, '' as in_reply_to_inbound_id
     FROM inbound_emails
     ORDER BY created_at DESC
     LIMIT 500`
  ),
  sql.query(
    `SELECT id, from_address, to_address, subject, body, '' as html_body,
            attachments_json, created_at, in_reply_to_inbound_id
     FROM sent_emails
     ORDER BY created_at DESC
     LIMIT 500`
  ),
]);

const inboundMessages = (inboundRows as DbRow[])
  .map((row) => toMessage(row, "inbound"))
  .filter((message) => {
    return extractEmailAddress(message.from) === customerEmail
      && normalizeEmailSubject(message.subject) === subjectKey;
  });

const inboundIds = new Set(inboundMessages.map((message) => message.id));

const sentMessages = (sentRows as DbRow[])
  .map((row) => toMessage(row, "sent"))
  .filter((message) => {
    const sameCustomer = extractEmailAddress(message.to) === customerEmail
      && normalizeEmailSubject(message.subject) === subjectKey;
    const linkedReply = message.inReplyToInboundId
      ? inboundIds.has(message.inReplyToInboundId) || message.inReplyToInboundId === anchor.id
      : false;
    return sameCustomer || linkedReply;
  });

const thread = [...inboundMessages, ...sentMessages].sort((a, b) => {
  return new Date(a.createdAt).getTime() - new Date(b.createdAt).getTime();
});

const latestInbound = [...inboundMessages].sort((a, b) => {
  return new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime();
})[0];

if (inboundIds.size > 0) {
  await Promise.all(
    [...inboundIds].map((inboundId) => {
      return sql.query(`UPDATE inbound_emails SET is_read = true WHERE id = $1`, [inboundId]);
    })
  );
}

const displaySubject = anchor.subject || "(No subject)";
const replySubject = makeReplySubject(anchor.subject);
const replyTo = customerEmail;
const inReplyToId = latestInbound?.id ?? "";
const replyHref = `/admin/emails/send?replyTo=${encodeURIComponent(replyTo)}&subject=${encodeURIComponent(replySubject)}&inReplyToId=${encodeURIComponent(inReplyToId)}`;

function getAttachmentUrl(
  messageSource: EmailSource,
  messageId: string,
  attachmentId: string
): string {
  return `/api/admin/emails/${messageSource}/${encodeURIComponent(messageId)}/attachments/${encodeURIComponent(attachmentId)}`;
}

function displayName(address: string): string {
  const match = address.match(/^\s*"?([^"<]+?)"?\s*<([^>]+)>\s*$/);
  if (match) return match[1].trim() || match[2].trim();
  return extractEmailAddress(address) || address || "Unknown sender";
}

function avatarInitial(address: string): string {
  const name = displayName(address).trim();
  return (name.charAt(0) || "?").toUpperCase();
}

function formatTimestamp(value: string): string {
  if (!value) return "Unknown date";
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return "Unknown date";
  return date.toLocaleString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
    hour: "numeric",
    minute: "2-digit",
  });
}
---

<AdminLayout title="Email Conversation" active="emails">
  <main class="conversation-page">
    <nav class="conversation-toolbar" aria-label="Conversation actions">
      <a href="/admin/emails" class="back-link">Back to inbox</a>
      <a class="top-reply-btn" href={replyHref}>Reply</a>
    </nav>

    <header class="conversation-heading">
      <p class="eyebrow">Conversation</p>
      <div class="conversation-title-row">
        <div class="conversation-title-copy">
          <h1>{displaySubject}</h1>
          <p>
            <span>{customerEmail || "Unknown contact"}</span>
            <span aria-hidden="true">·</span>
            <span>{thread.length} message{thread.length === 1 ? "" : "s"}</span>
          </p>
        </div>
      </div>
    </header>

    <section class="message-stack" aria-label="Email messages">
      {thread.map((message) => (
        <article class:list={["message-card", message.source]}>
          <header class="message-summary">
            <div class:list={["message-avatar", message.source]} aria-hidden="true">
              {message.source === "sent" ? "T" : avatarInitial(message.from)}
            </div>

            <div class="message-identity">
              <div class="sender-line">
                <strong>
                  {message.source === "sent" ? "Tahin Spare Suppliers" : displayName(message.from)}
                </strong>
                <span class="direction-label">
                  {message.source === "sent" ? "Sent" : "Received"}
                </span>
              </div>

              <details class="message-details">
                <summary>
                  to {message.source === "sent" ? displayName(message.to) : "Tahin Spare Suppliers"}
                </summary>
                <dl>
                  <div>
                    <dt>From</dt>
                    <dd>{message.from}</dd>
                  </div>
                  <div>
                    <dt>To</dt>
                    <dd>{message.to}</dd>
                  </div>
                  <div>
                    <dt>Subject</dt>
                    <dd>{message.subject || "(No subject)"}</dd>
                  </div>
                </dl>
              </details>
            </div>

            <time datetime={message.createdAt}>{formatTimestamp(message.createdAt)}</time>
          </header>

          <div class="message-body" set:html={message.safeBody || "<p>(Empty message)</p>"} />

          {message.attachments.length > 0 && (
            <section class="attachments" aria-label="Attachments">
              <div class="attachments-heading">
                <h2>Attachments</h2>
                <span>{message.attachments.length}</span>
              </div>
              <div class="attachment-grid">
                {message.attachments.map((attachment) => {
                  const attachmentUrl = getAttachmentUrl(message.source, message.id, attachment.id);
                  const previewable = isSafeInlineImageContentType(attachment.contentType);
                  return (
                    <article class="attachment-item">
                      {previewable ? (
                        <a
                          class="attachment-preview"
                          href={attachmentUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                          aria-label={`Open ${attachment.filename}`}
                        >
                          <img
                            src={attachmentUrl}
                            alt={attachment.filename}
                            loading="lazy"
                          />
                        </a>
                      ) : (
                        <div class="file-placeholder" aria-hidden="true">
                          <span>FILE</span>
                        </div>
                      )}
                      <div class="attachment-info">
                        <span title={attachment.filename}>{attachment.filename}</span>
                        <a
                          href={`${attachmentUrl}?download=1`}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          Download
                        </a>
                      </div>
                    </article>
                  );
                })}
              </div>
            </section>
          )}
        </article>
      ))}
    </section>

    <div class="reply-dock">
      <div>
        <strong>Reply to {customerEmail || "this contact"}</strong>
        <span>Your reply stays linked to this conversation.</span>
      </div>
      <a href={replyHref} class="reply-btn">Reply</a>
    </div>
  </main>
</AdminLayout>

<style>
  :global(.admin-main) {
    background: #f6f7f9;
  }

  .conversation-page {
    width: min(960px, 100%);
    margin: 0 auto;
    padding-bottom: 36px;
  }

  .conversation-toolbar {
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 16px;
  }

  .back-link {
    min-height: 38px;
    display: inline-flex;
    align-items: center;
    padding: 0 11px;
    border-radius: 8px;
    color: #5f6b7d;
    font-size: 12px;
    font-weight: 750;
    text-decoration: none;
  }

  .back-link:hover {
    background: #eceff3;
    color: #263247;
  }

  .top-reply-btn,
  .reply-btn {
    min-height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 16px;
    border-radius: 9px;
    background: #b7791f;
    color: #fff;
    font-size: 13px;
    font-weight: 800;
    text-decoration: none;
    transition: background 150ms ease, transform 150ms ease;
  }

  .top-reply-btn:hover,
  .reply-btn:hover {
    background: #996515;
    transform: translateY(-1px);
  }

  .conversation-heading {
    padding: 6px 6px 22px;
  }

  .eyebrow {
    margin: 0 0 6px;
    color: #a16207;
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .conversation-title-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
  }

  .conversation-title-copy {
    min-width: 0;
  }

  .conversation-heading h1 {
    margin: 0;
    overflow-wrap: anywhere;
    color: #182235;
    font-size: clamp(24px, 3vw, 32px);
    line-height: 1.2;
    letter-spacing: -0.025em;
  }

  .conversation-heading p:last-child {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin: 9px 0 0;
    color: #758094;
    font-size: 12.5px;
  }

  .message-stack {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .message-card {
    overflow: hidden;
    border: 1px solid #dde2e8;
    border-radius: 12px;
    background: #fff;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.035);
  }

  .message-card.sent {
    border-color: #e4dccd;
  }

  .message-summary {
    display: grid;
    grid-template-columns: 38px minmax(0, 1fr) auto;
    align-items: start;
    gap: 12px;
    padding: 16px 18px 13px;
    border-bottom: 1px solid #edf0f3;
  }

  .message-avatar {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: #eef1f5;
    color: #435064;
    font-size: 13px;
    font-weight: 850;
  }

  .message-avatar.sent {
    background: #fff0d7;
    color: #8a5a12;
  }

  .message-identity {
    min-width: 0;
  }

  .sender-line {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .sender-line strong {
    overflow: hidden;
    color: #1f2937;
    font-size: 13.5px;
    font-weight: 800;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .direction-label {
    padding: 2px 6px;
    border-radius: 999px;
    background: #f0f2f5;
    color: #748094;
    font-size: 9.5px;
    font-weight: 800;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .message-card.sent .direction-label {
    background: #fff6e7;
    color: #8a5a12;
  }

  .message-details {
    margin-top: 4px;
    color: #7a8494;
    font-size: 11.5px;
  }

  .message-details summary {
    width: fit-content;
    max-width: 100%;
    overflow: hidden;
    cursor: pointer;
    list-style: none;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .message-details summary::-webkit-details-marker {
    display: none;
  }

  .message-details summary::after {
    content: " details";
    color: #9aa2ae;
    font-size: 10px;
  }

  .message-details dl {
    display: grid;
    gap: 5px;
    margin: 10px 0 0;
    padding: 10px 12px;
    border: 1px solid #e7e9ed;
    border-radius: 8px;
    background: #fafbfc;
  }

  .message-details dl div {
    display: grid;
    grid-template-columns: 54px minmax(0, 1fr);
    gap: 8px;
  }

  .message-details dt {
    color: #8a94a4;
    font-weight: 700;
  }

  .message-details dd {
    margin: 0;
    overflow-wrap: anywhere;
    color: #4b576a;
  }

  time {
    padding-top: 2px;
    color: #8a94a4;
    font-size: 11px;
    white-space: nowrap;
  }

  .message-body {
    padding: 22px 24px 24px 68px;
    overflow-wrap: anywhere;
    color: #303a4a;
    font-size: 14px;
    line-height: 1.72;
  }

  .message-body :global(p:first-child) {
    margin-top: 0;
  }

  .message-body :global(p:last-child) {
    margin-bottom: 0;
  }

  .message-body :global(a) {
    color: #8a5a12;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .message-body :global(img) {
    display: block;
    max-width: min(100%, 720px);
    height: auto;
    margin: 16px 0;
    border: 1px solid #e4e7eb;
    border-radius: 9px;
    background: #f8f9fa;
    cursor: zoom-in;
  }

  .message-body :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
  }

  .message-body :global(td),
  .message-body :global(th) {
    padding: 7px 9px;
    border: 1px solid #dfe3e8;
  }

  .attachments {
    padding: 0 24px 22px 68px;
  }

  .attachments-heading {
    display: flex;
    align-items: center;
    gap: 7px;
    margin-bottom: 10px;
  }

  .attachments-heading h2 {
    margin: 0;
    color: #4a5568;
    font-size: 12px;
    font-weight: 800;
  }

  .attachments-heading span {
    min-width: 19px;
    padding: 1px 5px;
    border-radius: 999px;
    background: #f0f2f5;
    color: #7a8494;
    font-size: 10px;
    text-align: center;
  }

  .attachment-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 10px;
  }

  .attachment-item {
    min-width: 0;
    overflow: hidden;
    border: 1px solid #dfe3e8;
    border-radius: 9px;
    background: #fafbfc;
  }

  .attachment-preview,
  .file-placeholder {
    aspect-ratio: 16 / 10;
    display: grid;
    place-items: center;
    overflow: hidden;
    border-bottom: 1px solid #e6e9ed;
    background: #f2f4f6;
  }

  .attachment-preview img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .file-placeholder span {
    padding: 7px 9px;
    border: 1px solid #cbd1d9;
    border-radius: 6px;
    color: #7a8494;
    font-size: 10px;
    font-weight: 850;
    letter-spacing: 0.08em;
  }

  .attachment-info {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 8px;
    padding: 9px 10px;
  }

  .attachment-info span {
    overflow: hidden;
    color: #445064;
    font-size: 11px;
    font-weight: 650;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .attachment-info a {
    color: #8a5a12;
    font-size: 10.5px;
    font-weight: 800;
    text-decoration: none;
  }

  .reply-dock {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    margin-top: 16px;
    padding: 15px 16px 15px 20px;
    border: 1px solid #dedfe3;
    border-radius: 11px;
    background: #fff;
  }

  .reply-dock > div {
    min-width: 0;
    display: grid;
    gap: 2px;
  }

  .reply-dock strong {
    overflow: hidden;
    color: #2f3a4c;
    font-size: 12.5px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .reply-dock span {
    color: #818b9a;
    font-size: 11px;
  }

  @media (max-width: 700px) {
    .conversation-page {
      padding-bottom: 20px;
    }

    .conversation-heading {
      padding-inline: 2px;
    }

    .message-summary {
      grid-template-columns: 34px minmax(0, 1fr);
      gap: 10px;
      padding: 14px;
    }

    .message-avatar {
      width: 34px;
      height: 34px;
    }

    .message-summary time {
      grid-column: 2;
      padding-top: 0;
      white-space: normal;
    }

    .sender-line {
      align-items: flex-start;
      flex-direction: column;
      gap: 4px;
    }

    .message-body {
      padding: 18px 16px 20px;
    }

    .attachments {
      padding: 0 16px 18px;
    }

    .attachment-grid {
      grid-template-columns: 1fr;
    }

    .reply-dock {
      align-items: stretch;
      flex-direction: column;
      padding: 14px;
    }

    .reply-btn {
      width: 100%;
    }
  }
</style>

<script>
  document.querySelectorAll(".message-body img").forEach((image) => {
    image.addEventListener("click", () => {
      if (image instanceof HTMLImageElement && image.src) {
        window.open(image.src, "_blank", "noopener,noreferrer");
      }
    });
  });
</script>
