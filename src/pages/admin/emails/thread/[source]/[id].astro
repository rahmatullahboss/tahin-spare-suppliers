---
import AdminLayout from "../../../../../layouts/AdminLayout.astro";
import { getRuntimeEnv } from "../../../../../lib/server/env";
import { getDb } from "../../../../../lib/server/db";
import { isAuthenticated } from "../../../../../lib/server/session";
import {
  extractEmailAddress,
  makeReplySubject,
  normalizeEmailSubject,
} from "../../../../../lib/server/email-thread";
import {
  isSafeInlineImageContentType,
  parseInboundAttachments,
  plainTextEmailToHtml,
  sanitizeEmailHtml,
  type InboundEmailAttachment,
} from "../../../../../lib/server/email-content";

type EmailSource = "inbound" | "sent";
type DbRow = Record<string, unknown>;
type ThreadMessage = {
  id: string;
  source: EmailSource;
  from: string;
  to: string;
  subject: string;
  body: string;
  safeBody: string;
  attachments: InboundEmailAttachment[];
  createdAt: string;
  inReplyToInboundId: string;
};

const env = getRuntimeEnv(Astro.locals);
const authenticated = await isAuthenticated(Astro.cookies, env.SESSION_SECRET);

if (!authenticated) {
  return Astro.redirect("/admin/login");
}

const source = Astro.params.source === "sent" ? "sent" : "inbound";
const { id } = Astro.params;
const sql = getDb(env);

function asString(value: unknown): string {
  if (value == null) return "";
  if (typeof value === "string") return value;
  if (value instanceof Date) return value.toISOString();
  return String(value);
}

function toMessage(row: DbRow, messageSource: EmailSource): ThreadMessage {
  const id = asString(row.id);
  const body = asString(row.body);
  const htmlBody = asString(row.html_body);
  const attachments = messageSource === "inbound"
    ? parseInboundAttachments(row.attachments_json)
    : [];
  const safeBody = messageSource === "inbound"
    ? htmlBody
      ? sanitizeEmailHtml(htmlBody, attachments, id)
      : plainTextEmailToHtml(body)
    : sanitizeEmailHtml(body, [], id);

  return {
    id,
    source: messageSource,
    from: asString(row.from_address),
    to: asString(row.to_address),
    subject: asString(row.subject),
    body,
    safeBody,
    attachments,
    createdAt: asString(row.created_at),
    inReplyToInboundId: asString(row.in_reply_to_inbound_id),
  };
}

const anchorResult = source === "inbound"
  ? await sql.query(
      `SELECT id, from_address, to_address, subject, body, html_body, attachments_json,
              created_at, '' as in_reply_to_inbound_id
       FROM inbound_emails WHERE id = $1`,
      [id]
    )
  : await sql.query(
      `SELECT id, from_address, to_address, subject, body, '' as html_body,
              '[]' as attachments_json, created_at, in_reply_to_inbound_id
       FROM sent_emails WHERE id = $1`,
      [id]
    );

if (anchorResult.length === 0) {
  return Astro.redirect("/admin/emails");
}

const anchor = toMessage(anchorResult[0] as DbRow, source);
const customerEmail = extractEmailAddress(source === "inbound" ? anchor.from : anchor.to);
const subjectKey = normalizeEmailSubject(anchor.subject);

const [inboundRows, sentRows] = await Promise.all([
  sql.query(
    `SELECT id, from_address, to_address, subject, body, html_body, attachments_json,
            created_at, '' as in_reply_to_inbound_id
     FROM inbound_emails
     ORDER BY created_at DESC
     LIMIT 500`
  ),
  sql.query(
    `SELECT id, from_address, to_address, subject, body, '' as html_body,
            '[]' as attachments_json, created_at, in_reply_to_inbound_id
     FROM sent_emails
     ORDER BY created_at DESC
     LIMIT 500`
  ),
]);

const inboundMessages = (inboundRows as DbRow[])
  .map((row) => toMessage(row, "inbound"))
  .filter((message) => {
    return extractEmailAddress(message.from) === customerEmail
      && normalizeEmailSubject(message.subject) === subjectKey;
  });

const inboundIds = new Set(inboundMessages.map((message) => message.id));

const sentMessages = (sentRows as DbRow[])
  .map((row) => toMessage(row, "sent"))
  .filter((message) => {
    const sameCustomer = extractEmailAddress(message.to) === customerEmail
      && normalizeEmailSubject(message.subject) === subjectKey;
    const linkedReply = message.inReplyToInboundId
      ? inboundIds.has(message.inReplyToInboundId) || message.inReplyToInboundId === anchor.id
      : false;
    return sameCustomer || linkedReply;
  });

const thread = [...inboundMessages, ...sentMessages].sort((a, b) => {
  return new Date(a.createdAt).getTime() - new Date(b.createdAt).getTime();
});

const latestInbound = [...inboundMessages].sort((a, b) => {
  return new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime();
})[0];

if (inboundIds.size > 0) {
  await Promise.all(
    [...inboundIds].map((inboundId) => {
      return sql.query(`UPDATE inbound_emails SET is_read = true WHERE id = $1`, [
        inboundId,
      ]);
    })
  );
}

const displaySubject = anchor.subject;
const replySubject = makeReplySubject(anchor.subject);
const replyTo = customerEmail;
const inReplyToId = latestInbound?.id ?? "";

function getAttachmentUrl(messageId: string, attachmentId: string): string {
  return `/api/admin/emails/inbound/${encodeURIComponent(messageId)}/attachments/${encodeURIComponent(attachmentId)}`;
}
---

<AdminLayout title="Email Conversation" active="emails">
  <div class="thread-shell">
    <div class="thread-header">
      <a href="/admin/emails" class="back-link">Back to Emails</a>
      <div class="thread-title-row">
        <div>
          <h1>{displaySubject}</h1>
          <p>{customerEmail}</p>
        </div>
        <a
          class="reply-btn"
          href={`/admin/emails/send?replyTo=${encodeURIComponent(replyTo)}&subject=${encodeURIComponent(replySubject)}&inReplyToId=${encodeURIComponent(inReplyToId)}`}
        >
          Reply
        </a>
      </div>
    </div>

    <div class="timeline">
      {thread.map((message) => (
        <article class:list={["message", message.source === "sent" ? "sent" : "inbound"]}>
          <div class="message-head">
            <div>
              <span class="direction">{message.source === "sent" ? "You replied" : "Customer wrote"}</span>
              <h2>{message.subject}</h2>
            </div>
            <time datetime={message.createdAt}>
              {message.createdAt ? new Date(message.createdAt).toLocaleString() : "Unknown date"}
            </time>
          </div>
          <div class="meta">
            <span>From: {message.from}</span>
            <span>To: {message.to}</span>
          </div>
          <div class="body" set:html={message.safeBody || "(Empty body)"} />
          {message.attachments.length > 0 && (
            <div class="attachments">
              <h3>Attachments</h3>
              <div class="attachment-grid">
                {message.attachments.map((attachment) => (
                  <article class="attachment-item">
                    {isSafeInlineImageContentType(attachment.contentType) && (
                      <a
                        class="attachment-preview"
                        href={getAttachmentUrl(message.id, attachment.id)}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        <img
                          src={getAttachmentUrl(message.id, attachment.id)}
                          alt={attachment.filename}
                          loading="lazy"
                        />
                      </a>
                    )}
                    <div class="attachment-info">
                      <span>{attachment.filename}</span>
                      <a
                        href={`${getAttachmentUrl(message.id, attachment.id)}?download=1`}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        Download
                      </a>
                    </div>
                  </article>
                ))}
              </div>
            </div>
          )}
        </article>
      ))}
    </div>
  </div>
</AdminLayout>

<style>
  .thread-shell {
    max-width: 900px;
  }
  .thread-header {
    margin-bottom: 22px;
  }
  .back-link {
    display: inline-block;
    color: #666;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 18px;
  }
  .back-link:hover {
    color: #c78f40;
  }
  .thread-title-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
  }
  h1 {
    margin: 0 0 6px;
    font-size: 28px;
    line-height: 1.25;
  }
  .thread-title-row p {
    margin: 0;
    color: #666;
    word-break: break-all;
  }
  .reply-btn {
    background: #c78f40;
    color: #111;
    padding: 10px 20px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 700;
    font-size: 14px;
    white-space: nowrap;
  }
  .reply-btn:hover {
    background: #b07d35;
  }
  .timeline {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .message {
    background: #fff;
    border: 1px solid #eee;
    border-radius: 8px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.04);
    overflow: hidden;
  }
  .message.sent {
    border-left: 4px solid #c78f40;
  }
  .message.inbound {
    border-left: 4px solid #c0392b;
  }
  .message-head {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 20px 10px;
  }
  .direction {
    display: inline-block;
    color: #777;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    margin-bottom: 4px;
  }
  .message h2 {
    margin: 0;
    font-size: 18px;
    line-height: 1.35;
  }
  time {
    color: #777;
    font-size: 13px;
    white-space: nowrap;
  }
  .meta {
    display: flex;
    flex-direction: column;
    gap: 4px;
    color: #666;
    font-size: 13px;
    padding: 0 20px 14px;
    border-bottom: 1px solid #eee;
    word-break: break-all;
  }
  .body {
    padding: 20px;
    color: #333;
    font-size: 15px;
    line-height: 1.7;
    overflow-wrap: anywhere;
  }
  .body :global(p:first-child) {
    margin-top: 0;
  }
  .body :global(p:last-child) {
    margin-bottom: 0;
  }
  .body :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 12px 0;
    cursor: zoom-in;
  }
  .body :global(table) {
    max-width: 100%;
    border-collapse: collapse;
    overflow-x: auto;
  }
  .body :global(td),
  .body :global(th) {
    border: 1px solid #ddd;
    padding: 6px 8px;
  }
  .attachments {
    padding: 0 20px 20px;
  }
  .attachments h3 {
    margin: 0 0 10px;
    font-size: 14px;
  }
  .attachment-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 10px;
  }
  .attachment-item {
    min-width: 0;
    border: 1px solid #e5e5e5;
    border-radius: 6px;
    overflow: hidden;
    background: #fafafa;
  }
  .attachment-preview {
    display: block;
    aspect-ratio: 4 / 3;
    background: #eee;
  }
  .attachment-preview img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .attachment-info {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 9px 10px;
    font-size: 12px;
  }
  .attachment-info span {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .attachment-info a {
    color: #8d5f20;
    font-weight: 700;
    white-space: nowrap;
  }
  @media (max-width: 700px) {
    .thread-title-row,
    .message-head {
      flex-direction: column;
    }
    .reply-btn {
      text-align: center;
    }
    time {
      white-space: normal;
    }
  }
</style>

<script>
  document.querySelectorAll(".body img").forEach((image) => {
    image.addEventListener("click", () => {
      if (image instanceof HTMLImageElement && image.src) {
        window.open(image.src, "_blank", "noopener,noreferrer");
      }
    });
  });
</script>
