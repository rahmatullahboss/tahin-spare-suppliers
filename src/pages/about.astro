---
import MainLayout from '../layouts/MainLayout.astro';
import Icon from '../components/Icon.astro';
import { BUSINESS_PROFILE } from '../lib/business-profile';
---
<MainLayout title="About Tahin Spare Suppliers | Marine Equipment Supplier" activeNav="about" description="Learn about Tahin Spare Suppliers, a Bangladesh-based marine engine, generator, hydraulic equipment and spare-parts supplier serving international buyers since 1990.">
  <section class="page-hero">
    <div class="page-hero-accent"></div>
    <div class="page-hero-content">
      <h1>About Us</h1>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="about-grid">
        <div class="about-text reveal-left" style="background:#f3e2e2; padding:30px; border-radius:10px;">
          <h2 class="section-title">Who We Are</h2>
          <p style="margin-bottom: 15px; font-size: 16px; line-height: 1.8;">Tahin Spare Suppliers has served the marine industry since 1990, supplying marine engines, spare parts, generator sets, hydraulic components and related equipment. From the Chattogram marine-sourcing area in Bangladesh, we help vessel operators and procurement teams identify suitable inventory and request current condition, availability, technical details and export support.</p>
        </div>
        <div class="about-image reveal-right img-zoom">
          <img src="/images/warehouse-yard.jpg" alt="Tahin Spare Suppliers Yard" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- Proprietor Section -->
  <section class="section proprietor-section" style="background:#fff;">
    <div class="container">
      <div class="proprietor-grid">
        <div class="proprietor-info reveal-left" style="background:#f3e2e2; padding:30px; border-radius:10px;">
          <h2 class="section-title" style="text-align:center; margin-bottom:10px;">MEET OUR PROPRIETOR</h2>
          <h3 class="proprietor-name">{BUSINESS_PROFILE.proprietor}</h3>
          <p class="proprietor-role">Proprietor, {BUSINESS_PROFILE.name}</p>
          <div class="proprietor-bio">
            <p>Under the leadership of <strong>{BUSINESS_PROFILE.proprietor}</strong>, Tahin Spare Suppliers focuses on marine-equipment sourcing, inventory identification and direct quotation support from the Chattogram marine-sourcing area.</p>
            <p>Our operating approach is to identify the exact item where possible, state the recorded condition, confirm the service or inspection scope that can be evidenced, and agree packing, documentation and shipping requirements in the quotation.</p>
          </div>
        </div>
        <div class="proprietor-image reveal-right">
          <img src="/images/proprietor.jpg" alt="MD Jamal Uddin - Proprietor" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- Team Section -->
  <section class="section team-section" style="background:#fdfdfd; border-top: 1px solid #eee;">
    <div class="container">
      <div class="team-grid">
        <div class="team-info reveal-left" style="background:#f3e2e2; padding:30px; border-radius:10px; text-align: center;">
          <h2 class="section-title" style="text-align:center; margin-bottom:10px;">MEET OUR TEAM</h2>
          <div class="team-bio">
            <p>The success of Tahin Spare Suppliers is built on the expertise and dedication of our professional team. Their hard work and deep industry knowledge are the main reasons behind everything we have achieved so far.</p>
            <p>Our team records product-specific condition and inspection information where available. For reconditioned or tested items, the relevant work scope and supporting evidence should be confirmed on the listing or during the quotation process before shipment.</p>
            <p>We focus on practical marine sourcing support, clear product information and direct communication with international buyers.</p>
          </div>
        </div>
        <div class="team-image reveal-right">
          <img src="/images/team-workshop.webp" alt="Tahin Spare Suppliers Team at Workshop" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- Why Partner With Us -->
  <section class="section" style="background:#f9f9f9;">
    <div class="container">
      <h2 class="section-title">WHY PARTNER WITH US</h2>
      <p class="section-subtitle" style="color:#555;">What makes Tahin Spare Suppliers your reliable partner</p>
      <div class="strength-grid reveal-stagger">
        <div class="strength-card">
          <Icon name="map-marker-alt" size={40} class="strength-icon" />
          <h3>Direct Sourcing</h3>
          <p>Our location near the Chattogram marine-sourcing and ship-recycling area gives us access to local equipment and spare-parts sourcing channels.</p>
        </div>
        <div class="strength-card">
          <Icon name="warehouse" size={40} class="strength-icon" />
          <h3>Inventory Access</h3>
          <p>Our {BUSINESS_PROFILE.address.area} operation supports listed and warehouse inventory checks, including product photos or video inspection where available before purchase.</p>
        </div>
        <div class="strength-card">
          <Icon name="globe" size={40} class="strength-icon" />
          <h3>Global Reach</h3>
          <p>We support international shipment coordination by sea or air according to the order, destination and available freight options.</p>
        </div>
        <div class="strength-card">
          <Icon name="check-circle" size={40} class="strength-icon" />
          <h3>Transparency & Trust</h3>
          <p>Where available for a specific item, we can provide photos, test evidence or technical information so buyers can review the product before shipping.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- What We Offer -->
  <section class="section">
    <div class="container">
      <h2 class="section-title">WHAT WE OFFER</h2>
      <p class="section-subtitle" style="color:#555;">Marine equipment and spare-parts categories available for enquiry</p>
      <div class="offer-grid">
        <div class="offer-card">
          <Icon name="cogs" size={36} class="offer-icon" />
          <h3>Marine Propulsion Engine</h3>
          <p>Browse current propulsion-engine listings by maker and model, then confirm the exact unit, recorded condition and required operating specification before ordering.</p>
        </div>
        <div class="offer-card">
          <Icon name="industry" size={36} class="offer-icon" />
          <h3>Marine Gearbox</h3>
          <p>Marine gearbox listings can include used or reconditioned units; confirm the exact maker, model, ratio, recorded condition and available evidence for the specific unit.</p>
        </div>
        <div class="offer-card">
          <Icon name="fan" size={36} class="offer-icon" />
          <h3>Auxiliary Engine</h3>
          <p>Auxiliary-engine listings are identified by maker/model and should be checked against the required onboard application, operating specification and recorded condition.</p>
        </div>
        <div class="offer-card">
          <Icon name="bolt" size={36} class="offer-icon" />
          <h3>Diesel & Gas Generator Set</h3>
          <p>Diesel and marine generator sets across multiple capacities and models; confirm the currently listed specification before ordering.</p>
        </div>
        <div class="offer-card">
          <Icon name="tools" size={36} class="offer-icon" />
          <h3>Spare Parts</h3>
          <p>Marine spare-parts listings can include pistons, cylinder liners, bearings, valves and related engine components, with condition recorded per item where available.</p>
        </div>
        <div class="offer-card">
          <Icon name="ship" size={36} class="offer-icon" />
          <h3>Hydraulic Deck Crane Equipment</h3>
          <p>Current hydraulic deck-equipment listings may include crane, winch, component or power-unit requirements; match the exact maker/model and technical specification before purchase.</p>
        </div>
        <div class="offer-card">
          <Icon name="anchor" size={36} class="offer-icon" />
          <h3>Anchor and Chain</h3>
          <p>Anchor and chain requirements can be sent for a current availability and specification check. An empty online category should not be treated as evidence of stock.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Quality Policy -->
  <section class="section quality-policy" style="background:#1a1a2e;">
    <div class="container">
      <h2 class="section-title" style="color:#fff;">QUALITY APPROACH</h2>
      <p class="qp-text">Condition and service scope vary by item. Tahin Spare Suppliers aims to record the available inspection, reconditioning or testing information for each relevant product and to confirm buyer requirements before shipment. Claims about condition or testing should be supported by the specific listing or quotation.</p>
      <div class="qp-steps">
        <div class="qp-step">
          <div class="qp-num">1</div>
          <h4>Source & Review</h4>
          <p>Record the available source, model, visible condition and identification details for the item.</p>
        </div>
        <div class="qp-step">
          <div class="qp-num">2</div>
          <h4>Service as Required</h4>
          <p>When reconditioning, repair or overhaul is part of the job, confirm the work scope for that specific unit.</p>
        </div>
        <div class="qp-step">
          <div class="qp-num">3</div>
          <h4>Test Where Applicable</h4>
          <p>When testing is part of the agreed scope, record the available result or supporting evidence for buyer review.</p>
        </div>
        <div class="qp-step">
          <div class="qp-num">4</div>
          <h4>Pack & Coordinate Shipment</h4>
          <p>Confirm packing, documentation and freight arrangements according to the item, destination and agreed order terms.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Our Mission -->
  <section class="section mission-section">
    <div class="container">
      <h2 class="section-title">OUR MISSION</h2>
      <p class="mission-text reveal">To connect international marine buyers with clearly described equipment and spare-parts sourcing from Bangladesh through transparent product information and practical export support.</p>
      <p class="mission-cta reveal">We are always looking to build long-term professional relationships with Technical Superintendents, Procurement Managers, Ship Managers, and Traders worldwide.</p>
    </div>
  </section>
</MainLayout>

<style>
  .page-hero {
    position: relative;
    height: 250px;
    background-color: #fcfcfc;
    background-image: radial-gradient(#e0e0e0 1px, transparent 1px);
    background-size: 20px 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
  }
  .page-hero-accent {
    position: absolute;
    top: 0;
    left: 0;
    width: clamp(20px, 5vw, 100px);
    height: 100%;
    background: #b11623;
    clip-path: polygon(0 0, 100% 0, 30% 100%, 0 100%);
    z-index: 0;
  }
  .page-hero-content { position: relative; z-index: 1; color: #222; }
  .page-hero-content h1 { font-size: 36px; font-weight: 800; margin-bottom: 8px; color: #b11623; }
  .page-hero-content p { font-size: 15px; color: #555; }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 50px;
    align-items: center;
  }
  .about-lead {
    font-size: 18px;
    font-weight: 600;
    color: #222;
    margin-bottom: 20px;
  }
  .about-text p {
    font-size: 14px;
    color: #555;
    line-height: 1.8;
    margin-bottom: 15px;
  }
  .about-image img {
    border-radius: 12px;
    box-shadow: 0 15px 40px rgba(0,0,0,0.1);
    width: 100%;
    height: auto;
    display: block;
  }

  /* Proprietor Section */
  .proprietor-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 60px;
    align-items: center;
  }
  .proprietor-info {
    text-align: center;
  }
  .proprietor-image img {
    width: 100%;
    max-width: 320px;
    display: block;
    margin: 0 auto;
    border-radius: 15px;
    box-shadow: 0 20px 50px rgba(0,0,0,0.15);
    border: 8px solid #fff;
  }
  
  /* Team Section */
  .team-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 60px;
    align-items: center;
  }
  .team-image img {
    width: 100%;
    border-radius: 15px;
    box-shadow: 0 20px 50px rgba(0,0,0,0.1);
  }
  .team-bio p {
    font-size: 16px;
    line-height: 1.8;
    color: #444;
    margin-bottom: 20px;
  }
  .proprietor-name {
    font-size: 24px;
    font-weight: 700;
    color: #c0392b;
    margin-bottom: 5px;
  }
  .proprietor-role {
    font-size: 16px;
    color: #666;
    font-weight: 500;
    margin-bottom: 25px;
    letter-spacing: 1px;
  }
  .proprietor-bio p {
    font-size: 15px;
    line-height: 1.8;
    color: #444;
    margin-bottom: 15px;
    text-align: center;
  }
  .proprietor-bio blockquote {
    font-size: 16px;
    font-style: italic;
    color: #222;
    border-left: none;
    padding-left: 0;
    margin: 20px auto;
    text-align: center;
    max-width: 500px;
  }

  /* Strength */
  .strength-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 25px;
  }
  .strength-card {
    text-align: center;
    padding: 35px 20px;
    background: #fff;
    border-radius: 10px;
    box-shadow: 0 2px 15px rgba(0,0,0,0.08);
    transition: transform 0.3s;
  }
  .strength-card:hover { transform: translateY(-5px); }
  .strength-card :global(.strength-icon) {
    color: #c0392b;
    margin-bottom: 15px;
  }
  .strength-card h3 {
    font-size: 17px;
    font-weight: 700;
    margin-bottom: 10px;
    color: #222;
  }
  .strength-card p {
    font-size: 13px;
    color: #666;
    line-height: 1.6;
  }

  /* What We Offer */
  .offer-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 25px;
  }
  .offer-card {
    text-align: center;
    padding: 30px 20px;
    background: #f9f9f9;
    border-radius: 10px;
    box-shadow: 0 2px 15px rgba(0,0,0,0.06);
    transition: transform 0.3s;
  }
  .offer-card:hover { transform: translateY(-5px); }
  .offer-card :global(.offer-icon) {
    color: #c0392b;
    margin-bottom: 15px;
  }
  .offer-card h3 {
    font-size: 16px;
    font-weight: 700;
    margin-bottom: 10px;
    color: #222;
  }
  .offer-card p {
    font-size: 13px;
    color: #666;
    line-height: 1.6;
  }

  /* Quality Policy */
  .qp-text {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 40px;
    font-size: 15px;
    color: #bbb;
    line-height: 1.8;
  }
  .qp-steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 25px;
  }
  .qp-step {
    text-align: center;
    padding: 30px 20px;
    background: rgba(255,255,255,0.05);
    border-radius: 10px;
    border: 1px solid rgba(255,255,255,0.1);
  }
  .qp-num {
    width: 50px;
    height: 50px;
    background: #c0392b;
    color: #fff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    font-weight: 700;
    margin: 0 auto 15px;
  }
  .qp-step h4 {
    font-size: 16px;
    color: #fff;
    margin-bottom: 10px;
  }
  .qp-step p {
    font-size: 13px;
    color: #999;
    line-height: 1.6;
  }

  /* Mission */
  .mission-text {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 20px;
    font-size: 18px;
    color: #333;
    font-weight: 500;
    line-height: 1.8;
    font-style: italic;
  }
  .mission-cta {
    text-align: center;
    max-width: 700px;
    margin: 0 auto;
    font-size: 14px;
    color: #666;
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .about-grid { grid-template-columns: 1fr; }
    .team-grid { grid-template-columns: 1fr; }
    .offer-grid { grid-template-columns: repeat(2, 1fr); }
    .strength-grid { grid-template-columns: repeat(2, 1fr); }
    .qp-steps { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) {
    .offer-grid { grid-template-columns: 1fr; }
    .strength-grid { grid-template-columns: 1fr; }
    .qp-steps { grid-template-columns: 1fr; }
  }
</style>
