---
import MainLayout from '../layouts/MainLayout.astro';
import Icon from '../components/Icon.astro';
import { BUSINESS_PROFILE } from '../lib/business-profile';
---
<MainLayout title="Our Services - Tahin Spare Suppliers" activeNav="services" description="Tahin Spare Suppliers offers marine engine supply, spare parts export, equipment reconditioning, and worldwide shipping from Bangladesh.">
  <section class="page-hero">
    <div class="page-hero-accent"></div>
    <div class="page-hero-content">
      <h1>Our Services</h1>
    </div>
  </section>

  <!-- Services Intro -->
  <section class="section">
    <div class="container">
      <h2 class="section-title">WHAT WE DO</h2>
      <p class="services-intro reveal">Tahin Spare Suppliers supplies and exports marine engines, engine spare parts, generator sets and related equipment from Chattogram, Bangladesh. Buyers can send a brand, model or part number to confirm current stock, condition, technical details and export options.</p>
    </div>
  </section>

  <!-- Service 1: Marine Engine Parts Supply -->
  <section class="section" style="background:#f9f9f9;">
    <div class="container">
      <div class="service-detail">
        <div class="service-detail-text reveal-left">
          <div class="service-badge"><Icon name="layer-group" size={24} /></div>
          <h2>Marine Engine Parts Supply</h2>
          <p>Our core business includes marine engine spare-parts supply and export. We source through the Chattogram marine market and identify parts by brand, model and part number where the information is available.</p>
          <ul>
            <li><Icon name="check" size={14} class="svc-check" /> Pistons, liners & cylinder heads</li>
            <li><Icon name="check" size={14} class="svc-check" /> Bearings, crankshafts & connecting rods</li>
            <li><Icon name="check" size={14} class="svc-check" /> Fuel pumps, injectors & fuel systems</li>
            <li><Icon name="check" size={14} class="svc-check" /> Turbochargers — ABB, MHI, IHI, Napier</li>
            <li><Icon name="check" size={14} class="svc-check" /> Gaskets, valves & seals for multiple engine types</li>
          </ul>
          <a href="/enquiry" class="btn btn-primary">Request Parts Quote</a>
        </div>
        <div class="service-detail-img">
          <img src="/images/spare-parts.webp" alt="Marine Engine Spare Parts" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- Service 2: Engine Overhaul & Reconditioning -->
  <section class="section">
    <div class="container">
      <div class="service-detail">
        <div class="service-detail-text reveal-left">
          <div class="service-badge"><Icon name="tools" size={24} /></div>
          <h2>Engine Overhaul & Reconditioning</h2>
          <p>Our workshop can support engine overhaul and reconditioning for selected marine engine models. The inspection, replacement, testing and documentation scope is confirmed for each job rather than assumed for every unit.</p>
          <ul>
            <li><Icon name="check" size={14} class="svc-check" /> Full engine disassembly, cleaning &amp; inspection</li>
            <li><Icon name="check" size={14} class="svc-check" /> Component reconditioning &amp; replacement</li>
            <li><Icon name="check" size={14} class="svc-check" /> Precision reassembly &amp; calibration</li>
            <li><Icon name="check" size={14} class="svc-check" /> Load testing or performance verification when included in the agreed scope</li>
            <li><Icon name="check" size={14} class="svc-check" /> Inspection, test records or other supporting evidence where available for the job</li>
            <li><Icon name="check" size={14} class="svc-check" /> Supported maker/model scope confirmed before the job</li>
          </ul>
          <a href="/enquiry" class="btn btn-primary">Get a Quote</a>
        </div>
        <div class="service-detail-img">
          <img src="/images/marine-engine.webp" alt="Engine Overhaul & Reconditioning" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- Service 3: Worldwide Export -->
  <section class="section" style="background:#f9f9f9;">
    <div class="container">
      <div class="service-detail">
        <div class="service-detail-text reveal-left">
          <div class="service-badge"><Icon name="globe" size={24} /></div>
          <h2>Worldwide Parts Export</h2>
          <p>We support international export of marine engines, generator sets, hydraulic equipment and engine spare parts. Packing, documentation and freight arrangements are confirmed according to the item, destination and order terms.</p>
          <ul>
            <li><Icon name="check" size={14} class="svc-check" /> Destination-specific export and freight coordination</li>
            <li><Icon name="check" size={14} class="svc-check" /> Proper packing & documentation support</li>
            <li><Icon name="check" size={14} class="svc-check" /> Commercial and export-documentation support as applicable</li>
            <li><Icon name="check" size={14} class="svc-check" /> Sea and air freight coordination based on destination</li>
            <li><Icon name="check" size={14} class="svc-check" /> Current stock confirmed before dispatch</li>
          </ul>
          <a href="/enquiry" class="btn btn-primary">Send Export Enquiry</a>
        </div>
        <div class="service-detail-img">
          <img src="/images/shipping-dock.jpg" alt="Worldwide Marine Parts Export" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section">
    <div class="cta-overlay"></div>
    <div class="container cta-content">
      <h2>Need Marine Engine Parts or Equipment?</h2>
      <p>Send your brand, model or part number for a quotation and confirmation of current availability and export options.</p>
      <div class="cta-btns">
        <a href="/enquiry" class="btn btn-primary">Send Enquiry</a>
        <a href={BUSINESS_PROFILE.whatsapp.primary.href} class="btn btn-outline" target="_blank" rel="noopener">WhatsApp Us</a>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .page-hero {
    position: relative;
    height: 250px;
    background-color: #fcfcfc;
    background-image: radial-gradient(#e0e0e0 1px, transparent 1px);
    background-size: 20px 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
  }
  .page-hero-accent {
    position: absolute;
    top: 0;
    left: 0;
    width: clamp(20px, 5vw, 100px);
    height: 100%;
    background: #b11623;
    clip-path: polygon(0 0, 100% 0, 30% 100%, 0 100%);
    z-index: 0;
  }
  .page-hero-content { position: relative; z-index: 1; color: #222; }
  .page-hero-content h1 { font-size: 36px; font-weight: 800; margin-bottom: 8px; color: #b11623; }
  .page-hero-content p { font-size: 15px; color: #555; }

  .services-intro {
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
    font-size: 15px;
    color: #555;
    line-height: 1.8;
  }

  .service-detail {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 50px;
    align-items: center;
  }

  .service-badge {
    width: 56px;
    height: 56px;
    background: #c0392b;
    color: #fff;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
  }
  .service-detail-text h2 {
    font-size: 26px;
    font-weight: 700;
    color: #222;
    margin-bottom: 15px;
  }
  .service-detail-text p {
    font-size: 14px;
    color: #555;
    line-height: 1.8;
    margin-bottom: 20px;
  }
  .service-detail-text ul {
    list-style: none;
    padding: 0;
    margin: 0 0 25px;
  }
  .service-detail-text li {
    font-size: 14px;
    color: #555;
    padding: 5px 0;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .service-detail-text :global(.svc-check) {
    color: #2ecc71;
    flex-shrink: 0;
  }
  .service-detail-img img {
    width: 100%;
    border-radius: 10px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.15);
  }

  /* CTA */
  .cta-section {
    position: relative;
    background: url('/images/team-workshop.webp') center/cover no-repeat;
    padding: 80px 0;
    text-align: center;
  }
  .cta-overlay {
    position: absolute;
    inset: 0;
    background: rgba(80, 20, 120, 0.8);
  }
  .cta-content {
    position: relative;
    z-index: 1;
  }
  .cta-content h2 {
    color: #fff;
    font-size: 30px;
    font-weight: 700;
    margin-bottom: 12px;
    font-family: var(--font-playfair), 'Playfair Display', serif;
  }
  .cta-content p {
    color: #ddd;
    font-size: 16px;
    margin-bottom: 30px;
  }
  .cta-btns {
    display: flex;
    gap: 15px;
    justify-content: center;
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .service-detail { grid-template-columns: 1fr; }
  }
</style>
