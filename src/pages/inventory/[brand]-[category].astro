---
import MainLayout from '../../layouts/MainLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProductGrid from '../../components/ProductGrid.astro';
import { toUrlSlug } from '../../lib/seo';
import { getRuntimeEnv } from '../../lib/server/env';
import { listContent } from '../../lib/server/repository';
import { findCategoryBySlug } from '../../lib/server/categories';

const { brand, category } = Astro.params;
const env = getRuntimeEnv(Astro.locals);
const currentCategory = await findCategoryBySlug(env, category ?? '');

if (!currentCategory || !brand) {
  return new Response('Inventory combination not found', {
    status: 404,
    headers: { 'Content-Type': 'text/plain; charset=utf-8' }
  });
}

const liveProducts = await listContent(env, 'products', { limit: 1000 });
const categoryProducts = liveProducts.filter((product) => (
  product.category === currentCategory.value
  && Boolean(product.brand)
  && toUrlSlug(product.brand ?? '') === brand
));

if (categoryProducts.length === 0) {
  return new Response('Inventory combination not found', {
    status: 404,
    headers: { 'Content-Type': 'text/plain; charset=utf-8' }
  });
}

const displayBrand = categoryProducts[0]?.brand?.trim() || brand.replace(/-/g, ' ');
const pageTitle = `${displayBrand} ${currentCategory.value} Inventory | Tahin Spare Suppliers`;
const pageDesc = `Browse currently listed ${displayBrand} ${currentCategory.value} from Tahin Spare Suppliers. Check each listing for model, condition and availability, then request a quote.`;
const canonicalPath = `/inventory/${brand}-${currentCategory.slug}`;
---
<MainLayout
  title={pageTitle}
  description={pageDesc}
  activeNav="products"
  canonicalUrl={`https://tahinspare.com${canonicalPath}`}
  noindex={true}
>
  <section class="page-hero">
    <div class="page-hero-accent"></div>
    <div class="page-hero-content container">
      <h1>{displayBrand} {currentCategory.value}</h1>
      <p>Currently listed equipment grouped by brand and category.</p>
    </div>
  </section>

  <Breadcrumbs items={[
    { name: 'Home', href: '/' },
    { name: 'Marine Equipment', href: '/products' },
    { name: currentCategory.value, href: `/category/${currentCategory.slug}` },
    { name: displayBrand, href: canonicalPath }
  ]} />

  <section class="section">
    <div class="container">
      <div class="inventory-intro">
        <p>
          This page groups currently listed <strong>{displayBrand} {currentCategory.value}</strong> inventory.
          Review the individual listing for model, condition and recorded availability, and contact Tahin Spare Suppliers to confirm the item before ordering.
        </p>
      </div>
      <ProductGrid products={categoryProducts} />
    </div>
  </section>
</MainLayout>

<style>
  .page-hero {
    position: relative;
    min-height: 260px;
    background: #f8fafc;
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .page-hero-accent {
    position: absolute;
    inset: 0 auto 0 0;
    width: clamp(24px, 6vw, 110px);
    background: #b11623;
    clip-path: polygon(0 0, 100% 0, 30% 100%, 0 100%);
  }
  .page-hero-content { position: relative; z-index: 1; }
  .page-hero-content h1 { margin: 0 0 10px; color: #111827; font-size: clamp(2rem, 5vw, 3rem); }
  .page-hero-content p { margin: 0; color: #475569; }
  .inventory-intro {
    margin-bottom: 30px;
    padding: 20px 24px;
    border-left: 4px solid #b11623;
    background: #f8fafc;
  }
  .inventory-intro p { margin: 0; color: #334155; line-height: 1.7; }
</style>
