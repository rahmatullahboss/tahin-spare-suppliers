---
import MainLayout from '../../../layouts/MainLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { toUrlSlug } from '../../../lib/seo';
import { getRuntimeEnv } from '../../../lib/server/env';
import { listProductSummaries } from '../../../lib/server/repository';
import { findSubcategoryBySlug } from '../../../lib/server/categories';

const { category, subcategory } = Astro.params;
const env = getRuntimeEnv(Astro.locals);
const result = await findSubcategoryBySlug(env, category ?? '', subcategory ?? '');

if (!result) {
  return new Response('Subcategory not found', {
    status: 404,
    headers: { 'Content-Type': 'text/plain; charset=utf-8' }
  });
}

const { parent, subcategory: currentSubcategory } = result;

const categoryProducts = await listProductSummaries(env, { category: parent.value, limit: 1000 });
const filteredProducts = categoryProducts.filter((p) => p.subcategory === currentSubcategory.value);
const PRODUCT_PAGE_SIZE = 12;
const totalProductPages = Math.max(1, Math.ceil(filteredProducts.length / PRODUCT_PAGE_SIZE));

// Build brand links only from real listed inventory.
const displayBrands = [...new Set(
  filteredProducts
    .map((product) => product.brand?.trim() ?? '')
    .filter((brand) => brand.length > 0)
)];
const brandSummary = displayBrands.length > 0 ? displayBrands.join(', ') : 'brands that match your requested maker and model';

---
<MainLayout
  title={`${currentSubcategory.value} Supplier & Exporter | Tahin Spare Suppliers`}
  description={`Browse current ${currentSubcategory.value} listings by brand and model. Request specifications, condition, availability, price and worldwide shipping from Tahin Spare Suppliers.`}
  activeNav="products"
  noindex={filteredProducts.length === 0}
>
  <section class="page-hero">
    <div class="page-hero-accent"></div>
    <div class="page-hero-content">
      <h1 class="reveal">{currentSubcategory.value}</h1>
      <p class="hero-subtitle reveal">Browse our inventory of {currentSubcategory.value}</p>
    </div>
  </section>

  <Breadcrumbs items={[
    { name: 'Home', href: '/' },
    { name: 'Marine Equipment', href: '/products' },
    { name: parent.value, href: `/category/${parent.slug}` },
    { name: currentSubcategory.value, href: `/category/${parent.slug}/${currentSubcategory.slug}` }
  ]} />

  <section class="section">
    <div class="container">
      <div class="mb-5">
        <a href={`/category/${parent.slug}`} class="back-link">← Back to {parent.value}</a>
      </div>

      {filteredProducts.length === 0 ? (
        <div class="empty-state">
           <h3>No products available</h3>
           <p>We currently have no products listed under {currentSubcategory.value}. Please check back later or send us an enquiry!</p>
           <a href="/enquiry" class="btn btn-primary" style="margin-top:20px;">Send Enquiry</a>
        </div>
      ) : (
        <>
          <div class="products-grid reveal-stagger" data-paginated data-page-size={PRODUCT_PAGE_SIZE} data-current-page="1">
            {filteredProducts.map((product) => (
              <a href={`/products/${product.slug}`} class="product-card" style="text-decoration: none;">
                <div class="product-img">
                  <img src={product.imageUrl || currentSubcategory.imageUrl || parent.imageUrl} alt={product.imageAlt || product.title} width="800" height="600" loading="lazy" decoding="async" />
                </div>
                <div class="product-content">
                  <h3>{product.title}</h3>
                  <p class="live-excerpt">{product.excerpt}</p>
                  <div class="product-meta">
                    {product.brand && <span class="badge badge-brand">{product.brand}</span>}
                    {product.model_number && <span class="badge badge-model">{product.model_number}</span>}
                  </div>
                  <span class="view-details">VIEW DETAILS</span>
                </div>
              </a>
            ))}
          </div>
          <div class="pagination" data-pagination hidden></div>
        </>
      )}

      <!-- Programmatic SEO Brand Links -->
      <div class="brand-seo-links">
        <h3>Browse {currentSubcategory.value} by Brand</h3>
        <div class="tags-container">
          {displayBrands.map((brand) => (
            <a href={`/brands/${toUrlSlug(brand)}`} class="brand-tag">
              {brand} {currentSubcategory.value}
            </a>
          ))}
        </div>
      </div>

      <!-- FAQ Section for AI SEO -->
      <div class="faq-section mt-5">
        <h3 class="reveal">Frequently Asked Questions</h3>
        <div class="faq-item reveal">
          <h4>Do you export {currentSubcategory.value} globally?</h4>
          <p>Tahin Spare Suppliers handles international enquiries for {currentSubcategory.value} and can provide packing, export-documentation and shipping support from Chattogram, Bangladesh. Confirm the specific item's condition and availability before ordering.</p>
        </div>
        <div class="faq-item reveal">
          <h4>What brands of {currentSubcategory.value} do you supply?</h4>
          <p>Current online listings for {currentSubcategory.value} include {brandSummary}. If your required maker is not listed, send the exact model or part number for an inventory check.</p>
        </div>
        <div class="faq-item reveal">
          <h4>What is the condition of the {currentSubcategory.value}?</h4>
          <p>Condition varies by listing. Each product page shows the recorded condition and availability where supplied; contact Tahin Spare Suppliers to confirm the current item before purchase.</p>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<script>
  const grid = document.querySelector('[data-paginated]');
  const paginationEl = document.querySelector('[data-pagination]');
  if (grid && paginationEl) {
    const items = Array.from(grid.children) as HTMLElement[];
    const pageSize = parseInt(grid.dataset.pageSize || '12', 10);
    const totalPages = Math.max(1, Math.ceil(items.length / pageSize));
    let currentPage = 1;

    if (totalPages <= 1) {
      paginationEl.hidden = true;
    } else {
      paginationEl.hidden = false;
      const getPageNumbers = () => {
        const pages: (number | string)[] = [1];
        if (totalPages <= 7) {
          for (let i = 2; i <= totalPages; i++) pages.push(i);
        } else {
          const start = Math.max(2, currentPage - 1);
          const end = Math.min(totalPages - 1, currentPage + 1);
          if (start > 2) pages.push('…');
          for (let i = start; i <= end; i++) pages.push(i);
          if (end < totalPages - 1) pages.push('…');
          pages.push(totalPages);
        }
        return pages;
      };

      const renderPagination = () => {
        paginationEl.innerHTML = '';
        const prev = document.createElement('button');
        prev.type = 'button';
        prev.textContent = '← Prev';
        prev.disabled = currentPage === 1;
        prev.addEventListener('click', () => goTo(currentPage - 1));
        paginationEl.appendChild(prev);

        getPageNumbers().forEach((p) => {
          if (typeof p === 'string') {
            const info = document.createElement('span');
            info.className = 'page-info';
            info.textContent = '…';
            paginationEl.appendChild(info);
          } else {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.textContent = String(p);
            if (p === currentPage) btn.dataset.active = 'true';
            btn.addEventListener('click', () => goTo(p));
            paginationEl.appendChild(btn);
          }
        });

        const next = document.createElement('button');
        next.type = 'button';
        next.textContent = 'Next →';
        next.disabled = currentPage === totalPages;
        next.addEventListener('click', () => goTo(currentPage + 1));
        paginationEl.appendChild(next);
      };

      const goTo = (page: number) => {
        if (page < 1 || page > totalPages) return;
        currentPage = page;
        grid.dataset.currentPage = String(currentPage);
        items.forEach((item, i) => {
          const pageNum = Math.floor(i / pageSize) + 1;
          item.style.display = pageNum === currentPage ? '' : 'none';
        });
        renderPagination();
        grid.scrollIntoView({ behavior: 'smooth', block: 'start' });
      };

      goTo(1);
    }
  }
</script>

<style>
  .page-hero {
    position: relative;
    height: 250px;
    background-color: #fcfcfc;
    background-image: radial-gradient(#e0e0e0 1px, transparent 1px);
    background-size: 20px 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
  }
  .page-hero-accent {
    position: absolute;
    top: 0;
    left: 0;
    width: clamp(20px, 5vw, 100px);
    height: 100%;
    background: #b11623;
    clip-path: polygon(0 0, 100% 0, 30% 100%, 0 100%);
    z-index: 0;
  }
  .page-hero-content { position: relative; z-index: 1; color: #222; }
  .page-hero-content h1 { font-size: 36px; font-weight: 800; margin-bottom: 8px; color: #b11623; }
  .page-hero-content p { font-size: 15px; color: #555; }

  .breadcrumb {
    font-size: 13px;
    color: #888;
    margin-bottom: 12px;
  }
  .breadcrumb a {
    color: #666;
    text-decoration: none;
    transition: color 0.2s;
  }
  .breadcrumb a:hover { color: #b11623; }
  .breadcrumb-sep { margin: 0 8px; color: #ccc; }
  .breadcrumb-current { color: #b11623; font-weight: 600; }

  .mb-5 { margin-bottom: 30px; }
  .back-link {
    display: inline-block;
    color: #666;
    text-decoration: none;
    font-weight: 600;
    transition: color 0.3s;
  }
  .back-link:hover { color: #b11623; }

  .empty-state {
    text-align: center;
    padding: 60px 20px;
    background: #f9f9f9;
    border-radius: 12px;
    border: 1px dashed #ccc;
  }
  .empty-state h3 { font-size: 24px; color: #222; margin-bottom: 15px; }
  .empty-state p { font-size: 15px; color: #666; max-width: 500px; margin: 0 auto; line-height: 1.6; }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .product-card {
    position: relative;
    border-radius: 0;
    background: #fff;
    border: 1px solid #eaeaea;
    overflow: hidden;
    box-shadow: 0 4px 15px rgba(0,0,0,0.04);
    transition: transform 0.35s ease, box-shadow 0.35s ease;
    cursor: pointer;
    display: flex;
    flex-direction: column;
  }
  .product-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 12px 35px rgba(0,0,0,0.1);
  }
  .product-img {
    width: 100%;
    height: 240px;
    position: relative;
    overflow: hidden;
    clip-path: polygon(0 0, 100% 0, 100% 100%, 0 92%);
  }
  .product-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .product-card:hover .product-img img {
    transform: scale(1.06);
  }
  .product-content {
    padding: 24px 24px 30px;
    background: #fff;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }
  .product-content h3 {
    font-size: 20px;
    color: #111;
    font-weight: 700;
    line-height: 1.4;
    margin-bottom: 10px;
  }
  .live-excerpt {
    margin: 0 0 16px;
    color: #666;
    line-height: 1.6;
    flex-grow: 1;
  }
  .product-meta {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }
  .badge {
    padding: 4px 10px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
  }
  .badge-brand { background: #eee; color: #333; }
  .badge-model { background: #ffeaa7; color: #d35400; }

  .view-details {
    font-size: 13px;
    color: #b11623;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    transition: color 0.3s;
    margin-top: auto;
  }
  .product-card:hover .view-details {
    color: #c0392b;
  }

  .mt-5 { margin-top: 50px; }
  .brand-seo-links { margin-top: 50px; padding-top: 30px; border-top: 1px solid #eee; }
  .brand-seo-links h3 { font-size: 20px; color: #222; margin-bottom: 20px; }
  .tags-container { display: flex; flex-wrap: wrap; gap: 10px; }
  .brand-tag {
    background: #fdfdfd;
    border: 1px solid #ddd;
    color: #444;
    padding: 8px 16px;
    border-radius: 4px;
    font-size: 14px;
    text-decoration: none;
    transition: all 0.2s;
  }
  .brand-tag:hover { background: #b11623; color: #fff; border-color: #b11623; }

  .faq-section { background: #fafafa; padding: 40px; border-radius: 8px; margin-bottom: 30px; }
  .faq-section h3 { font-size: 24px; color: #222; margin-bottom: 30px; font-weight: 800; }
  .faq-item { margin-bottom: 25px; }
  .faq-item:last-child { margin-bottom: 0; }
  .faq-item h4 { font-size: 18px; color: #b11623; margin-bottom: 10px; font-weight: 600; }
  .faq-item p { font-size: 15px; color: #555; line-height: 1.6; margin: 0; }

  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.4rem;
    margin: 40px 0 20px;
    flex-wrap: wrap;
  }
  .pagination button {
    padding: 0.5rem 0.9rem;
    border: 1px solid #e2e8f0;
    background: #fff;
    border-radius: 0.5rem;
    cursor: pointer;
    font-size: 0.9rem;
    font-weight: 500;
    color: #334155;
    transition: background 0.15s, border-color 0.15s, color 0.15s;
  }
  .pagination button:hover:not(:disabled) { background: #f1f5f9; border-color: #cbd5e1; }
  .pagination button:disabled { opacity: 0.35; cursor: not-allowed; }
  .pagination button[data-active] { background: #b11623; color: #fff; border-color: #b11623; }
  .pagination .page-info { padding: 0.5rem 0.4rem; color: #94a3b8; font-size: 0.9rem; }

  @media (max-width: 768px) {
    .products-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) {
    .products-grid { grid-template-columns: 1fr; }
  }
</style>
