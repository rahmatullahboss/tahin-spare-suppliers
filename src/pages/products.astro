---
import MainLayout from '../layouts/MainLayout.astro';

const categories = [
  { name: 'Marine Propulsion Engine', link: '/category/marine-propulsion-engine', image: '/images/marine-propulsion-engine.jpg' },
  { name: 'Marine Gearbox', link: '/category/marine-gearbox', image: '/images/marine-gearbox.jpg' },
  { name: 'Auxiliary Engine', link: '/category/auxiliary-engine', image: '/images/auxiliary-engine.jpg' },
  { name: 'Diesel & Gas Generator Set', link: '/category/diesel-generator-set', image: '/images/diesel-generator-set.jpg' },
  { name: 'Spare Parts', link: '/category/spare-parts', image: '/images/spare-parts-new.jpg' },
  { name: 'Hydraulic Deck Crane Equipment', link: '/category/hydraulic-deck-crane-equipment', image: '/images/hydraulic-crane-equipment.jpg' },
  { name: 'Anchor and Chain', link: '/category/anchor-and-chain', image: '/images/anchor-chain.jpg' },
  { name: 'Marine Pump', link: '/category/marine-pump', image: '/images/marine-pump.jpg' }
];
---
<MainLayout title="Equipments - Tahin Spare Suppliers" activeNav="products">
  <section class="page-hero">
    <div class="page-hero-accent"></div>
    <div class="page-hero-content">
      <h1 class="reveal">Equipments</h1>
      <p class="hero-subtitle reveal">Your one-stop solution for reconditioned marine engines & equipment</p>
    </div>
  </section>

  <section class="section stock-spares">
    <div class="container">
      <div class="stock-grid reveal-stagger">
        {categories.map((cat) => (
          <a href={cat.link} class="stock-card">
            <div class="stock-card-img">
              <img src={cat.image} alt={cat.name} loading="lazy" />
            </div>
            <div class="stock-card-content">
              <h3>{cat.name}</h3>
              <span class="stock-card-cta">VIEW DETAILS</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .page-hero {
    position: relative;
    height: 250px;
    background-color: #fcfcfc;
    background-image: radial-gradient(#e0e0e0 1px, transparent 1px);
    background-size: 20px 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
  }
  .page-hero-accent {
    position: absolute;
    top: 0;
    left: 0;
    width: clamp(20px, 5vw, 100px);
    height: 100%;
    background: #b11623;
    clip-path: polygon(0 0, 100% 0, 30% 100%, 0 100%);
    z-index: 0;
  }
  .page-hero-content { position: relative; z-index: 1; color: #222; }
  .page-hero-content h1 { font-size: 36px; font-weight: 800; margin-bottom: 8px; color: #b11623; }
  .page-hero-content p { font-size: 15px; color: #555; }

  /* Stock Spare Styling */
  .stock-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 30px;
    padding-top: 40px;
  }
  .stock-card {
    background: #fff;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0,0,0,0.06);
    transition: transform 0.3s, box-shadow 0.3s;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    border: 1px solid #f0f0f0;
  }
  .stock-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 15px 40px rgba(0,0,0,0.12);
  }
  .stock-card-img {
    height: 200px;
    overflow: hidden;
    position: relative;
    border-bottom: 3px solid #b11623;
  }
  .stock-card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s;
  }
  .stock-card:hover .stock-card-img img {
    transform: scale(1.1);
  }
  .stock-card-content {
    padding: 25px 20px;
    text-align: center;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .stock-card-content h3 {
    font-size: 18px;
    font-weight: 700;
    color: #222;
    margin-bottom: 12px;
  }
  .stock-card-cta {
    font-size: 13px;
    font-weight: 600;
    color: #b11623;
    letter-spacing: 1px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    transition: color 0.3s;
  }
  .stock-card:hover .stock-card-cta {
    color: #c0392b;
  }

  @media (max-width: 1024px) {
    .stock-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 768px) {
    .stock-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) {
    .stock-grid { grid-template-columns: 1fr; }
  }
</style>
