---
import "../styles/global.css";
import AdminSidebar from "../components/admin/AdminSidebar.astro";

interface Props {
  title: string;
  active: "dashboard" | "products" | "blog" | "contacts" | "enquiries" | "categories" | "emails";
}

const { title, active } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <div class="admin-shell">
      <AdminSidebar active={active} />
      <main class="admin-main">
        <slot />
      </main>
    </div>
  </body>
</html>

<style>
  .admin-shell {
    min-height: 100vh;
    display: grid;
    grid-template-columns: 250px 1fr;
    background: #f1f5f9;
  }
  .admin-main {
    padding: 2rem 1.5rem;
    overflow-y: auto;
    max-height: 100vh;
  }
  @media (max-width: 900px) {
    .admin-shell {
      grid-template-columns: 1fr;
      grid-template-rows: auto 1fr;
    }
    .admin-main {
      padding: 1rem;
      max-height: none;
    }
  }
</style>
