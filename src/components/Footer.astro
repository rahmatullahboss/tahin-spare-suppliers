---
import Icon from './Icon.astro';
import { BUSINESS_PROFILE } from '../lib/business-profile';
---
<footer class="site-footer">
  <div class="footer-top">
    <div class="footer-container">
      <div class="footer-col">
        <div class="footer-logo">
          <img src="/images/favicon.svg" alt="Tahin Spare Suppliers Logo" width="48" height="48" />
          <h3>About Us</h3>
        </div>
        <p>Tahin Spare Suppliers supplies and exports marine engines, generator sets, hydraulic equipment and spare parts from the Chattogram marine-sourcing area in Bangladesh.</p>
      </div>
      <div class="footer-col">
        <h3>Products & Inventory</h3>
        <ul>
          <li><a href="/category/marine-propulsion-engine">Marine Propulsion Engine</a></li>
          <li><a href="/category/marine-gearbox">Marine Gearbox</a></li>
          <li><a href="/category/auxiliary-engine">Auxiliary Engine</a></li>
          <li><a href="/category/diesel-generator-set">Diesel & Gas Generator Set</a></li>
          <li><a href="/category/spare-parts">Spare Parts</a></li>
          <li><a href="/category/hydraulic-deck-crane-equipment">Hydraulic Deck Crane Equipment</a></li>
          <li><a href="/category/marine-pump">Marine Pump</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h3>Quick Links</h3>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/about">About Us</a></li>
          <li><a href="/services">Our Services</a></li>
          <li><a href="/enquiry">Request a Quote</a></li>
          <li><a href="/blog">Blog</a></li>
          <li><a href="/contact">Contact Us</a></li>
          <li><a href="/business-info">Business Information</a></li>
          <li><a href="/privacy">Privacy</a></li>
          <li><a href="/terms">Terms</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h3>Contact Info</h3>
        <ul class="contact-list">
          <li><Icon name="whatsapp" size={14} class="contact-icon whatsapp-icon" /> <a href={BUSINESS_PROFILE.whatsapp.primary.href} target="_blank" rel="noopener">{BUSINESS_PROFILE.whatsapp.primary.display}</a></li>
          <li><Icon name="whatsapp" size={14} class="contact-icon whatsapp-icon" /> <a href={BUSINESS_PROFILE.whatsapp.secondary.href} target="_blank" rel="noopener">{BUSINESS_PROFILE.whatsapp.secondary.display}</a></li>
          <li><Icon name="phone" size={14} class="contact-icon" /> <a href={BUSINESS_PROFILE.phone.href}>{BUSINESS_PROFILE.phone.display}</a></li>
          <li><Icon name="envelope" size={14} class="contact-icon" /> <a href={`mailto:${BUSINESS_PROFILE.email}`}>{BUSINESS_PROFILE.email}</a></li>
          <li><Icon name="map-marker-alt" size={14} class="contact-icon" /> <a href={BUSINESS_PROFILE.address.mapsUrl} target="_blank" rel="noopener">{BUSINESS_PROFILE.address.singleLine}</a></li>
        </ul>
        <div class="footer-social">
          <a href={BUSINESS_PROFILE.social.facebook} aria-label="Facebook" target="_blank" rel="noopener"><Icon name="facebook-f" size={14} /></a>
          <a href={BUSINESS_PROFILE.social.linkedin} aria-label="LinkedIn" target="_blank" rel="noopener"><Icon name="linkedin-in" size={14} /></a>
        </div>
      </div>
    </div>
  </div>
  <div class="footer-bottom">
    <p>&copy; {new Date().getFullYear()} {BUSINESS_PROFILE.name}. All Rights Reserved. | Est. {BUSINESS_PROFILE.establishedYear} | Proprietor: {BUSINESS_PROFILE.proprietor}</p>
    <p>Created by <a href="https://digitalcare.site/" target="_blank" rel="noopener" class="created-by">DigitalCare</a></p>
  </div>
</footer>

<style>
  .site-footer {
    font-family: var(--font-inter), 'Inter', sans-serif;
  }
  .footer-top {
    background: #1a1a2e;
    color: #ccc;
    padding: 50px 0 30px;
  }
  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.2fr 1fr 0.8fr 1.2fr;
    gap: 30px;
    padding: 0 20px;
  }
  .footer-logo {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-bottom: 20px;
  }
  .footer-logo h3 {
    margin-bottom: 0;
  }
  .footer-col h3 {
    color: #fff;
    font-size: 18px;
    margin: 0 0 20px 0;
    position: relative;
    padding-bottom: 10px;
  }
  .footer-col h3::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 40px;
    height: 2px;
    background: #c0392b;
  }
  .footer-col > p {
    font-size: 14px;
    line-height: 1.7;
    color: #aaa;
    margin-top: 15px;
  }
  .footer-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .footer-col ul li {
    margin-bottom: 10px;
  }
  .footer-col ul li a {
    color: #aaa;
    text-decoration: none;
    font-size: 14px;
    transition: color 0.3s;
  }
  .footer-col ul li a:hover {
    color: #f1c40f;
  }
  .contact-list li {
    font-size: 13px;
    color: #aaa;
    display: flex;
    align-items: flex-start;
    gap: 8px;
    line-height: 1.5;
  }
  .contact-list :global(.contact-icon) {
    color: #c0392b;
    flex-shrink: 0;
    margin-top: 2px;
  }
  .contact-list :global(.whatsapp-icon) {
    color: #25d366;
  }
  .contact-list a {
    color: #aaa;
    text-decoration: none;
    transition: color 0.3s;
  }
  .contact-list a:hover {
    color: #25d366;
  }
  .footer-social {
    display: flex;
    gap: 10px;
    margin-top: 20px;
  }
  .footer-social a {
    width: 36px;
    height: 36px;
    background: rgba(255,255,255,0.1);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    text-decoration: none;
    transition: background 0.3s;
  }
  .footer-social a:hover {
    background: #c0392b;
  }
  .footer-bottom {
    background: #111;
    text-align: center;
    padding: 15px 0;
    color: #777;
    font-size: 13px;
  }
  .footer-bottom p {
    margin: 0 0 5px 0;
  }
  .footer-bottom .created-by {
    color: #008080;
    text-decoration: none;
    transition: color 0.3s;
  }
  .footer-bottom .created-by:hover {
    color: #00a0a0;
  }

  @media (max-width: 768px) {
    .footer-container {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 480px) {
    .footer-container {
      grid-template-columns: 1fr;
    }
  }
</style>
