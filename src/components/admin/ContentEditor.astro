---
import ImageUploader from "./ImageUploader.astro";
import { EQUIPMENT_CATEGORIES } from "../../lib/categories";

interface Props {
  type: "products" | "blog";
  title: string;
  itemLabel: string;
  titleLabel: string;
  excerptLabel: string;
}

const { type, title, itemLabel, titleLabel, excerptLabel } = Astro.props;
---
<section class="editor-shell" data-content-editor data-type={type}>
  <div class="editor-header">
    <div>
      <h1>{title}</h1>
      <p>Create, edit and delete live {itemLabel.toLowerCase()} entries.</p>
      <p class="editor-help">Select an image and click Save. Compression and upload happen automatically.</p>
    </div>
    <button type="button" class="logout-btn" data-logout-btn>Logout</button>
  </div>

  <div class="editor-grid">
    <form class="editor-form" data-form>
      <input type="hidden" name="id" data-id />
      <div class="field">
        <label>{titleLabel}</label>
        <input type="text" name="title" required data-title />
      </div>
      <div class="field">
        <label>Slug</label>
        <input type="text" name="slug" data-slug />
      </div>
      {type === 'products' && (
        <>
          <div class="field">
            <label>Category *</label>
            <select name="category" data-category required>
              <option value="" disabled selected>-- Select a Category --</option>
              {EQUIPMENT_CATEGORIES.map((cat) => (
                <option value={cat.value}>{cat.value}</option>
              ))}
            </select>
          </div>
          <div class="field">
            <label>Brand</label>
            <input type="text" name="brand" placeholder="e.g. Yanmar, Daihatsu" data-brand list="brand-list" />
            <datalist id="brand-list"></datalist>
          </div>
          <div class="field">
            <label>Model</label>
            <input type="text" name="model_number" placeholder="e.g. 6EY18AL" data-model />
          </div>
        </>
      )}
      <div class="field">
        <label>{excerptLabel}</label>
        <textarea name="excerpt" rows="3" data-excerpt></textarea>
      </div>
      <div class="field">
        <label>Details</label>
        <textarea name="content" rows="10" data-content></textarea>
      </div>
      <ImageUploader label="Featured Image" />
      <div class="preview" data-preview></div>
      <div class="actions">
        <button type="submit" class="save-btn">Save</button>
        <button type="button" class="secondary-btn" data-reset-btn>Reset</button>
      </div>
      <p class="form-status" data-form-status></p>
    </form>

    <div class="editor-list">
      <h2>Live {itemLabel}</h2>
      <div class="items" data-items></div>
      <div class="pagination" data-pagination></div>
    </div>
  </div>
</section>

<script define:vars={{ type, itemLabel }}>
  const editor = document.querySelector(`[data-content-editor][data-type="${type}"]`);

  if (editor) {
    const esc = (str) => {
      const d = document.createElement("div");
      d.textContent = str ?? "";
      return d.innerHTML;
    };

    const endpoint = `/api/${type}`;
    const form = editor.querySelector("[data-form]");
    const itemsEl = editor.querySelector("[data-items]");
    const paginationEl = editor.querySelector("[data-pagination]");
    const statusEl = editor.querySelector("[data-form-status]");
    const previewEl = editor.querySelector("[data-preview]");
    const logoutBtn = editor.querySelector("[data-logout-btn]");
    const resetBtn = editor.querySelector("[data-reset-btn]");
    const imageRemoveBtn = editor.querySelector("[data-image-remove-btn]");
    const uploadStatus = editor.querySelector("[data-upload-status]");
    const imageInput = editor.querySelector("[data-image-input]");
    const imageUrlInput = editor.querySelector("[data-image-url]");
    const imageKeyInput = editor.querySelector("[data-image-key]");
    let selectedFile = null;
    let selectedPreviewUrl = "";
    let existingImageUrl = "";
    let existingImageKey = "";
    let imageRemoved = false;

    let currentPage = 1;
    const PAGE_SIZE = 20;
    let totalPages = 1;

    const clearPreviewUrl = () => {
      if (selectedPreviewUrl) {
        URL.revokeObjectURL(selectedPreviewUrl);
        selectedPreviewUrl = "";
      }
    };

    const setExistingImageState = (url, key) => {
      existingImageUrl = url ?? "";
      existingImageKey = key ?? "";
    };

    const drawPreview = (url) => {
      if (url) {
        const img = document.createElement("img");
        img.src = url;
        img.alt = "";
        img.style.cssText = "width:100%;max-width:260px;border-radius:12px;display:block;";
        previewEl.replaceChildren(img);
      } else {
        previewEl.replaceChildren();
      }
    };

    const resetForm = () => {
      form.reset();
      form.querySelector("[data-id]").value = "";
      clearPreviewUrl();
      selectedFile = null;
      imageRemoved = false;
      setExistingImageState("", "");
      imageUrlInput.value = "";
      imageKeyInput.value = "";
      if (imageInput) {
        imageInput.value = "";
      }
      statusEl.textContent = "";
      uploadStatus.textContent = "";
      drawPreview("");
    };

    const fillForm = (item) => {
      form.querySelector("[data-id]").value = item.id;
      form.querySelector("[data-title]").value = item.title;
      form.querySelector("[data-slug]").value = item.slug;
      if (type === 'products') {
        const categoryEl = editor.querySelector("[data-category]");
        if (categoryEl) categoryEl.value = item.category || '';
        const brandEl = editor.querySelector("[data-brand]");
        if (brandEl) brandEl.value = item.brand || '';
        const modelEl = editor.querySelector("[data-model]");
        if (modelEl) modelEl.value = item.model_number || '';
      }
      form.querySelector("[data-excerpt]").value = item.excerpt;
      form.querySelector("[data-content]").value = item.content;
      clearPreviewUrl();
      selectedFile = null;
      imageRemoved = false;
      setExistingImageState(item.imageUrl || "", item.imageKey || "");
      imageUrlInput.value = item.imageUrl || "";
      imageKeyInput.value = item.imageKey || "";
      if (imageInput) {
        imageInput.value = "";
      }
      drawPreview(existingImageUrl);
      uploadStatus.textContent = "";
      statusEl.textContent = "";
      window.scrollTo({ top: 0, behavior: "smooth" });
    };

    const renderItems = (items) => {
      itemsEl.innerHTML = items.map((item) => `
        <article class="item-card">
          ${item.imageUrl ? `<img src="${esc(item.imageUrl)}" alt="" />` : ""}
          <div class="item-card-body">
            <h3>${esc(item.title)}</h3>
            ${type === 'products' ? `
              <small style="display:inline-block;background:#eee;padding:2px 6px;border-radius:4px;margin-bottom:6px;">${esc(item.category || 'Uncategorized')}</small>
              ${item.brand ? `<small style="display:inline-block;background:#e67e22;color:#fff;padding:2px 6px;border-radius:4px;margin-bottom:6px;">${esc(item.brand)}</small>` : ''}
              ${item.model_number ? `<small style="display:inline-block;background:#34495e;color:#fff;padding:2px 6px;border-radius:4px;margin-bottom:6px;">${esc(item.model_number)}</small>` : ''}
            ` : ""}
            <p>${esc(item.excerpt || "")}</p>
            <small>${esc(item.slug)}</small>
            <div class="item-actions">
              <button type="button" data-edit-id="${esc(item.id)}">Edit</button>
              <button type="button" data-delete-id="${esc(item.id)}">Delete</button>
            </div>
          </div>
        </article>
      `).join("");

      itemsEl.querySelectorAll("[data-edit-id]").forEach((button) => {
        button.addEventListener("click", () => {
          const item = items.find((entry) => entry.id === button.getAttribute("data-edit-id"));
          if (item) fillForm(item);
        });
      });

      itemsEl.querySelectorAll("[data-delete-id]").forEach((button) => {
        button.addEventListener("click", async () => {
          const id = button.getAttribute("data-delete-id");
          if (!id || !confirm(`Delete this ${itemLabel.toLowerCase()}?`)) return;

          const response = await fetch(`${endpoint}/${id}`, { method: "DELETE" });
          if (response.ok) {
            await loadItems();
            resetForm();
          }
        });
      });
    };

    function renderPagination() {
      if (totalPages <= 1) {
        paginationEl.textContent = "";
        return;
      }

      paginationEl.textContent = "";

      const prevBtn = document.createElement("button");
      prevBtn.textContent = "Prev";
      prevBtn.disabled = currentPage === 1;
      prevBtn.addEventListener("click", () => goToPage(currentPage - 1));
      paginationEl.appendChild(prevBtn);

      const pages = getPageNumbers();
      pages.forEach((p) => {
        if (typeof p === "string") {
          const info = document.createElement("span");
          info.className = "page-info";
          info.textContent = "…";
          paginationEl.appendChild(info);
        } else {
          const btn = document.createElement("button");
          btn.textContent = String(p);
          if (p === currentPage) btn.style.fontWeight = "bold";
          btn.addEventListener("click", () => goToPage(p));
          paginationEl.appendChild(btn);
        }
      });

      const nextBtn = document.createElement("button");
      nextBtn.textContent = "Next";
      nextBtn.disabled = currentPage === totalPages;
      nextBtn.addEventListener("click", () => goToPage(currentPage + 1));
      paginationEl.appendChild(nextBtn);

      const info = document.createElement("span");
      info.className = "page-info";
      info.textContent = `Page ${currentPage} of ${totalPages}`;
      paginationEl.appendChild(info);
    }

    function getPageNumbers() {
      const pages = [1];
      if (totalPages <= 7) {
        for (let i = 2; i <= totalPages; i++) pages.push(i);
      } else {
        const start = Math.max(2, currentPage - 1);
        const end = Math.min(totalPages - 1, currentPage + 1);
        if (start > 2) pages.push("…");
        for (let i = start; i <= end; i++) pages.push(i);
        if (end < totalPages - 1) pages.push("…");
        pages.push(totalPages);
      }
      return pages;
    }

    function goToPage(page) {
      if (page < 1 || page > totalPages) return;
      currentPage = page;
      loadItems();
    }

    const loadItems = async () => {
      const params = new URLSearchParams({ page: String(currentPage), limit: String(PAGE_SIZE) });
      const response = await fetch(`${endpoint}?${params}`);
      const data = await response.json();
      const items = data.items || [];
      totalPages = data.totalPages || 1;
      currentPage = data.page || 1;
      renderItems(items);
      renderPagination();

      if (type === 'products') {
        const brandList = document.getElementById("brand-list");
        if (brandList) {
          const uniqueBrands = [...new Set(items.map((i) => i.brand).filter(Boolean))].sort();
          brandList.innerHTML = uniqueBrands.map((b) => `<option value="${esc(b)}">`).join("");
        }
      }
    };

    const compressImageToWebp = async (file) => {
      const bitmap = await createImageBitmap(file);
      const canvas = document.createElement("canvas");
      const maxWidth = 1600;
      const scale = Math.min(1, maxWidth / bitmap.width);
      canvas.width = Math.round(bitmap.width * scale);
      canvas.height = Math.round(bitmap.height * scale);

      const context = canvas.getContext("2d");
      context.drawImage(bitmap, 0, 0, canvas.width, canvas.height);

      const blob = await new Promise((resolve) =>
        canvas.toBlob(resolve, "image/webp", 0.82)
      );

      return new File([blob], `${file.name.replace(/\.[^.]+$/, "")}.webp`, {
        type: "image/webp"
      });
    };

    const uploadImage = async (file) => {
      const formData = new FormData();
      formData.append("file", file);

      const response = await fetch("/api/upload", {
        method: "POST",
        body: formData
      });

      if (!response.ok) {
        const data = await response.json().catch(() => null);
        throw new Error(data?.error || "Image upload failed.");
      }

      return response.json();
    };

    const deleteImageByKey = async (key) => {
      if (!key) {
        return;
      }

      await fetch("/api/upload/delete", {
        method: "POST",
        headers: {
          "Content-Type": "application/json"
        },
        body: JSON.stringify({ key })
      });
    };

    imageInput?.addEventListener("change", () => {
      const file = imageInput.files?.[0] ?? null;
      clearPreviewUrl();
      selectedFile = file;
      imageRemoved = false;

      if (file) {
        selectedPreviewUrl = URL.createObjectURL(file);
        drawPreview(selectedPreviewUrl);
        uploadStatus.textContent = "Image selected. It will be compressed and uploaded when you save.";
      } else {
        drawPreview(existingImageUrl);
        uploadStatus.textContent = "";
      }
    });

    imageRemoveBtn?.addEventListener("click", () => {
      clearPreviewUrl();
      selectedFile = null;
      imageRemoved = true;

      if (imageInput) {
        imageInput.value = "";
      }

      imageUrlInput.value = "";
      imageKeyInput.value = "";
      drawPreview("");
      uploadStatus.textContent = "Image will be removed when you save.";
    });

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      statusEl.textContent = "Saving...";
      let nextImageUrl = existingImageUrl;
      let nextImageKey = existingImageKey;
      let uploadedKeyToRollback = "";

      try {
        if (selectedFile) {
          uploadStatus.textContent = "Compressing image...";
          const compressed = await compressImageToWebp(selectedFile);
          uploadStatus.textContent = "Uploading image...";
          const uploaded = await uploadImage(compressed);
          nextImageUrl = uploaded.url || "";
          nextImageKey = uploaded.key || "";
          uploadedKeyToRollback = nextImageKey;
        }

        if (imageRemoved) {
          nextImageUrl = "";
          nextImageKey = "";
        }

        const payload = {
          title: form.querySelector("[data-title]").value,
          slug: form.querySelector("[data-slug]").value,
          excerpt: form.querySelector("[data-excerpt]").value,
          content: form.querySelector("[data-content]").value,
          imageUrl: nextImageUrl,
          imageKey: nextImageKey,
          ...(type === 'products' ? {
            category: form.querySelector("[data-category]")?.value || "",
            brand: form.querySelector("[data-brand]")?.value || "",
            model_number: form.querySelector("[data-model]")?.value || ""
          } : {})
        };

        const id = form.querySelector("[data-id]").value;
        const response = await fetch(id ? `${endpoint}/${id}` : endpoint, {
          method: id ? "PUT" : "POST",
          headers: {
            "Content-Type": "application/json"
          },
          body: JSON.stringify(payload)
        });

        if (!response.ok) {
          const data = await response.json().catch(() => null);
          throw new Error(data?.error || "Save failed.");
        }

        const shouldDeleteOldImage =
          Boolean(existingImageKey) &&
          existingImageKey !== nextImageKey &&
          (Boolean(selectedFile) || imageRemoved);

        if (shouldDeleteOldImage) {
          await deleteImageByKey(existingImageKey);
        }

        setExistingImageState(nextImageUrl, nextImageKey);
        imageUrlInput.value = nextImageUrl;
        imageKeyInput.value = nextImageKey;
        clearPreviewUrl();
        selectedFile = null;
        imageRemoved = false;
        if (imageInput) {
          imageInput.value = "";
        }
        uploadStatus.textContent = "";
        statusEl.textContent = "Saved and live.";
        await loadItems();
        resetForm();
      } catch (error) {
        if (uploadedKeyToRollback) {
          await deleteImageByKey(uploadedKeyToRollback);
        }
        uploadStatus.textContent = "";
        statusEl.textContent = error instanceof Error ? error.message : "Save failed.";
      }
    });

    logoutBtn?.addEventListener("click", async () => {
      await fetch("/api/auth/logout", { method: "POST" });
      window.location.href = "/admin/login";
    });

    resetBtn?.addEventListener("click", resetForm);
    loadItems();
  }
</script>

<style>
  .editor-shell h1 {
    margin-bottom: 8px;
  }
  .editor-shell p {
    margin-top: 0;
    color: #666;
  }
  .editor-help {
    margin-top: 6px;
    font-size: 14px;
  }
  .editor-header {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    align-items: center;
    margin-bottom: 28px;
  }
  .logout-btn,
  .save-btn,
  .secondary-btn,
  :global(.item-actions button) {
    border: none;
    cursor: pointer;
    border-radius: 8px;
    padding: 10px 14px;
    font-weight: 700;
  }
  .logout-btn,
  .secondary-btn,
  :global(.item-actions button) {
    background: #ececec;
  }
  .save-btn {
    background: #c78f40;
    color: #111;
  }
  .editor-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(320px, 0.9fr);
    gap: 24px;
    align-items: start;
  }
  .editor-form,
  .editor-list {
    background: #fff;
    padding: 24px;
    border-radius: 18px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
  }
  .field {
    display: grid;
    gap: 8px;
    margin-bottom: 16px;
  }
  .field input,
  .field textarea,
  .field select {
    width: 100%;
    border: 1px solid #ddd;
    border-radius: 10px;
    padding: 12px 14px;
    font: inherit;
  }
  .actions {
    display: flex;
    gap: 10px;
    margin-top: 18px;
  }
  .form-status {
    margin: 14px 0 0;
    color: #666;
  }
  :global(.items) {
    display: grid;
    gap: 14px;
  }
  :global(.item-card) {
    display: grid;
    grid-template-columns: 90px 1fr;
    gap: 12px;
    background: #fafafa;
    border-radius: 14px;
    overflow: hidden;
  }
  :global(.item-card img) {
    width: 100%;
    height: 100%;
    min-height: 90px;
    object-fit: cover;
  }
  :global(.item-card-body) {
    padding: 12px 12px 12px 0;
  }
  :global(.item-card-body h3) {
    margin: 0 0 6px;
    font-size: 18px;
  }
  :global(.item-card-body p) {
    margin: 0 0 8px;
    font-size: 14px;
  }
  :global(.item-card-body small) {
    color: #888;
  }
  :global(.item-actions) {
    display: flex;
    gap: 8px;
    margin-top: 10px;
  }
  @media (max-width: 980px) {
    .editor-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 600px) {
    .editor-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }
    .editor-form,
    .editor-list {
      padding: 18px;
    }
    .actions {
      flex-direction: column;
      align-items: stretch;
    }
    :global(.item-card) {
      grid-template-columns: 1fr;
    }
    :global(.item-card img) {
      height: 160px;
      border-radius: 14px 14px 0 0;
    }
    :global(.item-card-body) {
      padding: 14px;
    }
  }
  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    margin-top: 20px;
    flex-wrap: wrap;
  }
  .pagination button {
    padding: 8px 14px;
    border: 1px solid #ddd;
    background: #fff;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
  }
  .pagination button:hover:not(:disabled) {
    background: #f0f0f0;
  }
  .pagination button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
  .pagination .page-info {
    padding: 8px 12px;
    color: #666;
    font-size: 14px;
  }
</style>
