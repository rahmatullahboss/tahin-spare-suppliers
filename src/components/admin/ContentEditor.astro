---
import ImageUploader from "./ImageUploader.astro";
import TiptapEditor from "../TiptapEditor.astro";
import { mergeCategories, type DisplayCategory } from "../../lib/categories";

interface Props {
  type: "products" | "blog";
  title: string;
  itemLabel: string;
  titleLabel: string;
  excerptLabel: string;
  categories?: DisplayCategory[];
  subcategories?: { id: string; name: string; parentId: string }[];
  brands?: { id: string; name: string }[];
}

const { type, title, itemLabel, titleLabel, excerptLabel, categories = [], subcategories = [], brands = [] } = Astro.props;
const categoryOptions = categories.length > 0 ? categories : mergeCategories();
---
<section class="editor-shell" data-content-editor data-type={type}>
  <div class="editor-header">
    <div>
      <h1>{title}</h1>
      <p>Create, edit and delete {itemLabel.toLowerCase()} entries.</p>
    </div>
    <div class="header-actions">
      <button type="button" class="btn-logout" data-logout-btn>Logout</button>
    </div>
  </div>

  <div class="editor-grid">
    <div class="editor-list">
      <div class="list-toolbar">
        <div class="search-wrap">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="search-icon"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
          <input type="text" class="search-input" data-search placeholder="Search..." />
        </div>
        <span class="list-count" data-count>0</span>
      </div>
      <div class="items-container">
        <table class="items-table">
          <thead>
            <tr>
              <th class="col-img"></th>
              <th class="col-title">{titleLabel}</th>
              {type === 'products' && <th class="col-cat">Category</th>}
              {type === 'products' && <th class="col-brand">Brand</th>}
              <th class="col-actions">Actions</th>
            </tr>
          </thead>
          <tbody data-items>
            <tr><td colspan="5" class="empty-row">Loading...</td></tr>
          </tbody>
        </table>
      </div>
      <div class="pagination" data-pagination></div>
    </div>

    <form class="editor-form" data-form>
      <div class="form-panel">
        <div class="form-panel-header">
          <h2>{type === "products" ? "Equipment Details" : "Post Details"}</h2>
        </div>
        <input type="hidden" name="id" data-id />
        <div class="field">
          <label>{titleLabel} *</label>
          <input type="text" name="title" required data-title placeholder={`Enter ${titleLabel.toLowerCase()}`} />
        </div>
        <div class="field">
          <label>SEO URL / Slug</label>
          <input type="text" name="slug" data-slug placeholder="auto-generated from product name if empty" />
        </div>
        {type === 'products' && (
          <>
            <div class="field">
              <label>Category *</label>
              <select name="category" data-category required>
                <option value="" disabled selected>-- Select --</option>
                {categoryOptions.map((cat) => (
                  <option value={cat.canonicalValue}>{cat.value}</option>
                ))}
              </select>
            </div>
            <div class="field" data-subcategory-field style="display: none;">
              <label>Subcategory</label>
              <select name="subcategory" data-subcategory>
                <option value="">-- None --</option>
              </select>
            </div>
            <div class="field additional-categories-field">
              <label>Additional Categories</label>
              <div class="additional-categories" data-additional-categories></div>
              <button type="button" class="btn-add-category" data-additional-category-add>+ Add another category</button>
              <small class="field-hint">Use this when the same product should appear in more than one category. Repeating the primary category is ignored.</small>
            </div>
            <div class="field-row">
              <div class="field">
                <label>Brand</label>
                <input type="text" name="brand" placeholder="Select or type a new brand" data-brand list="brand-options" />
                <datalist id="brand-options">
                  {brands.map((brand) => (
                    <option value={brand.name}></option>
                  ))}
                </datalist>
                <small class="field-hint">New names are added to the canonical brand list on save. <a href="/admin/brands">Manage brand names & logos</a></small>
              </div>
              <div class="field">
                <label>Model</label>
                <input type="text" name="model_number" placeholder="e.g. VTA-28" data-model />
              </div>
            </div>
            <div class="field-row">
              <div class="field">
                <label>Part Number</label>
                <input type="text" name="part_number" placeholder="OEM / manufacturer part number" data-part-number />
              </div>
              <div class="field">
                <label>Condition</label>
                <input type="text" name="condition" placeholder="e.g. Reconditioned, Used, New" data-condition />
              </div>
            </div>
            <div class="field-row">
              <div class="field">
                <label>Availability</label>
                <input type="text" name="availability" placeholder="e.g. Verified in Stock / Sold / Contact for availability" data-availability />
              </div>
              <div class="field">
                <label>Location</label>
                <input type="text" name="location" value="Chattogram, Bangladesh" data-location />
              </div>
            </div>
            <div class="field-row">
              <div class="field">
                <label>Condition Verified Date</label>
                <input type="date" name="conditionVerifiedAt" data-condition-verified-at />
                <small class="field-hint">Set only when the listed condition was actually checked.</small>
              </div>
              <div class="field">
                <label>Availability Verified Date</label>
                <input type="date" name="availabilityVerifiedAt" data-availability-verified-at />
                <small class="field-hint">Positive stock claims become “Contact to confirm” after the freshness window unless re-verified.</small>
              </div>
            </div>
            <div class="field">
              <label>Application</label>
              <textarea name="application" rows="2" data-application placeholder="Vessel type, engine application, compatible system, etc."></textarea>
            </div>
            <div class="field">
              <label>Technical Specifications</label>
              <textarea name="technicalSpecifications" rows="5" data-technical-specifications placeholder="Power, RPM, bore/stroke, dimensions, serial details, compatible models, etc."></textarea>
            </div>
          </>
        )}
        <div class="field">
          <label>{excerptLabel}</label>
          <textarea name="excerpt" rows="3" data-excerpt placeholder={`Enter ${excerptLabel.toLowerCase()}`}></textarea>
        </div>
        <div class="field">
          <label>Details</label>
          <TiptapEditor id={type === 'blog' ? 'blog-editor' : 'product-editor'} placeholder={type === 'blog' ? 'Write your blog post...' : 'Enter full details...'} />
        </div>
        {type === 'products' && (
          <div class="seo-settings">
            <div class="seo-settings-header">
              <div>
                <h3>Search Engine Optimization</h3>
                <p>Leave any SEO field blank to use safe defaults, or generate them now and edit.</p>
              </div>
              <button type="button" class="btn-seo-defaults" data-generate-seo>Generate SEO Defaults</button>
            </div>
            <div class="field">
              <label>SEO Title</label>
              <input type="text" name="seoTitle" maxlength="120" data-seo-title placeholder="e.g. Cummins VTA-28 Marine Engine for Sale | Tahin Spare Suppliers" />
            </div>
            <div class="field">
              <label>Meta Description</label>
              <textarea name="metaDescription" rows="3" maxlength="320" data-meta-description placeholder="Unique buyer-focused search description"></textarea>
            </div>
            <div class="field-row">
              <div class="field">
                <label>Focus Keyword</label>
                <input type="text" name="focusKeyword" data-focus-keyword placeholder="e.g. Cummins VTA-28 Marine Engine" />
              </div>
              <div class="field">
                <label>Image ALT Text</label>
                <input type="text" name="imageAlt" data-image-alt placeholder="Describe the real product photo" />
              </div>
            </div>
            <div class="field">
              <label>Related Products</label>
              <input type="text" name="relatedProducts" data-related-products placeholder="product-slug-one, product-slug-two" />
              <small class="field-hint">Enter product slugs separated by commas. If blank, the site can suggest same-brand/category products.</small>
            </div>
          </div>
        )}
        <ImageUploader label="Featured Image" />
        <div class="preview" data-preview></div>
        <div class="gallery-uploader">
          <div class="gallery-uploader-heading">
            <div>
              <label for={`${type}-gallery-input`}>Additional Images</label>
              <small>Add up to 12 product/post photos. They are compressed to WebP and stored in R2.</small>
            </div>
            <label class="gallery-add-btn" for={`${type}-gallery-input`}>+ Add photos</label>
          </div>
          <input id={`${type}-gallery-input`} type="file" accept="image/*" multiple data-gallery-input hidden />
          <div class="gallery-list" data-gallery-list></div>
          <p class="gallery-status" data-gallery-status></p>
        </div>
        <div class="actions">
          <button type="submit" class="btn-save">Save</button>
          <button type="button" class="btn-reset" data-reset-btn>Reset</button>
        </div>
        <p class="form-status" data-form-status></p>
      </div>
    </form>
  </div>
</section>

<script define:vars={{ type, itemLabel, subcategories, categoryOptions }}>
  const editor = document.querySelector(`[data-content-editor][data-type="${type}"]`);

  if (editor) {
    const esc = (str) => {
      const d = document.createElement("div");
      d.textContent = str ?? "";
      return d.innerHTML;
    };

    const endpoint = `/api/${type}`;
    const form = editor.querySelector("[data-form]");
    const itemsEl = editor.querySelector("[data-items]");
    const paginationEl = editor.querySelector("[data-pagination]");
    const statusEl = editor.querySelector("[data-form-status]");
    const previewEl = editor.querySelector("[data-preview]");
    const logoutBtn = editor.querySelector("[data-logout-btn]");
    const resetBtn = editor.querySelector("[data-reset-btn]");
    const imageRemoveBtn = editor.querySelector("[data-image-remove-btn]");
    const uploadStatus = editor.querySelector("[data-upload-status]");
    const imageInput = editor.querySelector("[data-image-input]");
    const imageUrlInput = editor.querySelector("[data-image-url]");
    const imageKeyInput = editor.querySelector("[data-image-key]");
    const galleryInput = editor.querySelector("[data-gallery-input]");
    const galleryList = editor.querySelector("[data-gallery-list]");
    const galleryStatus = editor.querySelector("[data-gallery-status]");
    const countEl = editor.querySelector("[data-count]");
    const searchInput = editor.querySelector("[data-search]");
    const additionalCategoriesEl = editor.querySelector("[data-additional-categories]");
    const additionalCategoryAddBtn = editor.querySelector("[data-additional-category-add]");
    let selectedFile = null;
    let selectedPreviewUrl = "";
    let existingImageUrl = "";
    let existingImageKey = "";
    let imageRemoved = false;
    let galleryItems = [];
    const MAX_GALLERY_IMAGES = 12;
    let allItems = [];

    let currentPage = 1;
    const PAGE_SIZE = 20;
    let totalPages = 1;
    let searchQuery = "";

    const clearPreviewUrl = () => {
      if (selectedPreviewUrl) {
        URL.revokeObjectURL(selectedPreviewUrl);
        selectedPreviewUrl = "";
      }
    };

    const setExistingImageState = (url, key) => {
      existingImageUrl = url ?? "";
      existingImageKey = key ?? "";
    };

    const drawPreview = (url) => {
      if (url) {
        const img = document.createElement("img");
        img.src = url;
        img.alt = "";
        img.style.cssText = "width:100%;max-width:260px;border-radius:12px;display:block;";
        previewEl.replaceChildren(img);
      } else {
        previewEl.replaceChildren();
      }
    };

    const clearGalleryPreviewUrls = () => {
      galleryItems.forEach((item) => {
        if (item.kind === "pending" && item.previewUrl) URL.revokeObjectURL(item.previewUrl);
      });
    };

    const renderGallery = () => {
      if (!galleryList) return;
      galleryList.replaceChildren();
      if (galleryItems.length === 0) {
        const empty = document.createElement("p");
        empty.className = "gallery-empty";
        empty.textContent = "No additional images yet.";
        galleryList.appendChild(empty);
        return;
      }

      galleryItems.forEach((item, index) => {
        const card = document.createElement("div");
        card.className = "gallery-item";

        const image = document.createElement("img");
        image.src = item.kind === "pending" ? item.previewUrl : item.url;
        image.alt = item.alt || `${itemLabel} image ${index + 1}`;
        card.appendChild(image);

        const meta = document.createElement("div");
        meta.className = "gallery-item-meta";
        const altInput = document.createElement("input");
        altInput.type = "text";
        altInput.placeholder = "Image ALT text";
        altInput.value = item.alt || "";
        altInput.dataset.galleryAlt = String(index);
        meta.appendChild(altInput);

        const actions = document.createElement("div");
        actions.className = "gallery-item-actions";
        const up = document.createElement("button");
        up.type = "button";
        up.textContent = "↑";
        up.title = "Move up";
        up.disabled = index === 0;
        up.dataset.galleryAction = "up";
        up.dataset.galleryIndex = String(index);
        const down = document.createElement("button");
        down.type = "button";
        down.textContent = "↓";
        down.title = "Move down";
        down.disabled = index === galleryItems.length - 1;
        down.dataset.galleryAction = "down";
        down.dataset.galleryIndex = String(index);
        const remove = document.createElement("button");
        remove.type = "button";
        remove.textContent = "Remove";
        remove.className = "gallery-remove";
        remove.dataset.galleryAction = "remove";
        remove.dataset.galleryIndex = String(index);
        actions.append(up, down, remove);
        meta.appendChild(actions);
        card.appendChild(meta);
        galleryList.appendChild(card);
      });
    };

    galleryList?.addEventListener("input", (event) => {
      const target = event.target;
      if (!(target instanceof HTMLInputElement)) return;
      const index = Number(target.dataset.galleryAlt);
      if (!Number.isInteger(index) || !galleryItems[index]) return;
      galleryItems[index].alt = target.value;
    });

    galleryList?.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const button = target.closest("[data-gallery-action]");
      if (!(button instanceof HTMLButtonElement)) return;
      const index = Number(button.dataset.galleryIndex);
      if (!Number.isInteger(index) || !galleryItems[index]) return;
      const action = button.dataset.galleryAction;

      if (action === "remove") {
        const item = galleryItems[index];
        if (item.kind === "pending" && item.previewUrl) URL.revokeObjectURL(item.previewUrl);
        galleryItems.splice(index, 1);
      } else if (action === "up" && index > 0) {
        [galleryItems[index - 1], galleryItems[index]] = [galleryItems[index], galleryItems[index - 1]];
      } else if (action === "down" && index < galleryItems.length - 1) {
        [galleryItems[index + 1], galleryItems[index]] = [galleryItems[index], galleryItems[index + 1]];
      }
      renderGallery();
    });

    galleryInput?.addEventListener("change", () => {
      const files = Array.from(galleryInput.files ?? []);
      galleryInput.value = "";
      const remaining = Math.max(0, MAX_GALLERY_IMAGES - galleryItems.length);
      const accepted = files.filter((file) => file.type.startsWith("image/")).slice(0, remaining);
      accepted.forEach((file) => {
        galleryItems.push({
          kind: "pending",
          file,
          previewUrl: URL.createObjectURL(file),
          alt: "",
        });
      });
      if (galleryStatus) {
        galleryStatus.textContent = files.length > accepted.length
          ? `Added ${accepted.length}. Maximum ${MAX_GALLERY_IMAGES} additional images are allowed.`
          : `${galleryItems.length} additional image${galleryItems.length === 1 ? "" : "s"} ready.`;
      }
      renderGallery();
    });

    const resetForm = () => {
      form.reset();
      const tiptapWrapper = editor.querySelector("[data-tiptap-wrapper]");
      const tiptapEditor = tiptapWrapper?.__tiptapEditor;
      if (tiptapEditor) {
        tiptapEditor.commands.clearContent();
      }
      const outputInput = editor.querySelector("[data-tiptap-output]");
      if (outputInput) outputInput.value = "";
      form.querySelector("[data-id]").value = "";
      clearPreviewUrl();
      selectedFile = null;
      imageRemoved = false;
      setExistingImageState("", "");
      imageUrlInput.value = "";
      imageKeyInput.value = "";
      if (imageInput) { imageInput.value = ""; }
      clearGalleryPreviewUrls();
      galleryItems = [];
      if (galleryInput) galleryInput.value = "";
      if (galleryStatus) galleryStatus.textContent = "";
      renderGallery();
      statusEl.textContent = "";
      // Reset subcategory field
      if (subcategoryField) subcategoryField.style.display = "none";
      if (subcategorySelect) {
        while (subcategorySelect.options.length > 1) {
          subcategorySelect.remove(1);
        }
      }
      if (type === 'products') renderAdditionalCategories([]);
      if (uploadStatus) uploadStatus.textContent = "";
      drawPreview("");
    };

    const fillForm = (item) => {
      form.querySelector("[data-id]").value = item.id;
      form.querySelector("[data-title]").value = item.title;
      form.querySelector("[data-slug]").value = item.slug;
      if (type === 'products') {
        const categoryEl = editor.querySelector("[data-category]");
        if (categoryEl) categoryEl.value = item.category || '';
        updateSubcategoryDropdown();
        setTimeout(() => {
          const subcategoryEl = editor.querySelector("[data-subcategory]");
          if (subcategoryEl && item.subcategory) {
            subcategoryEl.value = item.subcategory;
          }
        }, 50);
        renderAdditionalCategories(Array.isArray(item.additionalCategories) ? item.additionalCategories : []);
        const brandEl = editor.querySelector("[data-brand]");
        if (brandEl) brandEl.value = item.brand || '';
        const modelEl = editor.querySelector("[data-model]");
        if (modelEl) modelEl.value = item.model_number || '';
        const partNumberEl = editor.querySelector("[data-part-number]");
        if (partNumberEl) partNumberEl.value = item.partNumber || '';
        const conditionEl = editor.querySelector("[data-condition]");
        if (conditionEl) conditionEl.value = item.condition || '';
        const availabilityEl = editor.querySelector("[data-availability]");
        if (availabilityEl) availabilityEl.value = item.availability || '';
        const conditionVerifiedAtEl = editor.querySelector("[data-condition-verified-at]");
        if (conditionVerifiedAtEl) conditionVerifiedAtEl.value = item.conditionVerifiedAt || '';
        const availabilityVerifiedAtEl = editor.querySelector("[data-availability-verified-at]");
        if (availabilityVerifiedAtEl) availabilityVerifiedAtEl.value = item.availabilityVerifiedAt || '';
        const locationEl = editor.querySelector("[data-location]");
        if (locationEl) locationEl.value = item.location || 'Chattogram, Bangladesh';
        const applicationEl = editor.querySelector("[data-application]");
        if (applicationEl) applicationEl.value = item.application || '';
        const technicalSpecificationsEl = editor.querySelector("[data-technical-specifications]");
        if (technicalSpecificationsEl) technicalSpecificationsEl.value = item.technicalSpecifications || '';
        const seoTitleEl = editor.querySelector("[data-seo-title]");
        if (seoTitleEl) seoTitleEl.value = item.seoTitle || '';
        const metaDescriptionEl = editor.querySelector("[data-meta-description]");
        if (metaDescriptionEl) metaDescriptionEl.value = item.metaDescription || '';
        const focusKeywordEl = editor.querySelector("[data-focus-keyword]");
        if (focusKeywordEl) focusKeywordEl.value = item.focusKeyword || '';
        const imageAltEl = editor.querySelector("[data-image-alt]");
        if (imageAltEl) imageAltEl.value = item.imageAlt || '';
        const relatedProductsEl = editor.querySelector("[data-related-products]");
        if (relatedProductsEl) relatedProductsEl.value = Array.isArray(item.relatedProducts) ? item.relatedProducts.join(', ') : '';
      }
      form.querySelector("[data-excerpt]").value = item.excerpt;
      const tiptapWrapper = editor.querySelector("[data-tiptap-wrapper]");
      const tiptapEditor = tiptapWrapper?.__tiptapEditor;
      if (tiptapEditor) {
        tiptapEditor.commands.setContent(item.content || "");
      }
      const outputInput = editor.querySelector("[data-tiptap-output]");
      if (outputInput) outputInput.value = item.content || "";
      clearPreviewUrl();
      selectedFile = null;
      imageRemoved = false;
      setExistingImageState(item.imageUrl || "", item.imageKey || "");
      imageUrlInput.value = item.imageUrl || "";
      imageKeyInput.value = item.imageKey || "";
      if (imageInput) { imageInput.value = ""; }
      clearGalleryPreviewUrls();
      galleryItems = Array.isArray(item.galleryImages)
        ? item.galleryImages.map((image) => ({
            kind: "existing",
            url: image.url || "",
            key: image.key || "",
            alt: image.alt || "",
          })).filter((image) => image.url)
        : [];
      if (galleryInput) galleryInput.value = "";
      if (galleryStatus) galleryStatus.textContent = "";
      renderGallery();
      drawPreview(existingImageUrl);
      if (uploadStatus) uploadStatus.textContent = "";
      statusEl.textContent = "";
      window.scrollTo({ top: 0, behavior: "smooth" });
    };

    const renderItems = (items) => {
      if (items.length === 0) {
        itemsEl.innerHTML = `<tr><td colspan="5" class="empty-row"><div class="empty-state"><div class="empty-icon">📦</div><h3>No ${itemLabel.toLowerCase()} found</h3><p>${searchQuery ? 'Try a different search' : 'Add your first entry using the form.'}</p></div></td></tr>`;
        return;
      }

      itemsEl.innerHTML = items.map((item) => {
        let imgHtml = '<div class="item-thumb-placeholder"></div>';
        if (item.imageUrl) {
          imgHtml = `<img src="${esc(item.imageUrl)}" alt="" />`;
        }
        let extraCols = '';
        if (type === 'products') {
          extraCols = `
            <td class="col-cat"><span class="badge badge-cat">${esc(item.category || '—')}</span></td>
            <td class="col-brand"><span class="badge badge-brand">${esc(item.brand || '—')}</span></td>
          `;
        }
        return `
          <tr class="item-row">
            <td class="col-img">${imgHtml}</td>
            <td class="col-title">
              <strong>${esc(item.title)}</strong>
              ${item.excerpt ? `<p class="item-excerpt">${esc(item.excerpt)}</p>` : ''}
              ${type === 'products' && item.model_number ? `<span class="badge badge-model">${esc(item.model_number)}</span>` : ''}
            </td>
            ${extraCols}
            <td class="col-actions">
              <button type="button" data-edit-id="${esc(item.id)}" class="btn-action btn-edit">Edit</button>
              <button type="button" data-delete-id="${esc(item.id)}" class="btn-action btn-delete">Delete</button>
            </td>
          </tr>
        `;
      }).join('');

      itemsEl.querySelectorAll("[data-edit-id]").forEach((button) => {
        button.addEventListener("click", () => {
          const item = allItems.find((entry) => entry.id === button.getAttribute("data-edit-id"));
          if (item) fillForm(item);
        });
      });

      itemsEl.querySelectorAll("[data-delete-id]").forEach((button) => {
        button.addEventListener("click", async () => {
          const id = button.getAttribute("data-delete-id");
          if (!id || !confirm(`Delete this ${itemLabel.toLowerCase()}?`)) return;
          const response = await fetch(`${endpoint}/${id}`, { method: "DELETE" });
          if (response.ok) {
            await loadItems();
            resetForm();
          }
        });
      });
    };

    function renderPagination() {
      if (totalPages <= 1) { paginationEl.textContent = ""; return; }
      paginationEl.textContent = "";

      const prevBtn = document.createElement("button");
      prevBtn.textContent = "← Prev";
      prevBtn.disabled = currentPage === 1;
      prevBtn.addEventListener("click", () => goToPage(currentPage - 1));
      paginationEl.appendChild(prevBtn);

      const pages = getPageNumbers();
      pages.forEach((p) => {
        if (typeof p === "string") {
          const info = document.createElement("span");
          info.className = "page-info";
          info.textContent = "…";
          paginationEl.appendChild(info);
        } else {
          const btn = document.createElement("button");
          btn.textContent = String(p);
          if (p === currentPage) btn.dataset.active = "true";
          btn.addEventListener("click", () => goToPage(p));
          paginationEl.appendChild(btn);
        }
      });

      const nextBtn = document.createElement("button");
      nextBtn.textContent = "Next →";
      nextBtn.disabled = currentPage === totalPages;
      nextBtn.addEventListener("click", () => goToPage(currentPage + 1));
      paginationEl.appendChild(nextBtn);
    }

    function getPageNumbers() {
      const pages = [1];
      if (totalPages <= 7) {
        for (let i = 2; i <= totalPages; i++) pages.push(i);
      } else {
        const start = Math.max(2, currentPage - 1);
        const end = Math.min(totalPages - 1, currentPage + 1);
        if (start > 2) pages.push("…");
        for (let i = start; i <= end; i++) pages.push(i);
        if (end < totalPages - 1) pages.push("…");
        pages.push(totalPages);
      }
      return pages;
    }

    function goToPage(page) {
      if (page < 1 || page > totalPages) return;
      currentPage = page;
      renderCurrentPage();
    }

    function renderCurrentPage() {
      const start = (currentPage - 1) * PAGE_SIZE;
      const pageItems = allItems.slice(start, start + PAGE_SIZE);
      renderItems(pageItems);
      renderPagination();
    }

    const loadItems = async () => {
      try {
        const params = new URLSearchParams({ page: String(currentPage), limit: '500' });
        const response = await fetch(`${endpoint}?${params}`);
        if (!response.ok) {
          const row = document.createElement("tr");
          const td = document.createElement("td");
          td.colSpan = 5;
          td.className = "empty-row";
          td.textContent = `Failed to load (HTTP ${response.status})`;
          row.appendChild(td);
          itemsEl.replaceChildren(row);
          return;
        }
        const data = await response.json();
        allItems = data.items || [];
        totalPages = Math.ceil(allItems.length / PAGE_SIZE) || 1;
        if (currentPage > totalPages) currentPage = totalPages;
        renderCurrentPage();

        if (countEl) countEl.textContent = String(data.total || allItems.length);

      } catch (err) {
        console.error("loadItems failed:", err);
        const row = document.createElement("tr");
        const td = document.createElement("td");
        td.colSpan = 5;
        td.className = "empty-row";
        td.textContent = "Error loading items. Check console.";
        row.appendChild(td);
        itemsEl.replaceChildren(row);
      }
    };

    let searchTimeout;
    searchInput?.addEventListener("input", () => {
      clearTimeout(searchTimeout);
      searchTimeout = setTimeout(() => {
        searchQuery = searchInput.value.trim().toLowerCase();
        const filtered = allItems.filter(item => 
          item.title?.toLowerCase().includes(searchQuery) ||
          item.brand?.toLowerCase().includes(searchQuery) ||
          item.category?.toLowerCase().includes(searchQuery) ||
          item.model_number?.toLowerCase().includes(searchQuery) ||
          item.partNumber?.toLowerCase().includes(searchQuery)
        );
        currentPage = 1;
        totalPages = Math.ceil(filtered.length / PAGE_SIZE) || 1;
        const start = 0;
        const pageItems = filtered.slice(start, start + PAGE_SIZE);
        renderItems(pageItems);
        renderPagination();
        if (countEl) countEl.textContent = String(filtered.length);
      }, 250);
    });

    // Subcategory dropdown logic
    const categorySelect = editor.querySelector("[data-category]");
    const subcategoryField = editor.querySelector("[data-subcategory-field]");
    const subcategorySelect = editor.querySelector("[data-subcategory]");

    const updateSubcategoryDropdown = () => {
      if (!categorySelect || !subcategorySelect || !subcategoryField) return;
      const selectedCategory = categorySelect.value;

      // Find category ID from categoryOptions
      const categoryOption = categoryOptions?.find(c => (c.canonicalValue || c.value) === selectedCategory);
      const categoryId = categoryOption?.id;

      // Filter subcategories for this parent
      const subs = categoryId ? subcategories.filter(s => s.parentId === categoryId) : [];

      if (subs.length > 0) {
        subcategoryField.style.display = "";
        // Clear existing options
        while (subcategorySelect.options.length > 1) {
          subcategorySelect.remove(1);
        }
        // Add new options safely
        subs.forEach(s => {
          const option = document.createElement("option");
          option.value = s.name;
          option.textContent = s.name;
          subcategorySelect.appendChild(option);
        });
      } else {
        subcategoryField.style.display = "none";
        while (subcategorySelect.options.length > 1) {
          subcategorySelect.remove(1);
        }
      }
    };

    categorySelect?.addEventListener("change", updateSubcategoryDropdown);

    const canonicalCategoryValue = (category) => category?.canonicalValue || category?.value || "";
    const subcategoriesForCategory = (categoryValue) => {
      const categoryOption = categoryOptions?.find((category) => canonicalCategoryValue(category) === categoryValue);
      return categoryOption?.id ? subcategories.filter((subcategory) => subcategory.parentId === categoryOption.id) : [];
    };

    const createAdditionalCategoryRow = (assignment = {}) => {
      const row = document.createElement("div");
      row.className = "additional-category-row";
      row.dataset.additionalCategoryRow = "";

      const categoryInput = document.createElement("select");
      categoryInput.dataset.additionalCategory = "";
      const placeholder = document.createElement("option");
      placeholder.value = "";
      placeholder.textContent = "-- Select category --";
      categoryInput.appendChild(placeholder);
      categoryOptions.forEach((category) => {
        const option = document.createElement("option");
        option.value = canonicalCategoryValue(category);
        option.textContent = category.value;
        categoryInput.appendChild(option);
      });

      const subcategoryInput = document.createElement("select");
      subcategoryInput.dataset.additionalSubcategory = "";
      const removeButton = document.createElement("button");
      removeButton.type = "button";
      removeButton.className = "btn-remove-category";
      removeButton.textContent = "Remove";

      const refreshSubcategories = (selected = "") => {
        subcategoryInput.replaceChildren();
        const none = document.createElement("option");
        none.value = "";
        none.textContent = "-- No subcategory --";
        subcategoryInput.appendChild(none);
        const matches = subcategoriesForCategory(categoryInput.value);
        matches.forEach((subcategory) => {
          const option = document.createElement("option");
          option.value = subcategory.name;
          option.textContent = subcategory.name;
          subcategoryInput.appendChild(option);
        });
        subcategoryInput.disabled = matches.length === 0;
        if (selected && matches.some((subcategory) => subcategory.name === selected)) {
          subcategoryInput.value = selected;
        }
      };

      categoryInput.value = assignment.category || "";
      refreshSubcategories(assignment.subcategory || "");
      categoryInput.addEventListener("change", () => refreshSubcategories());
      removeButton.addEventListener("click", () => row.remove());
      row.append(categoryInput, subcategoryInput, removeButton);
      return row;
    };

    const renderAdditionalCategories = (assignments = []) => {
      if (!additionalCategoriesEl) return;
      additionalCategoriesEl.replaceChildren();
      assignments.forEach((assignment) => additionalCategoriesEl.appendChild(createAdditionalCategoryRow(assignment)));
    };

    const collectAdditionalCategories = () => {
      if (!additionalCategoriesEl) return [];
      return Array.from(additionalCategoriesEl.querySelectorAll("[data-additional-category-row]"))
        .map((row) => ({
          category: row.querySelector("[data-additional-category]")?.value?.trim() || "",
          subcategory: row.querySelector("[data-additional-subcategory]")?.value?.trim() || ""
        }))
        .filter((assignment) => assignment.category);
    };

    additionalCategoryAddBtn?.addEventListener("click", () => {
      additionalCategoriesEl?.appendChild(createAdditionalCategoryRow());
    });

    const truncateSeoText = (value, maxLength) => {
      const normalized = String(value || '').replace(/\s+/g, ' ').trim();
      if (normalized.length <= maxLength) return normalized;
      const slice = normalized.slice(0, maxLength - 1);
      const breakAt = slice.lastIndexOf(' ');
      return `${(breakAt > maxLength * 0.65 ? slice.slice(0, breakAt) : slice).trim()}…`;
    };

    const generateSeoDefaults = () => {
      if (type !== 'products') return;
      const title = form.querySelector("[data-title]")?.value?.trim() || '';
      if (!title) {
        statusEl.textContent = 'Enter the Product Name before generating SEO defaults.';
        return;
      }

      const model = form.querySelector("[data-model]")?.value?.trim() || '';
      const partNumber = form.querySelector("[data-part-number]")?.value?.trim() || '';
      const location = form.querySelector("[data-location]")?.value?.trim() || 'Bangladesh';
      const seoTitleEl = form.querySelector("[data-seo-title]");
      const metaDescriptionEl = form.querySelector("[data-meta-description]");
      const focusKeywordEl = form.querySelector("[data-focus-keyword]");
      const imageAltEl = form.querySelector("[data-image-alt]");

      if (seoTitleEl && !seoTitleEl.value.trim()) {
        const buyerTitle = /\bfor sale\b/i.test(title) ? title : `${title} for Sale`;
        seoTitleEl.value = truncateSeoText(`${buyerTitle} | Tahin Spare Suppliers`, 70);
      }
      if (metaDescriptionEl && !metaDescriptionEl.value.trim()) {
        metaDescriptionEl.value = truncateSeoText(`${title} available from Tahin Spare Suppliers, ${location}. Contact us for specifications, current availability, price and worldwide shipping.`, 160);
      }
      if (focusKeywordEl && !focusKeywordEl.value.trim()) {
        focusKeywordEl.value = title;
      }
      if (imageAltEl && !imageAltEl.value.trim()) {
        const identifiers = [model ? `model ${model}` : '', partNumber ? `part ${partNumber}` : ''].filter(Boolean);
        imageAltEl.value = identifiers.length ? `${title}, ${identifiers.join(', ')} product photo` : `${title} product photo`;
      }
      statusEl.textContent = 'SEO defaults generated. Review and edit before saving if needed.';
    };

    editor.querySelector("[data-generate-seo]")?.addEventListener("click", generateSeoDefaults);

    const normalizeIdentityCode = (value) => String(value || '').toLowerCase().replace(/[^a-z0-9]/g, '');
    const extractModelCodes = (value) => (String(value || '').match(/\b(?=[a-z0-9/-]{3,}\b)(?=[a-z0-9/-]*[a-z])(?=[a-z0-9/-]*\d)[a-z0-9]+(?:[-/][a-z0-9]+)*\b/gi) || []).map((raw) => {
      const normalized = normalizeIdentityCode(raw);
      const stem = normalized.match(/^([a-z]+)\d/)?.[1] || normalized.match(/^\d+([a-z]+)/)?.[1] || '';
      return { raw, normalized, stem };
    });
    const findProductIdentityConflict = () => {
      if (type !== 'products') return '';
      const modelCodes = extractModelCodes(form.querySelector("[data-model]")?.value || '');
      if (modelCodes.length === 0) return '';
      const fields = [
        ['slug', (form.querySelector("[data-slug]")?.value || '').replace(/-/g, ' ')],
        ['title', form.querySelector("[data-title]")?.value || ''],
        ['SEO title', form.querySelector("[data-seo-title]")?.value || ''],
        ['focus keyword', form.querySelector("[data-focus-keyword]")?.value || '']
      ];
      for (const modelCode of modelCodes) {
        for (const [fieldName, fieldValue] of fields) {
          if (!fieldValue || normalizeIdentityCode(fieldValue).includes(modelCode.normalized)) continue;
          const conflicting = extractModelCodes(fieldValue).find((candidate) => modelCode.stem && candidate.stem === modelCode.stem && candidate.normalized !== modelCode.normalized);
          if (conflicting) return `Model ${modelCode.raw} conflicts with ${fieldName} model ${conflicting.raw}.`;
        }
      }
      return '';
    };

    const compressImageToWebp = async (file) => {
      const bitmap = await createImageBitmap(file);
      const canvas = document.createElement("canvas");
      const maxWidth = 1600;
      const scale = Math.min(1, maxWidth / bitmap.width);
      canvas.width = Math.round(bitmap.width * scale);
      canvas.height = Math.round(bitmap.height * scale);
      const context = canvas.getContext("2d");
      context.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
      const blob = await new Promise((resolve) => canvas.toBlob(resolve, "image/webp", 0.82));
      return new File([blob], `${file.name.replace(/\.[^.]+$/, "")}.webp`, { type: "image/webp" });
    };

    const uploadImage = async (file) => {
      const formData = new FormData();
      formData.append("file", file);
      const response = await fetch("/api/upload", { method: "POST", body: formData });
      if (!response.ok) {
        const data = await response.json().catch(() => null);
        throw new Error(data?.error || "Image upload failed.");
      }
      return response.json();
    };

    const deleteImageByKey = async (key) => {
      if (!key) return;
      await fetch("/api/upload/delete", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ key }) });
    };

    imageInput?.addEventListener("change", () => {
      const file = imageInput.files?.[0] ?? null;
      clearPreviewUrl();
      selectedFile = file;
      imageRemoved = false;
      if (file) {
        selectedPreviewUrl = URL.createObjectURL(file);
        drawPreview(selectedPreviewUrl);
        if (uploadStatus) uploadStatus.textContent = "Image selected. Compressed & uploaded on save.";
      } else {
        drawPreview(existingImageUrl);
        if (uploadStatus) uploadStatus.textContent = "";
      }
    });

    imageRemoveBtn?.addEventListener("click", () => {
      clearPreviewUrl();
      selectedFile = null;
      imageRemoved = true;
      if (imageInput) { imageInput.value = ""; }
      imageUrlInput.value = "";
      imageKeyInput.value = "";
      drawPreview("");
      if (uploadStatus) uploadStatus.textContent = "Image will be removed on save.";
    });

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const identityConflict = findProductIdentityConflict();
      if (identityConflict) {
        statusEl.textContent = `Cannot save: ${identityConflict} Correct the slug/title/model fields so they describe the same product.`;
        return;
      }
      statusEl.textContent = "Saving...";
      let nextImageUrl = existingImageUrl;
      let nextImageKey = existingImageKey;
      const uploadedKeysToRollback = [];

      try {
        if (selectedFile) {
          if (uploadStatus) uploadStatus.textContent = "Compressing...";
          const compressed = await compressImageToWebp(selectedFile);
          if (uploadStatus) uploadStatus.textContent = "Uploading...";
          const uploaded = await uploadImage(compressed);
          nextImageUrl = uploaded.url || "";
          nextImageKey = uploaded.key || "";
          if (nextImageKey) uploadedKeysToRollback.push(nextImageKey);
        }
        if (imageRemoved) { nextImageUrl = ""; nextImageKey = ""; }

        const nextGalleryImages = [];
        if (galleryStatus && galleryItems.some((item) => item.kind === "pending")) {
          galleryStatus.textContent = "Compressing & uploading additional images...";
        }
        for (const item of galleryItems) {
          if (item.kind === "existing") {
            nextGalleryImages.push({ url: item.url, key: item.key || "", alt: item.alt || "" });
            continue;
          }

          const compressed = await compressImageToWebp(item.file);
          const uploaded = await uploadImage(compressed);
          if (uploaded.key) uploadedKeysToRollback.push(uploaded.key);
          nextGalleryImages.push({
            url: uploaded.url || "",
            key: uploaded.key || "",
            alt: item.alt || "",
          });
        }

        let contentValue = "";
        const outputInput = editor.querySelector("[data-tiptap-output]");
        contentValue = outputInput?.value || "";

        const payload = {
          title: form.querySelector("[data-title]").value,
          slug: form.querySelector("[data-slug]").value,
          excerpt: form.querySelector("[data-excerpt]").value,
          content: contentValue,
          imageUrl: nextImageUrl,
          imageKey: nextImageKey,
          galleryImages: nextGalleryImages,
          ...(type === 'products' ? {
            category: form.querySelector("[data-category]")?.value || "",
            subcategory: form.querySelector("[data-subcategory]")?.value || "",
            additionalCategories: collectAdditionalCategories(),
            brand: form.querySelector("[data-brand]")?.value || "",
            model_number: form.querySelector("[data-model]")?.value || "",
            partNumber: form.querySelector("[data-part-number]")?.value || "",
            condition: form.querySelector("[data-condition]")?.value || "",
            availability: form.querySelector("[data-availability]")?.value || "",
            conditionVerifiedAt: form.querySelector("[data-condition-verified-at]")?.value || "",
            availabilityVerifiedAt: form.querySelector("[data-availability-verified-at]")?.value || "",
            location: form.querySelector("[data-location]")?.value || "",
            application: form.querySelector("[data-application]")?.value || "",
            technicalSpecifications: form.querySelector("[data-technical-specifications]")?.value || "",
            seoTitle: form.querySelector("[data-seo-title]")?.value || "",
            metaDescription: form.querySelector("[data-meta-description]")?.value || "",
            focusKeyword: form.querySelector("[data-focus-keyword]")?.value || "",
            imageAlt: form.querySelector("[data-image-alt]")?.value || "",
            relatedProducts: (form.querySelector("[data-related-products]")?.value || "")
              .split(',')
              .map((value) => value.trim())
              .filter(Boolean)
          } : {})
        };

        const id = form.querySelector("[data-id]").value;
        const response = await fetch(id ? `${endpoint}/${id}` : endpoint, {
          method: id ? "PUT" : "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload)
        });

        if (!response.ok) {
          const data = await response.json().catch(() => null);
          throw new Error(data?.error || "Save failed.");
        }

        setExistingImageState(nextImageUrl, nextImageKey);
        imageUrlInput.value = nextImageUrl;
        imageKeyInput.value = nextImageKey;
        clearPreviewUrl();
        selectedFile = null;
        imageRemoved = false;
        if (imageInput) { imageInput.value = ""; }
        if (uploadStatus) uploadStatus.textContent = "";
        statusEl.textContent = "✓ Saved successfully";
        await loadItems();
        resetForm();
      } catch (error) {
        for (const key of uploadedKeysToRollback) await deleteImageByKey(key);
        if (uploadStatus) uploadStatus.textContent = "";
        if (galleryStatus) galleryStatus.textContent = "";
        statusEl.textContent = error instanceof Error ? error.message : "Save failed.";
      }
    });

    logoutBtn?.addEventListener("click", async () => {
      await fetch("/api/auth/logout", { method: "POST" });
      window.location.href = "/admin/login";
    });

    resetBtn?.addEventListener("click", resetForm);
    renderGallery();
    loadItems();
  }
</script>

