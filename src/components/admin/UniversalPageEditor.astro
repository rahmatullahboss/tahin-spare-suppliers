---
interface Props {
  pageKey: string;
  overrides: Record<string, { type: "text" | "image"; text?: string; src?: string; alt?: string; key?: string }>;
  editable: boolean;
}

const { pageKey, overrides, editable } = Astro.props;
---

<script is:inline define:vars={{ pageKey, overrides, editable }}>
(() => {
  const root = document.getElementById('main-content');
  if (!root) return;

  const saved = overrides && typeof overrides === 'object' ? overrides : {};

  const selectorFor = (element) => {
    const parts = [];
    let node = element;
    while (node && node !== root) {
      if (!(node instanceof Element)) break;
      const parent = node.parentElement;
      if (!parent) break;
      const siblings = Array.from(parent.children).filter((child) => child.tagName === node.tagName);
      const index = siblings.indexOf(node) + 1;
      parts.unshift(`${node.tagName.toLowerCase()}:nth-of-type(${Math.max(1, index)})`);
      node = parent;
    }
    return parts.length ? `#main-content>${parts.join('>')}` : '';
  };

  const applySaved = () => {
    Object.entries(saved).forEach(([selector, patch]) => {
      let element = null;
      try { element = document.querySelector(selector); } catch { return; }
      if (!(element instanceof HTMLElement) && !(element instanceof HTMLImageElement)) return;
      if (patch?.type === 'image' && element instanceof HTMLImageElement) {
        if (typeof patch.src === 'string' && patch.src) element.src = patch.src;
        if (typeof patch.alt === 'string') element.alt = patch.alt;
      } else if (patch?.type === 'text' && element instanceof HTMLElement && typeof patch.text === 'string') {
        element.textContent = patch.text;
      }
    });
  };

  applySaved();
  if (!editable) return;

  const eligibleSelector = 'h1,h2,h3,h4,h5,h6,p,li,blockquote,figcaption,img,.section-subtitle,.mission-text,.mission-cta,.btn,.view-details,.category-card-cta,.subcategory-card-cta';
  const excludedSelector = '[data-no-page-edit], .cms-admin-bar, .cms-modal, script, style, noscript';
  let editMode = false;
  let activeElement = null;
  let activeSelector = '';
  let uploadedKey = '';
  let previousImageKey = '';

  const bar = document.createElement('div');
  bar.className = 'universal-cms-bar';
  bar.innerHTML = `
    <strong>Website Edit Mode</strong>
    <button type="button" data-page-edit-toggle>Edit this page</button>
    <a href="/admin/products">Products</a>
    <a href="/admin/categories">Categories</a>
    <a href="/admin/brands">Brands</a>
    <a href="/admin">Dashboard</a>
    <span data-page-edit-help>Turn on edit mode, then tap text or an image.</span>
  `;
  document.body.appendChild(bar);

  const panel = document.createElement('div');
  panel.className = 'universal-cms-panel';
  panel.hidden = true;
  panel.innerHTML = `
    <div class="universal-cms-backdrop" data-page-edit-close></div>
    <section class="universal-cms-dialog" role="dialog" aria-modal="true" aria-label="Edit page content">
      <header><div><span>Page Editor</span><h2 data-page-edit-title>Edit content</h2></div><button type="button" data-page-edit-close aria-label="Close">×</button></header>
      <div data-page-edit-fields></div>
      <p data-page-edit-status></p>
      <footer><button type="button" data-page-edit-reset>Reset</button><button type="button" data-page-edit-save>Save & refresh</button></footer>
    </section>
  `;
  document.body.appendChild(panel);

  const status = panel.querySelector('[data-page-edit-status]');
  const fields = panel.querySelector('[data-page-edit-fields]');
  const title = panel.querySelector('[data-page-edit-title]');
  const saveButton = panel.querySelector('[data-page-edit-save]');
  const resetButton = panel.querySelector('[data-page-edit-reset]');
  const toggle = bar.querySelector('[data-page-edit-toggle]');
  const help = bar.querySelector('[data-page-edit-help]');

  const setStatus = (message, error = false) => {
    if (!status) return;
    status.textContent = message;
    status.dataset.error = error ? 'true' : 'false';
  };

  const persist = async () => {
    const response = await fetch('/api/page-overrides', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ page: pageKey, overrides: saved })
    });
    const payload = await response.json().catch(() => ({}));
    if (!response.ok) throw new Error(payload.error || 'Could not save page edits.');
    return payload.overrides || saved;
  };

  const deleteUpload = async (key) => {
    if (!key) return;
    await fetch('/api/upload/delete', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ key })
    }).catch(() => null);
  };

  const compressToWebp = async (file) => {
    const bitmap = await createImageBitmap(file);
    const canvas = document.createElement('canvas');
    const maxDimension = 1800;
    const scale = Math.min(1, maxDimension / Math.max(bitmap.width, bitmap.height));
    canvas.width = Math.max(1, Math.round(bitmap.width * scale));
    canvas.height = Math.max(1, Math.round(bitmap.height * scale));
    const context = canvas.getContext('2d');
    if (!context) throw new Error('Image compression is not supported in this browser.');
    context.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
    bitmap.close?.();
    const blob = await new Promise((resolve) => canvas.toBlob(resolve, 'image/webp', 0.82));
    if (!blob) throw new Error('Image compression failed.');
    return new File([blob], `${(file.name || 'image').replace(/\.[^.]+$/, '')}.webp`, { type: 'image/webp' });
  };

  const uploadImage = async (file) => {
    const compressed = await compressToWebp(file);
    const formData = new FormData();
    formData.append('file', compressed);
    const response = await fetch('/api/upload', { method: 'POST', body: formData });
    const payload = await response.json().catch(() => ({}));
    if (!response.ok) throw new Error(payload.error || 'Image upload failed.');
    return payload;
  };

  const closePanel = async () => {
    if (uploadedKey) {
      await deleteUpload(uploadedKey);
      uploadedKey = '';
    }
    panel.hidden = true;
    document.documentElement.classList.remove('universal-cms-open');
    activeElement = null;
    activeSelector = '';
    previousImageKey = '';
  };

  const openEditor = (element) => {
    const selector = selectorFor(element);
    if (!selector || !fields) return;
    activeElement = element;
    activeSelector = selector;
    const existing = saved[selector];
    uploadedKey = '';
    previousImageKey = existing?.type === 'image' ? existing.key || '' : '';
    fields.replaceChildren();
    setStatus('');

    if (element instanceof HTMLImageElement) {
      if (title) title.textContent = 'Edit image';
      const preview = document.createElement('img');
      preview.className = 'universal-cms-preview';
      preview.src = existing?.type === 'image' && existing.src ? existing.src : element.currentSrc || element.src;
      preview.alt = existing?.type === 'image' ? existing.alt || element.alt : element.alt;
      fields.appendChild(preview);

      const altLabel = document.createElement('label');
      altLabel.innerHTML = '<span>Alt text</span>';
      const altInput = document.createElement('input');
      altInput.type = 'text';
      altInput.value = existing?.type === 'image' ? existing.alt || element.alt : element.alt;
      altInput.dataset.pageImageAlt = 'true';
      altLabel.appendChild(altInput);
      fields.appendChild(altLabel);

      const uploadLabel = document.createElement('label');
      uploadLabel.className = 'universal-cms-upload';
      uploadLabel.textContent = 'Replace image';
      const fileInput = document.createElement('input');
      fileInput.type = 'file';
      fileInput.accept = 'image/*';
      fileInput.hidden = true;
      fileInput.addEventListener('change', async () => {
        const file = fileInput.files?.[0];
        if (!file) return;
        setStatus('Compressing to WebP and uploading…');
        try {
          if (uploadedKey) await deleteUpload(uploadedKey);
          const uploaded = await uploadImage(file);
          uploadedKey = uploaded.key || '';
          preview.src = uploaded.url || '';
          preview.dataset.uploadedSrc = uploaded.url || '';
          setStatus('Image ready. Tap Save & refresh to publish.');
        } catch (error) {
          setStatus(error instanceof Error ? error.message : 'Image upload failed.', true);
        }
      });
      uploadLabel.appendChild(fileInput);
      fields.appendChild(uploadLabel);
    } else {
      if (title) title.textContent = `Edit ${element.tagName.toLowerCase()}`;
      const label = document.createElement('label');
      label.innerHTML = '<span>Text</span>';
      const textarea = document.createElement('textarea');
      textarea.rows = 7;
      textarea.value = existing?.type === 'text' ? existing.text || '' : element.textContent?.trim() || '';
      textarea.dataset.pageText = 'true';
      label.appendChild(textarea);
      fields.appendChild(label);
    }

    panel.hidden = false;
    document.documentElement.classList.add('universal-cms-open');
  };

  toggle?.addEventListener('click', () => {
    editMode = !editMode;
    document.documentElement.classList.toggle('universal-cms-editing', editMode);
    toggle.textContent = editMode ? 'Finish editing' : 'Edit this page';
    help.textContent = editMode ? 'Tap a highlighted text block or image to edit it.' : 'Turn on edit mode, then tap text or an image.';
  });

  root.addEventListener('click', (event) => {
    if (!editMode) return;
    const target = event.target;
    if (!(target instanceof Element)) return;
    const element = target.closest(eligibleSelector);
    if (!element || !root.contains(element) || element.closest(excludedSelector)) return;
    event.preventDefault();
    event.stopPropagation();
    openEditor(element);
  }, true);

  saveButton?.addEventListener('click', async () => {
    if (!activeElement || !activeSelector) return;
    setStatus('Saving…');
    saveButton.disabled = true;
    try {
      if (activeElement instanceof HTMLImageElement) {
        const altInput = fields?.querySelector('[data-page-image-alt]');
        const preview = fields?.querySelector('.universal-cms-preview');
        const existing = saved[activeSelector];
        const src = preview instanceof HTMLImageElement
          ? preview.dataset.uploadedSrc || (existing?.type === 'image' ? existing.src : '') || activeElement.src
          : activeElement.src;
        saved[activeSelector] = {
          type: 'image',
          src,
          alt: altInput instanceof HTMLInputElement ? altInput.value : activeElement.alt,
          key: uploadedKey || (existing?.type === 'image' ? existing.key || '' : '')
        };
      } else {
        const textarea = fields?.querySelector('[data-page-text]');
        saved[activeSelector] = {
          type: 'text',
          text: textarea instanceof HTMLTextAreaElement ? textarea.value : activeElement.textContent || ''
        };
      }
      await persist();
      if (previousImageKey && uploadedKey && previousImageKey !== uploadedKey) await deleteUpload(previousImageKey);
      uploadedKey = '';
      setStatus('Saved. Refreshing…');
      window.location.reload();
    } catch (error) {
      setStatus(error instanceof Error ? error.message : 'Save failed.', true);
    } finally {
      saveButton.disabled = false;
    }
  });

  resetButton?.addEventListener('click', async () => {
    if (!activeSelector) return;
    const existing = saved[activeSelector];
    if (!existing) {
      setStatus('This item has no saved override.');
      return;
    }
    if (!confirm('Reset this item to the website default?')) return;
    setStatus('Resetting…');
    try {
      delete saved[activeSelector];
      await persist();
      if (existing.type === 'image' && existing.key) await deleteUpload(existing.key);
      window.location.reload();
    } catch (error) {
      setStatus(error instanceof Error ? error.message : 'Reset failed.', true);
    }
  });

  panel.querySelectorAll('[data-page-edit-close]').forEach((button) => button.addEventListener('click', closePanel));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && !panel.hidden) closePanel();
  });
})();
</script>

{editable && (
  <style is:global>
    .universal-cms-bar {
      position: fixed; z-index: 1200; left: 14px; right: 14px; bottom: 14px; display: flex; flex-wrap: wrap;
      align-items: center; gap: 9px; padding: 11px 13px; border-radius: 14px; background: rgba(17,17,17,.97);
      color: #fff; box-shadow: 0 12px 30px rgba(0,0,0,.25); font: 600 13px/1.3 system-ui,sans-serif;
    }
    .universal-cms-bar strong { margin-right: 4px; }
    .universal-cms-bar a, .universal-cms-bar button { border: 0; border-radius: 9px; padding: 8px 10px; background: #292929; color: #fff; text-decoration: none; font: inherit; cursor: pointer; }
    .universal-cms-bar button { background: #b11623; }
    .universal-cms-bar span { color: #cbd5e1; flex: 1 1 220px; }
    html.universal-cms-editing #main-content :is(h1,h2,h3,h4,h5,h6,p,li,blockquote,figcaption,img,.section-subtitle,.mission-text,.mission-cta,.btn,.view-details,.category-card-cta,.subcategory-card-cta) {
      outline: 2px dashed rgba(177,22,35,.65); outline-offset: 3px; cursor: pointer !important;
    }
    .universal-cms-panel[hidden] { display: none; }
    .universal-cms-panel { position: fixed; inset: 0; z-index: 1500; display: grid; place-items: center; padding: 16px; }
    .universal-cms-backdrop { position: absolute; inset: 0; background: rgba(15,23,42,.65); }
    .universal-cms-dialog { position: relative; width: min(640px,100%); max-height: min(760px,90vh); overflow: auto; border-radius: 16px; background: #fff; box-shadow: 0 30px 80px rgba(0,0,0,.3); }
    .universal-cms-dialog header { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; padding: 20px; border-bottom: 1px solid #e5e7eb; }
    .universal-cms-dialog header span { color: #b11623; font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: .1em; }
    .universal-cms-dialog h2 { margin: 4px 0 0; font: 800 24px/1.2 system-ui,sans-serif; color: #111827; }
    .universal-cms-dialog header button { width: 42px; height: 42px; border: 0; border-radius: 50%; background: #f3f4f6; font-size: 26px; cursor: pointer; }
    .universal-cms-dialog [data-page-edit-fields] { display: grid; gap: 14px; padding: 20px; }
    .universal-cms-dialog label { display: grid; gap: 7px; color: #374151; font: 700 13px/1.3 system-ui,sans-serif; }
    .universal-cms-dialog textarea, .universal-cms-dialog input { width: 100%; box-sizing: border-box; border: 1px solid #cbd5e1; border-radius: 9px; padding: 12px; font: 400 16px/1.5 system-ui,sans-serif; }
    .universal-cms-preview { display: block; width: 100%; max-height: 320px; object-fit: contain; border: 1px solid #e5e7eb; border-radius: 10px; background: #f8fafc; }
    .universal-cms-upload { min-height: 46px; display: inline-flex !important; place-items: center; align-items: center; justify-content: center; width: fit-content; padding: 0 15px; border-radius: 9px; background: #e5e7eb; cursor: pointer; }
    .universal-cms-dialog [data-page-edit-status] { min-height: 20px; margin: 0; padding: 0 20px 8px; color: #15803d; font: 700 13px/1.4 system-ui,sans-serif; }
    .universal-cms-dialog [data-page-edit-status][data-error="true"] { color: #dc2626; }
    .universal-cms-dialog footer { position: sticky; bottom: 0; display: flex; justify-content: flex-end; gap: 9px; padding: 14px 20px; border-top: 1px solid #e5e7eb; background: #fff; }
    .universal-cms-dialog footer button { min-height: 44px; border: 0; border-radius: 9px; padding: 0 16px; font-weight: 800; cursor: pointer; }
    .universal-cms-dialog footer button:first-child { background: #e5e7eb; color: #111827; }
    .universal-cms-dialog footer button:last-child { background: #b11623; color: #fff; }
    html.universal-cms-open { overflow: hidden; }
    @media (max-width: 640px) {
      .universal-cms-bar { left: 10px; right: 10px; bottom: 10px; max-height: 28vh; overflow: auto; }
      .universal-cms-bar span { order: 2; flex-basis: 100%; }
      .universal-cms-panel { padding: 0; align-items: end; }
      .universal-cms-dialog { width: 100%; max-height: 92vh; border-radius: 18px 18px 0 0; }
      .universal-cms-dialog footer { display: grid; grid-template-columns: 1fr 1fr; }
    }
  </style>
)}
