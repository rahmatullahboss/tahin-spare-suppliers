---
interface Props {
  active: "dashboard" | "products" | "blog" | "contacts" | "enquiries" | "categories" | "emails";
}

const { active } = Astro.props;

interface NavItem {
  name: string;
  id: string;
  href: string;
  icon: string;
}

const navItems: NavItem[] = [
  { name: "Dashboard", id: "dashboard", href: "/admin", icon: "dashboard" },
  { name: "Equipment", id: "products", href: "/admin/products", icon: "products" },
  { name: "Blog", id: "blog", href: "/admin/blog", icon: "blog" },
  { name: "Contact Messages", id: "contacts", href: "/admin/contact-messages", icon: "contacts" },
  { name: "Enquiries", id: "enquiries", href: "/admin/enquiries", icon: "enquiries" },
  { name: "Categories", id: "categories", href: "/admin/categories", icon: "categories" },
  { name: "Emails", id: "emails", href: "/admin/emails", icon: "emails" },
];

function getIcon(iconName: string): string {
  const icons: Record<string, string> = {
    dashboard: '<rect x="3" y="3" width="7" height="7" rx="1" fill="none" stroke="currentColor" stroke-width="1.8"/><rect x="14" y="3" width="7" height="7" rx="1" fill="none" stroke="currentColor" stroke-width="1.8"/><rect x="3" y="14" width="7" height="7" rx="1" fill="none" stroke="currentColor" stroke-width="1.8"/><rect x="14" y="14" width="7" height="7" rx="1" fill="none" stroke="currentColor" stroke-width="1.8"/>',
    products: '<path d="M7 3h10a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M9 3v18" fill="none" stroke="currentColor" stroke-width="1.8"/>',
    blog: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6z" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M14 2v6h6" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M8 13h8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M8 17h8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>',
    contacts: '<path d="M22 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><circle cx="12" cy="7" r="4" fill="none" stroke="currentColor" stroke-width="1.8"/>',
    enquiries: '<path d="M22 12h-4l-3 9-4-18-3 9H2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>',
    categories: '<path d="M4 4h6l2 2h8a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z" fill="none" stroke="currentColor" stroke-width="1.8"/>',
    emails: '<path d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z" fill="none" stroke="currentColor" stroke-width="1.8"/><polyline points="22,6 12,13 2,6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>',
  };
  return icons[iconName] || icons.dashboard;
}
---
<aside class="admin-sidebar" id="admin-navigation" data-admin-drawer aria-label="Admin navigation drawer">
  <div class="sidebar-brand">
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>
    </svg>
    <span>Admin Panel</span>
    <button type="button" class="sidebar-close" data-admin-menu-close aria-label="Close admin navigation">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M18 6 6 18M6 6l12 12" />
      </svg>
    </button>
  </div>

  <nav class="sidebar-nav" aria-label="Admin sections">
    {navItems.map(item => (
      <a
        href={item.href}
        class:list={["sidebar-link", { active: active === item.id }]}
        aria-current={active === item.id ? "page" : undefined}
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" set:html={getIcon(item.icon)} aria-hidden="true" />
        <span>{item.name}</span>
      </a>
    ))}
  </nav>

  <div class="sidebar-footer">
    <a href="/" class="sidebar-link" target="_blank" rel="noopener noreferrer">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M18 10V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h4"/><polyline points="10 14 22 14 18 10"/><polyline points="10 14 14 18 22 14"/>
      </svg>
      <span>View Site</span>
    </a>
    <button type="button" class="sidebar-link sidebar-logout" data-admin-shell-logout>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M10 17l5-5-5-5"/><path d="M15 12H3"/><path d="M14 3h5a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-5"/>
      </svg>
      <span>Logout</span>
    </button>
  </div>
</aside>

<style>
  .admin-sidebar {
    background: #fff;
    border-right: 1px solid #e2e8f0;
    display: flex;
    flex-direction: column;
    height: 100vh;
    position: sticky;
    top: 0;
    z-index: 80;
  }

  .sidebar-brand {
    min-height: 76px;
    padding: 1.25rem 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    border-bottom: 1px solid #f1f5f9;
    box-sizing: border-box;
  }

  .sidebar-brand span {
    min-width: 0;
    flex: 1;
    font-weight: 700;
    font-size: 1.1rem;
    color: #0f172a;
    letter-spacing: -0.01em;
  }

  .sidebar-close {
    display: none;
    width: 44px;
    height: 44px;
    flex: 0 0 44px;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    background: #fff;
    color: #64748b;
    cursor: pointer;
  }

  .sidebar-nav {
    flex: 1;
    padding: 1.25rem 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    overflow-y: auto;
    overflow-x: hidden;
  }

  .sidebar-link {
    min-height: 44px;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 1rem;
    border-radius: 0.5rem;
    color: #64748b;
    font-size: 0.9rem;
    font-weight: 500;
    text-align: left;
    text-decoration: none;
    transition: background 0.15s ease, color 0.15s ease;
    box-sizing: border-box;
  }

  .sidebar-link:hover {
    background: #f8fafc;
    color: #0f172a;
  }

  .sidebar-link:focus-visible,
  .sidebar-close:focus-visible {
    outline: 3px solid rgba(217, 119, 6, 0.22);
    outline-offset: 2px;
  }

  .sidebar-link.active {
    background: #fef3c7;
    color: #b45309;
    font-weight: 650;
  }

  .sidebar-link svg {
    flex-shrink: 0;
    stroke: currentColor;
  }

  .sidebar-footer {
    display: grid;
    gap: 0.25rem;
    padding: 1rem 0.75rem calc(1rem + env(safe-area-inset-bottom));
    border-top: 1px solid #f1f5f9;
  }

  .sidebar-logout {
    width: 100%;
    border: 0;
    background: transparent;
    font: inherit;
    cursor: pointer;
  }

  @media (max-width: 900px) {
    .admin-sidebar {
      position: fixed;
      inset: 0 auto 0 0;
      width: min(86vw, 320px);
      height: 100dvh;
      border-right: 1px solid #e2e8f0;
      border-bottom: 0;
      box-shadow: 18px 0 40px rgba(15, 23, 42, 0.16);
      transform: translateX(-100%);
      transition: transform 180ms ease;
      will-change: transform;
    }

    .admin-sidebar.is-open {
      transform: translateX(0);
    }

    .sidebar-brand {
      min-height: 64px;
      padding: calc(10px + env(safe-area-inset-top)) 12px 10px 16px;
    }

    .sidebar-brand span {
      font-size: 1rem;
    }

    .sidebar-close {
      display: inline-flex;
    }

    .sidebar-nav {
      padding: 0.75rem;
      gap: 0.2rem;
    }

    .sidebar-link {
      min-height: 48px;
      padding: 0.7rem 0.9rem;
      border-radius: 0.65rem;
    }

    .sidebar-footer {
      display: grid;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .admin-sidebar {
      transition: none;
    }
  }
</style>
