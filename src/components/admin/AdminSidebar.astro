---
interface Props {
  active: "dashboard" | "products" | "blog" | "contacts" | "enquiries" | "categories" | "emails";
}

const { active } = Astro.props;
---
<aside class="admin-sidebar">
  <h2>Admin Panel</h2>
  <nav>
    <a href="/admin" class:list={[{ active: active === "dashboard" }]}>Dashboard</a>
    <a href="/admin/products" class:list={[{ active: active === "products" }]}>Equipment</a>
    <a href="/admin/blog" class:list={[{ active: active === "blog" }]}>Blog</a>
    <a href="/admin/contact-messages" class:list={[{ active: active === "contacts" }]}>Contact Messages</a>
    <a href="/admin/enquiries" class:list={[{ active: active === "enquiries" }]}>Enquiries</a>
    <a href="/admin/categories" class:list={[{ active: active === "categories" }]}>Categories</a>
    <a href="/admin/emails" class:list={[{ active: active === "emails" }]}>Emails</a>
  </nav>
</aside>
